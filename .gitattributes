# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# docs/STATUS.md is an append-only log (one entry per line — see its header).
# Two branches appending different milestone lines is routine, so let git keep
# both sides automatically instead of raising a conflict. Union merge never
# shows conflict markers, so only append to this file — don't rewrite existing
# lines on a branch. Code hub files (routes.rb, fixtures, Tool::SLUGS, …)
# deliberately stay on the default strategy: their keep-both conflicts
# deserve eyes.
docs/STATUS.md merge=union
