# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# The build log used to be a single append-only docs/STATUS.md carrying
# `merge=union`, so that two branches appending different milestone lines
# merged automatically. That worked in git and nowhere else: GitHub computes a
# PR's mergeability without this file, so every branch that touched the log
# still showed a conflict on its PR page. The log is now one file per entry
# under docs/status/ — separate files, nothing to merge, no special strategy
# needed here. The decision log followed it to docs/decisions/ for the same
# reason, and gains one property a merge strategy could never give it: a slug
# is the filename, so two branches claiming the same ID collide as an add/add
# conflict instead of merging quietly. Code hub files (routes.rb, fixtures,
# Tool::SLUGS, …) stay on the default strategy on purpose: their keep-both
# conflicts deserve eyes.
