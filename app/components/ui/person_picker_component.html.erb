<%# On a phone, `picker-sheet-open` turns this root into a full-screen
    sheet while the field has focus (see the atom), and the Cancel button
    only shows there. %>
<div class="picker-sheet relative min-w-0 flex-1" data-controller="person-picker"
     data-person-picker-url-value="<%= matches_url %>">
  <input type="hidden" name="person_id" data-person-picker-target="id">
  <% if inline %><input type="hidden" name="inline" value="1"><% end %>
  <div class="flex items-center gap-2">
    <input type="text" name="name" class="<%= input_classes %>" placeholder="<%= placeholder %>"
           aria-label="<%= label %>" autocomplete="off" spellcheck="false" enterkeyhint="done" <%= "autofocus" if autofocus %>
           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="<%= list_id %>"
           data-person-picker-target="input"
           data-action="input->person-picker#search keydown->person-picker#navigate focus->person-picker#focus blur->person-picker#blur">
    <button type="button" class="picker-sheet-cancel btn btn-ghost shrink-0"
            data-action="mousedown->person-picker#dismiss:prevent">Cancel</button>
  </div>
  <ul id="<%= list_id %>" role="listbox" aria-label="<%= label %>" hidden
      class="picker-list absolute left-0 top-full z-20 mt-1.5 max-h-72 w-max min-w-full max-w-[min(20rem,calc(100vw-2rem))] space-y-0.5 overflow-y-auto rounded-2xl border border-edge bg-canvas p-1.5 shadow-lg"
      data-person-picker-target="list"
      data-action="mousedown->person-picker#pick"></ul>
</div>
