<div class="relative" data-controller="quick-add"
     data-action="keydown.esc@window->quick-add#closeAll click@window->quick-add#clickOutside quick-add:opened@window->quick-add#closeOthers">
  <%= tag.button type: "button", class: button_classes, aria: { expanded: false, haspopup: true },
        data: { quick_add_target: "button", action: "quick-add#toggle", quick_add_name_param: name } do %>
    <% if tile? %>
      <span class="<%= icon_classes %>">
        <%= helpers.icon(icon, css_class: "size-5 sm:hidden") %>
        <%= helpers.icon(:plus, css_class: "hidden size-4 sm:block") %>
        <span class="absolute -bottom-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full ring-2 sm:hidden <%= badge_classes %>">
          <%= helpers.icon(:plus, css_class: "size-2.5") %>
        </span>
      </span>
    <% else %>
      <%= helpers.icon(:plus, css_class: plus_classes) %>
    <% end %>
    <%= label %>
  <% end %>
  <div class="<%= panel_classes %>" data-quick-add-target="panel" data-name="<%= name %>">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h2 class="text-sm font-semibold text-ink"><%= title %></h2>
      <% if full_form_url %>
        <%= link_to "Full form", full_form_url, class: "shrink-0 text-xs font-medium text-primary-700 hover:underline",
              data: { action: "quick-add#carryOver" } %>
      <% end %>
    </div>
    <%= content %>
  </div>
</div>
