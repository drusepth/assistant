<%= render Ui::PageHeaderComponent.new(title: "Add person") %>
<div class="max-w-xl">
  <div class="card p-6">
    <%= form_with model: @person, class: "space-y-4" do |form| %>
      <%= form.field :name, placeholder: "Who are they?", autofocus: true, required: true %>
      <div class="space-y-1">
        <%= form.text_area :notes, rows: 3, placeholder: "Anything worth remembering — \"my cardiologist at St. Mary's\", \"mom's landlord\"…" %>
        <%= form.errors_for :notes %>
        <p class="hint"><%= person_auto_sort_hint %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= form.submit "Add person" %>
        <%= link_to "Cancel", people_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
