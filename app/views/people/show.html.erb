<% own = @person.user_id == Current.user.id %>

<%= render Ui::PageHeaderComponent.new(title: @person.name, subtitle: @person.relationship) do |header| %>
  <% header.with_avatar do %>
    <%= render Ui::AvatarComponent.new(person: @person, size: :lg) %>
  <% end %>
  <% if own %>
    <% header.with_actions do %>
      <% if @person.keep_in_touch? %>
        <%= button_to "In your circle ✓", people_circle_path(person_id: @person.id), method: :delete, class: "btn btn-secondary",
              title: "On your People page — click to stop tending this one" %>
      <% else %>
        <%= button_to "Keep in touch", people_circle_path(person_id: @person.id), method: :post, class: "btn btn-secondary",
              title: "Adds them to your circle on the People page" %>
      <% end %>
      <%= button_to "Log contact today", log_contact_person_path(@person), method: :patch, class: "btn btn-secondary",
            title: @person.last_contacted_on ? "Last logged: #{@person.last_contacted_on.strftime("%B %-d, %Y")}" : "No contact logged yet" %>
      <%= link_to "Edit", edit_person_path(@person), class: "btn btn-secondary" %>
      <%= button_to "Delete", @person, method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Remove #{@person.name}?" } %>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/provenance", item: @person %>
<div class="grid grid-cols-1 max-w-4xl gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <%= render Ui::CardComponent.new(title: "Details") do %>
      <dl class="space-y-3 text-sm">
        <% if @person.email.present? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Email</dt>
            <dd class="min-w-0 wrap-anywhere"><%= mail_to @person.email, nil, class: "text-primary-700 hover:underline" %></dd>
          </div>
        <% end %>
        <% if @person.phone.present? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Phone</dt>
            <dd class="min-w-0 wrap-anywhere"><%= phone_to @person.phone, nil, class: "text-primary-700 hover:underline" %></dd>
          </div>
        <% end %>
        <% if @person.address.present? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Address</dt>
            <dd class="min-w-0 wrap-anywhere"><%= @person.address %></dd>
          </div>
        <% end %>
        <% if @person.pronoun.present? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Pronouns</dt>
            <dd class="min-w-0 wrap-anywhere"><%= Pronouns::LABELS[@person.pronoun] %></dd>
          </div>
        <% end %>
        <% if @person.birthday %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Birthday</dt>
            <dd class="min-w-0 wrap-anywhere"><%= @person.birthday.strftime("%B %-d") %></dd>
          </div>
        <% end %>
        <% if @person.linked_user %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Account</dt>
            <dd class="min-w-0 wrap-anywhere">
              <span class="chip inline-flex items-center bg-primary-50 py-0.5 pl-0.5 text-primary-800">
                <%= render Ui::UserLabelComponent.new(user: @person.linked_user) do %>
                  <%= @person.linked_user.name %> (household member)
                <% end %>
              </span>
            </dd>
          </div>
        <% end %>
        <div class="flex gap-2">
          <dt class="w-24 shrink-0 text-soft">Sections</dt>
          <dd class="flex min-w-0 flex-wrap gap-1.5"><%= render "shared/item_chips", item: @person %></dd>
        </div>
        <% if @person.notes.present? %>
          <div>
            <dt class="mb-1 text-soft">Notes</dt>
            <dd class="whitespace-pre-wrap text-ink"><%= @person.notes %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%# Groups (D-people-circles): membership is a section tagging, but this
        is where someone actually thinks "oh, she's in the book club" —
        same service as the cards on the People page. %>
    <% if @groups.any? || @group_candidates.any? %>
      <div class="mt-6">
        <%= render Ui::CardComponent.new(title: "Groups") do %>
          <div class="space-y-3">
            <% if @groups.any? %>
              <div class="flex flex-wrap items-center gap-1.5">
                <% @groups.each do |group| %>
                  <span class="chip bg-primary-100 py-0.5 pr-1 pl-2.5 text-primary-800">
                    <%= link_to group.name, section_path(group.slug), class: "hover:underline" %>
                    <%= button_to "×", people_membership_path(section_id: group.id, person_id: @person.id),
                          method: :delete, class: "rounded-full px-1 leading-none text-primary-800/70 hover:text-primary-800",
                          form_class: "inline", title: "Take #{@person.name} out of #{group.name}",
                          data: { turbo_confirm: "Take #{@person.name} out of #{group.name}?" } %>
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-soft"><%= @person.name %> isn't in any group yet.</p>
            <% end %>

            <% if @group_candidates.any? %>
              <%= form_with url: people_memberships_path, class: "capture-row" do %>
                <%= hidden_field_tag :person_id, @person.id %>
                <%= select_tag :section_id, options_from_collection_for_select(@group_candidates, :id, :name),
                      class: "input sm:max-w-60", "aria-label": "Add #{@person.name} to a group" %>
                <%= submit_tag "Add to group", class: "btn btn-secondary" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @photos.any? %>
      <div class="mt-6" data-controller="lightbox">
        <%= render Ui::CardComponent.new(title: "Photos", subtitle: "Tagged with #{@person.name}") do |card| %>
          <% card.with_actions do %>
            <%= link_to "All photos", photos_path(person: @person.id), class: "btn btn-ghost btn-sm" %>
          <% end %>
          <div class="grid grid-cols-4 gap-1.5 sm:grid-cols-6">
            <%= render partial: "photos/photo_tile", collection: @photos, as: :photo %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if own %>
    <div><%= render "shared/share_controls", subject: @person %></div>
  <% end %>

  <%# Recent correspondence (EMAIL_PLAN.md §7) — owner-only by
      construction: the mirror has no visibility path, so a granted-in
      viewer of this Person never sees a mail card. %>
  <% if own && (mail = EmailMessage.where(user_id: Current.user.id, person_id: @person.id)
        .newest_first.limit(30).to_a.uniq(&:thread_key).first(5)).any? %>
    <div>
      <%= render Ui::CardComponent.new(title: "Recent correspondence", subtitle: "From your linked mail — only you can see this") do %>
        <ul class="divide-y divide-edge">
          <% mail.each do |message| %>
            <li>
              <%= link_to mail_path(message), class: "flex items-center gap-3 py-2.5 text-sm hover:bg-stone-50" do %>
                <span class="chip <%= message.outbound? ? "bg-stone-100 text-stone-600" : "bg-primary-50 text-primary-800" %>">
                  <%= message.outbound? ? "sent" : "received" %>
                </span>
                <span class="min-w-0 flex-1 truncate text-ink"><%= message.subject.presence || "(no subject)" %></span>
                <span class="shrink-0 text-xs text-soft"><%= message.sent_at&.to_date&.strftime("%b %-d") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
</div>
