<%= render Ui::PageHeaderComponent.new(title: "People", subtitle: "Contacts and what matters about them") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Import", new_people_import_path, class: "btn btn-secondary" %>
    <%= link_to new_person_path, class: "btn btn-primary" do %>
      <%= icon(:plus, css_class: "size-4") %> Person
    <% end %>
  <% end %>
<% end %>

<%# The circle's full view lives here rather than as its own page
    (D-people-circles): roster views belong with the roster. %>
<% if @circle_size.positive? %>
  <div class="mb-4 flex flex-wrap gap-2">
    <%= link_to "Everyone", people_path,
          class: "chip #{@circle_only ? "bg-stone-100 text-stone-700" : "bg-primary-100 text-primary-800"}" %>
    <%= link_to "Your circle · #{@circle_size}", people_path(circle: "1"),
          class: "chip #{@circle_only ? "bg-primary-100 text-primary-800" : "bg-stone-100 text-stone-700"}" %>
  </div>
<% end %>

<% if @people.any? %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"><%= render @people %></div>
<% elsif @circle_only %>
  <%= render Ui::EmptyStateComponent.new(
        title: "No one in your circle yet",
        description: "Your circle is the handful of relationships you're actively tending — the People page is where you pick them."
      ) do |empty| %>
    <% empty.with_action do %>
      <%= link_to "Go to People", section_path("people"), class: "btn btn-primary" %>
    <% end %>
  <% end %>
<% else %>
  <%= render Ui::EmptyStateComponent.new(
        title: "No people yet",
        description: "Friends, family, doctors, landlords, caseworkers — keep track of who matters and what matters about them."
      ) do |empty| %>
    <% empty.with_action do %>
      <div class="flex flex-wrap justify-center gap-2">
        <%= link_to "Import your address book", new_people_import_path, class: "btn btn-primary" %>
        <%= link_to "Add a person", new_person_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
