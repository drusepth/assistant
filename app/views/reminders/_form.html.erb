<%# Setting or changing a reminder at a time of your own (D-reminders).
    Locals:
      reminder — a new Reminder, or the one being changed
      subject  — the Event or Task it is set on
    A date and a time. Repeating belongs to tasks and is set on the task's
    form (D-reminders-on-tasks), so the Repeat picker only appears here for
    a repeating reminder that already exists — to change or end it. %>
<% repeating_row = reminder.persisted? && reminder.standing? %>
<% weekly = Reminder::WEEKLY_REPEATS.include?(reminder.repeat) %>
<% scope = reminder.persisted? ? "reminder_#{reminder.id}" : "new_reminder" %>
<%= form_with model: reminder, url: (reminder.persisted? ? reminder_path(reminder) : reminders_path),
      namespace: scope, id: scope, class: "space-y-3", data: { controller: "reminder-form" } do |form| %>
  <%= form.hidden_field :subject_type, value: subject.class.name, id: nil %>
  <%= form.hidden_field :subject_id, value: subject.id, id: nil %>

  <%# Top-aligned, not bottom: the time field carries a hint beneath it, and
      bottom alignment would lift its label out of line with the others. %>
  <div class="flex flex-wrap items-start gap-2">
    <div class="min-w-36 flex-1">
      <%= form.field :deliver_on, as: :date_field, label_text: repeating_row ? "Starting" : "On",
            value: reminder.deliver_on || Date.current, required: true,
            data: { reminder_form_target: "date", action: "reminder-form#dateChanged" } %>
    </div>
    <div class="min-w-28">
      <%= form.field :deliver_time, as: :time_field, label_text: "At", hint: "Blank = #{Reminder::DEFAULT_HOUR}am" %>
    </div>
    <% if repeating_row %>
      <div class="min-w-40 flex-1">
        <%= form.field :repeat, label_text: "Repeat" do %>
          <%= form.select :repeat, Reminder::REPEAT_OPTIONS.map { |key, text| [ text, key ] }, {},
                data: { reminder_form_target: "repeat", action: "reminder-form#repeatChanged" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if repeating_row %>
    <div class="flex flex-wrap items-center gap-1.5" data-reminder-form-target="days" <%= "hidden" unless weekly %>>
      <span class="label">On</span>
      <% Recurrence::Rule::WEEKDAYS.keys.rotate(1).each do |code| %>
        <label class="cursor-pointer">
          <%= form.check_box :repeat_days, { multiple: true, class: "peer sr-only", data: { reminder_form_target: "day" } }, code, nil %>
          <span class="chip chip-toggle"><%= Recurrence::Rule::DAY_NAMES[code].first(3) %></span>
        </label>
      <% end %>
    </div>

    <div class="max-w-48" data-reminder-form-target="until">
      <%= form.field :repeat_until, as: :date_field, label_text: "Until", hint: "Blank = until you remove it",
            value: reminder.repeat_until %>
    </div>
  <% end %>

  <%= form.submit (reminder.persisted? ? "Save" : "Remind me"), class: "btn btn-secondary" %>
<% end %>
