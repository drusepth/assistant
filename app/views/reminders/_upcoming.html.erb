<%# The Today page's reminder card (D-reminders). Locals: reminders.
    The standalone form is the case the feature exists for — "remind me to
    call the pharmacy at 4pm" hangs on nothing and shouldn't have to; nor
    should "take the trash out, every Thursday" (D-standing-reminders). %>
<%= render Ui::CardComponent.new(title: "Reminders",
      subtitle: "What you asked to be told, and when — these ignore the agent dials, you set them yourself") do %>
  <% if reminders.any? %>
    <ul class="mb-4 space-y-2">
      <%= render partial: "reminders/reminder", collection: reminders, locals: { show_body: true } %>
    </ul>
  <% end %>

  <%= render "reminders/capture", text: "" %>
  <%= render "reminders/form", reminder: Reminder.new(deliver_on: Date.current), subject: nil, show_body: true %>
<% end %>
