<%# The Today page's reminder card (D-reminders). Locals: reminders.
    Only the list lives here: setting a new one is the "+ Reminder" button
    in the page header, beside "+ Task". With nothing set, there's no card. %>
<% if reminders.any? %>
  <%= render Ui::CardComponent.new(title: "Reminders",
        subtitle: "What you asked to be told, and when — these ignore the agent dials, you set them yourself") do %>
    <ul class="space-y-2">
      <%= render partial: "reminders/reminder", collection: reminders, locals: { show_body: true } %>
    </ul>
  <% end %>
<% end %>
