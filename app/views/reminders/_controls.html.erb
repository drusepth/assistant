<%# Reminders on one item (D-reminders). Locals: subject (an Event or Task).
    Two ways to set one, because "an hour before" and "at 7am on the day"
    are genuinely different asks — the first follows the item if it moves,
    the second stays put, and only the second can repeat
    (D-standing-reminders): a task called "Take the trash out" with a
    reminder every Thursday at 8pm is the chore, with no respawn engine. %>
<% pending = subject.reminders.pending.order(:deliver_at) %>
<%= render Ui::CardComponent.new(title: "Reminders",
      subtitle: "Sent to your notification channels at the time you pick") do %>
  <% if pending.any? %>
    <ul class="mb-4 space-y-2">
      <%= render partial: "reminders/reminder", collection: pending, locals: { show_body: false } %>
    </ul>
  <% end %>

  <% if subject.remind_from %>
    <%= render "reminders/lead_form", reminder: Reminder.new, subject: subject %>
  <% end %>

  <details class="<%= "mt-3" if subject.remind_from %>">
    <summary class="cursor-pointer text-sm font-medium text-primary-700">
      <%= subject.remind_from ? "Or pick a time — once, or on repeat" : "Pick a time — once, or on repeat" %>
    </summary>
    <div class="mt-3">
      <%= render "reminders/form", reminder: Reminder.new(deliver_on: Date.current), subject: subject, show_body: false %>
    </div>
  </details>
<% end %>
