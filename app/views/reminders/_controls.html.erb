<%# Reminders on an event (D-reminders). Locals: subject (an Event).
    Two ways to set one, because "an hour before" and "at 7am on the day"
    are genuinely different asks — the first follows the event if it moves,
    the second stays put. A task's reminder isn't set here: it is the
    "Remind me at" and Repeat fields on the task's own form
    (D-reminders-on-tasks). %>
<% pending = subject.reminders.pending.order(:deliver_at) %>
<%= render Ui::CardComponent.new(title: "Reminders", subtitle: "Sent to your phone at the time you pick") do %>
  <% if pending.any? %>
    <ul class="mb-4 space-y-2">
      <%= render partial: "reminders/reminder", collection: pending %>
    </ul>
  <% end %>

  <% if subject.remind_from %>
    <%= render "reminders/lead_form", reminder: Reminder.new, subject: subject %>
  <% end %>

  <details class="<%= "mt-3" if subject.remind_from %>">
    <summary class="cursor-pointer text-sm font-medium text-primary-700">
      <%= subject.remind_from ? "Or pick an exact time" : "Pick a time" %>
    </summary>
    <div class="mt-3">
      <%= render "reminders/form", reminder: Reminder.new(deliver_on: Date.current), subject: subject %>
    </div>
  </details>
<% end %>
