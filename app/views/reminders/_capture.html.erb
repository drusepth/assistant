<%# Plain words into the form (D-standing-reminders): one line, and the
    household's model fills the fields below for the user to check. Only
    ever a prefill — the click on "Remind me" is still the only write.
    Locals: text (what to show in the box), error (optional), filled
    (optional: the form below was just filled from this). Off, and said so,
    without a model. %>
<div id="reminder_capture" class="mb-4 rounded-xl bg-canvas/60 p-3">
  <% if model_configured? %>
    <%= form_with url: parse_reminders_path, class: "flex flex-wrap items-end gap-2" do |form| %>
      <div class="min-w-56 flex-1">
        <%= form.field :text, label_text: "Or just say it", value: text,
              placeholder: "Take the trash out every Thursday night", maxlength: 200 %>
      </div>
      <%= form.submit "Fill it in", class: "btn btn-secondary", data: { turbo_submits_with: "Reading…" } %>
    <% end %>
    <% if local_assigns[:error] %>
      <p class="field-error mt-2"><%= error %></p>
    <% elsif local_assigns[:filled] %>
      <p class="callout mt-2">Filled in below — check it, change anything, then Remind me.</p>
    <% else %>
      <p class="hint mt-2">The model reads it and fills in the form; nothing is set until you say so.</p>
    <% end %>
  <% else %>
    <p class="hint">Set up a model in Settings and you can type a reminder in plain words — "take the trash out every Thursday night" — and have the form filled in for you.</p>
  <% end %>
</div>
