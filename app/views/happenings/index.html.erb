<%# What's on near your places (D-event-radar): the everything-view, in the
    reader's density — upcoming, by day, filtered by place or source. Every
    row ends in a verb: onto your calendar, onto your board, or out of the way. %>
<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
  <h1 class="display text-2xl text-ink">What's on</h1>
  <div class="flex flex-wrap items-baseline gap-3 text-xs">
    <%= link_to "Places", places_path, class: "reader-filter" %>
    <%# Matched-only exists only where a model can have matched anything. %>
    <% if @model && @river.show == "upcoming" %>
      <%= link_to "For you", happenings_path(request.query_parameters.except("all")), class: "reader-filter #{"reader-filter-on" if @matched_only}" %>
      <%= link_to "Everything", happenings_path(request.query_parameters.merge(all: 1)), class: "reader-filter #{"reader-filter-on" unless @matched_only}" %>
    <% end %>
    <%# Volunteer roles have no date; they get their own pile rather than
        a day heading they don't belong under (D-listing-feeds §4.6). %>
    <% if @river.show == "upcoming" %>
      <% if params[:kind] == "opening" %>
        <%= link_to "Events too", happenings_path(request.query_parameters.except("kind")), class: "reader-filter reader-filter-on" %>
      <% else %>
        <%= link_to "Openings", happenings_path(request.query_parameters.merge(kind: "opening")), class: "reader-filter" %>
      <% end %>
      <%= link_to "Hidden", happenings_path(request.query_parameters.merge(show: "hidden")), class: "reader-filter" %>
      <%= link_to "Out of range", happenings_path(request.query_parameters.merge(show: "out_of_range")), class: "reader-filter" %>
    <% else %>
      <%= link_to "Upcoming", happenings_path(request.query_parameters.except("show")), class: "reader-filter" %>
    <% end %>
  </div>
</div>

<% if @places.size > 1 %>
  <p class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 px-3 text-xs">
    <%= link_to "Everywhere", happenings_path(show: params[:show]), class: "reader-filter #{"reader-filter-on" unless @place}" %>
    <% @places.each do |place| %>
      <%= link_to place.name, happenings_path(place: place.id, show: params[:show]),
            class: "reader-filter #{"reader-filter-on" if @place == place}" %>
    <% end %>
  </p>
<% end %>

<% if @source %>
  <p class="mb-3 px-3 text-xs text-soft">
    From <%= @source.display_title %> only ·
    <%= link_to "all of #{@place.name}", happenings_path(place: @place.id, show: params[:show]), class: "reader-filter" %>
  </p>
<% end %>

<% if @river.show != "upcoming" %>
  <p class="mb-3 px-3 text-xs text-soft">
    <% if @river.show == "hidden" %>
      Things you hid. Unhide one to put it back.
    <% else %>
      Listed by a calendar you follow, but further away than the place's radius allows — widen
      the radius under <%= link_to "Places", places_path, class: "reader-filter" %> if these should count.
    <% end %>
  </p>
<% end %>

<% if @days.any? %>
  <div class="card divide-y divide-edge py-1" data-happenings>
    <% @days.each do |day, rows| %>
      <h2 class="px-4 pt-3 pb-1 text-xs font-medium uppercase tracking-wide text-soft">
        <%= rows.first.kind_opening? ? "Openings · seen #{happening_day_label(day).downcase}" : happening_day_label(day) %>
      </h2>
      <%= render partial: "happenings/happening", collection: rows, as: :happening %>
    <% end %>
  </div>
<% elsif @places.empty? %>
  <p class="px-3 py-8 text-center text-sm text-soft">
    Nothing here until there is somewhere to look.
    <%= link_to "Add a place", places_path, class: "reader-filter" %> and follow a calendar or two for it.
  </p>
<% elsif @places.sum { |place| place.listing_sources.size }.zero? %>
  <p class="px-3 py-8 text-center text-sm text-soft">
    No calendars followed yet. <%= link_to "Follow one", places_path, class: "reader-filter" %> —
    the library's, the city's, a Meetup group's — and what it publishes lands here by date.
  </p>
<% elsif @matched_only %>
  <p class="px-3 py-8 text-center text-sm text-soft">
    Nothing matched to you<%= " in #{@place.name}" if @place %> yet — new listings are read as they arrive.
    <%= link_to "See everything upcoming", happenings_path(request.query_parameters.merge(all: 1)), class: "reader-filter" %>,
    or tell the radar more under <%= link_to "Places", places_path(anchor: "briefs"), class: "reader-filter" %>.
  </p>
<% else %>
  <p class="px-3 py-8 text-center text-sm text-soft">
    Nothing upcoming<%= " in #{@place.name}" if @place %> right now. New listings arrive on their own as the
    calendars you follow are checked.
  </p>
<% end %>

<% if @places.any? && !@model %>
  <p class="mt-3 px-3 text-xs text-soft">
    No model is configured, so nothing here is matched to your hobbies — everything near each place is
    listed by date.
  </p>
<% end %>
