<%# The opt-in searches (D-listing-feeds §8): a keyed provider queried by
    this place's point and radius. Off by default; the sentence on the
    switch says what gets sent, and the box has to be ticked. Locals: place. %>
<% on = place.listing_sources.select(&:provider?).index_by(&:provider) %>
<details class="mt-3 text-xs text-soft" data-providers>
  <summary class="reader-filter cursor-pointer">Search a ticketing provider for <%= place.name %></summary>
  <div class="mt-3 space-y-4">
    <% ListingSource::PROVIDERS.each do |slug, settings| %>
      <div class="rounded-lg border border-edge p-3">
        <p class="font-medium text-ink"><%= settings[:label] %><%= " — on" if on[slug] %></p>
        <p class="mt-1"><%= settings[:blurb] %></p>
        <% if on[slug] %>
          <p class="mt-2">Searching within <%= Current.user.units.distance_phrase(place.radius_mi) %> on the same schedule as a calendar. Unfollow it in the list above to turn it off.</p>
        <% else %>
          <%= form_with url: place_listing_sources_path(place), class: "mt-3 space-y-2" do |form| %>
            <%= hidden_field_tag :provider, slug, id: "provider_#{slug}_#{place.id}" %>
            <%= hidden_field_tag :return_to, places_path(anchor: dom_id(place)), id: "provider_return_#{slug}_#{place.id}" %>
            <% settings[:fields].each do |field| %>
              <div class="space-y-1">
                <%= label_tag "provider_#{slug}_#{field[:key]}_#{place.id}", field[:label], class: "label" %>
                <%= password_field_tag "credentials[#{field[:key]}]", nil, id: "provider_#{slug}_#{field[:key]}_#{place.id}", class: "input", required: true %>
                <% if field[:hint] %><p class="hint"><%= field[:hint] %></p><% end %>
              </div>
            <% end %>
            <label class="flex items-start gap-2 text-sm text-ink">
              <%= check_box_tag :consent, "1", false, id: "provider_consent_#{slug}_#{place.id}", class: "mt-0.5 size-4 accent-primary-600" %>
              <span><%= settings[:consent] %></span>
            </label>
            <%= form.submit "Turn on #{settings[:label]}", class: "btn btn-secondary btn-sm" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</details>
