<%= render Ui::PageHeaderComponent.new(
      title: "Admin",
      subtitle: "How this instance is behaving when nobody is watching") %>

<div class="max-w-3xl space-y-6">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @error_count %></p>
      <p class="text-xs text-soft">Errors logged</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @failed_tool_runs %></p>
      <p class="text-xs text-soft">Failed tool runs</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @failed_documents %></p>
      <p class="text-xs text-soft">Failed analyses</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @queue.failed_count || "—" %></p>
      <p class="text-xs text-soft">Failed jobs</p>
    </div>
  </div>

  <%= render Ui::CardComponent.new(
        title: "AI model",
        subtitle: @model_profile&.configured? ?
          "Configured — #{@model_profile.display_name}" :
          "Not configured — document understanding and auto-filing are off") do %>
    <p class="text-sm text-soft">
      Every AI feature in the app runs through this one household profile, so a
      bad key or an unreachable endpoint shows up as silence rather than an
      error. If the log below is full of <span class="font-mono text-xs">Llm::Error</span>,
      start here.
    </p>
    <div class="mt-3">
      <%= link_to "Open model settings", settings_path, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(
        title: "Background jobs",
        subtitle: "Adapter: #{@queue.adapter_name}") do %>
    <% if @queue.available? %>
      <div class="flex flex-wrap gap-6 text-sm">
        <span><span class="font-semibold text-ink"><%= @queue.pending_count %></span> <span class="text-soft">pending</span></span>
        <span><span class="font-semibold text-ink"><%= @queue.scheduled_count %></span> <span class="text-soft">scheduled</span></span>
        <span><span class="font-semibold text-ink"><%= @queue.failed_count %></span> <span class="text-soft">failed</span></span>
      </div>

      <% failures = @queue.recent_failures %>
      <% if failures.any? %>
        <ul class="mt-4 space-y-2">
          <% failures.each do |failure| %>
            <li class="rounded-lg border border-edge px-4 py-2.5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-xs font-semibold text-ink"><%= failure[:job_class] %></span>
                <span class="text-xs text-soft"><%= time_ago_in_words(failure[:failed_at]) %> ago</span>
              </div>
              <p class="mt-1 text-sm text-ink"><%= failure[:error] %></p>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% else %>
      <p class="text-sm text-soft">
        Solid Queue is only configured in production, so there are no job tables
        to read here. Jobs still run — in development they run inline on the
        async adapter — and anything they swallow is in the error log below.
      </p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Recent errors", padded: false) do |card| %>
    <% card.with_actions do %>
      <%= link_to "View all", admin_errors_path, class: "btn btn-secondary btn-sm" %>
    <% end %>

    <% if @errors.any? %>
      <ul class="divide-y divide-edge">
        <%= render partial: "admin/error", collection: @errors, as: :error %>
      </ul>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">
        Nothing has gone wrong yet. Failures that the app hides from the person
        who triggered them — a model timing out mid auto-file, a tool run
        breaking — land here.
      </p>
    <% end %>
  <% end %>
</div>
