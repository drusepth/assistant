<%= render Ui::PageHeaderComponent.new(
      title: "Admin",
      subtitle: "How this instance is behaving when nobody is watching") %>

<div class="max-w-3xl space-y-6">
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @error_count %></p>
      <p class="text-xs text-soft">Errors logged</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @failed_tool_runs %></p>
      <p class="text-xs text-soft">Failed tool runs</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @failed_documents %></p>
      <p class="text-xs text-soft">Failed analyses</p>
    </div>
    <div class="card p-4">
      <p class="text-2xl font-bold text-ink"><%= @queue.failed_count || "—" %></p>
      <p class="text-xs text-soft">Failed jobs</p>
    </div>
  </div>

  <%= render Ui::CardComponent.new(
        title: "AI model",
        subtitle: @model_profile&.configured? ?
          "Configured — #{@model_profile.display_name}" :
          "Not configured — document understanding and auto-filing are off") do %>
    <p class="text-sm text-soft">
      Every AI feature in the app runs through this one household profile, so a
      bad key or an unreachable endpoint shows up as silence rather than an
      error. If the log below is full of <span class="font-mono text-xs">Llm::Error</span>,
      start here.
    </p>
    <div class="mt-3">
      <%= link_to "Open model settings", settings_path, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(
        title: "Public datasets",
        subtitle: "Local BLS data behind the Career tools (D31) — staleness is shown, never hidden") do %>
    <div class="space-y-3 text-sm text-soft">
      <% @datasets.each do |dataset| %>
        <div>
          <p>
            <span class="font-medium text-ink"><%= dataset.label %>:</span>
            <%= dataset.summary %>
          </p>
          <% if dataset.refreshed_at %>
            <p class="text-xs text-soft">
              Updated <%= time_ago_in_words(dataset.refreshed_at) %> ago<%= " from #{dataset.source}" if dataset.source %>
            </p>
          <% end %>
          <% if dataset.failed? %>
            <p class="mt-1 text-xs text-red-700">
              Last <%= dataset.failed_action %> failed <%= time_ago_in_words(dataset.error.created_at) %> ago —
              <%= dataset.error.message %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <%= button_to "Fetch from BLS", admin_refresh_datasets_path, class: "btn btn-secondary btn-sm" %>
      <%# The file input carries a wide intrinsic width ("Choose file — no file
          chosen"), so this row wraps and the input is allowed to shrink —
          otherwise it pushes the whole admin page sideways on a phone. %>
      <%= form_with url: admin_import_datasets_path, class: "flex min-w-0 flex-wrap items-center gap-2" do %>
        <%= file_field_tag :file, accept: ".zip,.xlsx,.csv", class: "min-w-0 max-w-full text-sm" %>
        <%= submit_tag "Import file", class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
    <p class="mt-2 text-xs text-soft">
      Air-gapped? Download the OES national zip and (optionally) a year,value CPI csv elsewhere and import them here.
    </p>
  <% end %>

  <%= render Ui::CardComponent.new(
        title: "Background jobs",
        subtitle: "Adapter: #{@queue.adapter_name}") do |card| %>
    <% if @queue_failures.any? %>
      <% card.with_actions do %>
        <span data-controller="clipboard" data-clipboard-text-value="<%= @queue.report_for(@queue_failures) %>">
          <button type="button" class="btn btn-secondary btn-sm"
                  data-clipboard-target="button" data-action="clipboard#copy">Copy all</button>
        </span>
        <%= button_to "Discard all", discard_all_admin_failed_jobs_path, method: :delete,
              class: "btn btn-danger btn-sm",
              form: { data: { turbo_confirm: "Discard every failed job? They will never run." } } %>
      <% end %>
    <% end %>

    <% if @queue.available? %>
      <div class="flex flex-wrap gap-6 text-sm">
        <span><span class="font-semibold text-ink"><%= @queue.pending_count %></span> <span class="text-soft">pending</span></span>
        <span><span class="font-semibold text-ink"><%= @queue.scheduled_count %></span> <span class="text-soft">scheduled</span></span>
        <span><span class="font-semibold text-ink"><%= @queue.failed_count %></span> <span class="text-soft">failed</span></span>
      </div>

      <% if @queue_failures.any? %>
        <ul class="mt-4 space-y-2">
          <% @queue_failures.each do |failure| %>
            <li class="rounded-lg border border-edge px-4 py-2.5"
                data-controller="clipboard" data-clipboard-text-value="<%= @queue.failure_report(failure) %>">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-xs font-semibold text-ink"><%= failure[:job_class] %></span>
                <span class="flex items-baseline gap-2">
                  <span class="text-xs text-soft"><%= time_ago_in_words(failure[:failed_at]) %> ago</span>
                  <button type="button" class="btn btn-secondary btn-sm"
                          data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
                </span>
              </div>
              <p class="mt-1 text-sm text-ink"><%= failure[:message].presence || failure[:error_class] %></p>
              <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
                <span class="chip bg-red-50 text-red-700"><%= failure[:error_class] %></span>
              </div>
              <% if failure[:backtrace].present? %>
                <details class="mt-2">
                  <summary class="cursor-pointer text-xs text-soft">Backtrace</summary>
                  <pre class="mt-1.5 overflow-x-auto rounded-lg bg-canvas p-3 font-mono text-xs leading-relaxed text-soft"><%= failure[:backtrace] %></pre>
                </details>
              <% end %>
              <div class="mt-2 flex gap-2">
                <%= button_to "Retry", retry_admin_failed_job_path(failure[:id]), method: :post,
                      class: "btn btn-secondary btn-sm" %>
                <%= button_to "Discard", discard_admin_failed_job_path(failure[:id]), method: :delete,
                      class: "btn btn-danger btn-sm",
                      form: { data: { turbo_confirm: "Discard this failed job? It will never run." } } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% else %>
      <p class="text-sm text-soft">
        Solid Queue is only configured in production, so there are no job tables
        to read here. Jobs still run — in development they run inline on the
        async adapter — and anything they swallow is in the error log below.
      </p>
    <% end %>
  <% end %>

  <%# Instance mail (D-instance-mail): whether it's on, never the secrets. %>
  <%= render Ui::CardComponent.new(
        title: "Email",
        subtitle: InstanceMail.configured? ? "Sending through #{InstanceMail.address}" : "Off — this server sends no email of its own") do %>
    <p class="text-sm text-soft">
      Optional, any provider, set by ENV (see <span class="font-mono text-xs">docs/MAIL.md</span>).
      Nothing depends on it: reset links come from the Household page or
      <span class="font-mono text-xs">bin/rails password:reset_link</span>, and members can send
      notification email through their own linked mailbox.
    </p>
    <% if InstanceMail.configured? %>
      <dl class="mt-3 space-y-1.5 text-sm">
        <div class="flex flex-wrap justify-between gap-2"><dt class="text-soft">Sends as</dt><dd class="text-ink"><%= InstanceMail.from %></dd></div>
        <div class="flex flex-wrap justify-between gap-2">
          <dt class="text-soft">Emailed password resets</dt>
          <dd class="text-ink"><%= InstanceMail.password_resets? ? "On" : "Off until APP_HOST is set" %></dd>
        </div>
      </dl>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(
        title: "Storage",
        subtitle: "Active Storage service: #{@storage.service}") do %>
    <p class="text-sm text-soft">
      Where originals live is instance configuration — local disk by default,
      any S3-compatible bucket via ENV (see <span class="font-mono text-xs">docs/STORAGE.md</span>).
      Per-member numbers are counts and sizes only; the items themselves stay
      private until shared.
    </p>
    <div class="mt-3 space-y-1.5 text-sm">
      <% @storage.per_member.each do |row| %>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <%= render Ui::UserLabelComponent.new(user: row[:user], css_class: "text-ink", truncate: true) %>
          <span class="text-soft">
            <%= pluralize(row[:photos], "photo") %> · <%= pluralize(row[:documents], "document") %> ·
            <%= number_to_human_size(row[:bytes]) %>
          </span>
        </div>
      <% end %>
      <div class="flex items-baseline justify-between gap-2 border-t border-edge pt-1.5 font-medium">
        <span class="text-ink">Total</span>
        <span class="text-ink"><%= number_to_human_size(@storage.total_bytes) %></span>
      </div>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Recent errors", padded: false) do |card| %>
    <% card.with_actions do %>
      <%= link_to "View all", admin_errors_path, class: "btn btn-secondary btn-sm" %>
    <% end %>

    <% if @errors.any? %>
      <ul class="divide-y divide-edge">
        <%= render partial: "admin/error", collection: @errors, as: :error %>
      </ul>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">
        Nothing has gone wrong yet. Failures that the app hides from the person
        who triggered them — a model timing out mid auto-file, a tool run
        breaking — land here.
      </p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(
        title: "Reset this household",
        subtitle: "Delete everything and start again from the signup form") do %>
    <p class="text-sm text-soft">
      Trying the app out fills it with data you never meant to keep. This
      empties the household completely —
      <span class="font-medium text-ink"><%= pluralize(@reset_preview[:items], "item") %></span>
      across
      <span class="font-medium text-ink"><%= pluralize(@reset_preview[:members], "account") %></span>,
      plus every uploaded file, tool run, sharing grant and setting — and hands
      the instance back to the first-run signup form, exactly as it arrived.
    </p>
    <p class="mt-2 text-sm text-soft">
      It takes your own account too, so you will be signed out. There is no
      undo: if any of this is real, take a copy from
      <%= link_to "Settings → Export", settings_path, class: "underline" %> first.
    </p>

    <%= form_with url: admin_reset_path, class: "mt-4 flex flex-wrap items-end gap-2" do |form| %>
      <div class="space-y-1">
        <%= label_tag :confirmation, "Type #{Admin::HouseholdReset::CONFIRMATION} to confirm", class: "label" %>
        <%= text_field_tag :confirmation, nil, class: "input w-40", autocomplete: "off",
              placeholder: Admin::HouseholdReset::CONFIRMATION %>
      </div>
      <button type="submit" class="btn btn-danger"
              data-turbo-confirm="Delete every item and account in this household? This cannot be undone.">
        Clear all data
      </button>
    <% end %>
  <% end %>
</div>
