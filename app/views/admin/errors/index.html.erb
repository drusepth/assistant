<%= render Ui::PageHeaderComponent.new(
      title: "Error log",
      subtitle: "#{pluralize(@error_count, "error")} recorded — newest first") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Back to admin", admin_root_path, class: "btn btn-secondary btn-sm" %>
    <% if @errors.any? %>
      <%= button_to "Clear log", destroy_all_admin_errors_path, method: :delete,
            class: "btn btn-danger btn-sm",
            form: { data: { turbo_confirm: "Delete every recorded error?" } } %>
    <% end %>
  <% end %>
<% end %>

<div class="max-w-3xl">
  <% if @errors.any? %>
    <%= render Ui::CardComponent.new(padded: false) do %>
      <ul class="divide-y divide-edge">
        <%= render partial: "admin/error", collection: @errors, as: :error %>
      </ul>
    <% end %>

    <% if @error_count > @errors.size %>
      <p class="mt-3 text-center text-xs text-soft">
        Showing the most recent <%= @errors.size %>. The log keeps the last
        <%= AppError::KEPT %> errors and prunes older ones automatically.
      </p>
    <% end %>
  <% else %>
    <%= render Ui::EmptyStateComponent.new(
          title: "No errors recorded",
          description: "Background failures the app deliberately hides from the person who triggered them show up here.") %>
  <% end %>
</div>
