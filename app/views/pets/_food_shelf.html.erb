<%# The food shelf (D-pet-food-shelf): what she's on, when the bag runs out,
    what it costs. Every number here is arithmetic over what the owner typed
    — nothing is estimated from breed or weight, and nothing is rated. %>
<%= render Ui::CardComponent.new(title: "Food",
      subtitle: shelf.monthly_cost_cents ? "About #{money_amount(shelf.monthly_cost_cents)} a month#{" for the foods that carry a price" if shelf.partial_cost?}." : "What #{pet.pronouns.subject} #{pet.pronouns.verb("eats", "eat")}, and since when.") do |card| %>
  <% if own && shelf.current.any? %>
    <% card.with_actions do %>
      <%= link_to "Add a food", "#add-food", class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <% if shelf.current.any? %>
      <div class="divide-y divide-edge">
        <% shelf.current.each do |food| %>
          <div class="flex flex-wrap items-center gap-3 py-3 first:pt-0">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-ink">
                <%= food.display_name %>
                <span class="chip ml-1 bg-canvas text-soft"><%= food.form_label %></span>
              </p>
              <p class="mt-0.5 text-xs text-soft">
                <%= pet_food_line(food) %>
              </p>
            </div>
            <% if own %>
              <div class="row-actions">
                <% if food.runs_out_on %>
                  <%= button_to "Put reorder on the calendar", reorder_pet_food_path(pet, food), method: :post, class: "btn btn-ghost btn-sm" %>
                <% end %>
                <%= button_to "Add to shopping list", add_to_list_pet_food_path(pet, food), method: :post, class: "btn btn-ghost btn-sm" %>
                <%= button_to "No longer feeding", end_food_pet_food_path(pet, food), method: :patch, class: "btn btn-ghost btn-sm",
                      data: { turbo_confirm: "Move #{food.display_name} to the diet history? Nothing is deleted." } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-soft">Nothing on the shelf yet. Add what <%= pet.name %> eats and the app works out when the bag runs out and what it costs a month.</p>
    <% end %>

    <% if shelf.past.any? %>
      <details class="text-sm">
        <summary class="cursor-pointer text-primary-700 hover:underline">Diet history (<%= shelf.past.size %>)</summary>
        <%# The thing the vet actually asks for: what, and since when. %>
        <ul class="mt-2 space-y-1 text-xs text-soft">
          <% shelf.past.each do |food| %>
            <li><%= food.display_name %> — <%= food.started_on.strftime("%b %Y") %> to <%= food.ended_on.strftime("%b %Y") %></li>
          <% end %>
        </ul>
      </details>
    <% end %>

    <% if own %>
      <details id="add-food" class="border-t border-edge pt-3">
        <summary class="cursor-pointer text-sm font-medium text-primary-700 hover:underline">Add a food</summary>
        <%= form_with model: [ pet, PetFood.new ], url: pet_foods_path(pet), class: "mt-3 space-y-3" do |form| %>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <%= form.field :name, label_text: "Food", placeholder: "Adult chicken & rice" %>
            <%= form.field :brand, placeholder: "Who makes it" %>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
            <%= form.field :form do %>
              <%= form.select :form, PetFood::FORMS.map { |slug| [ PetFood::FORM_LABELS[slug], slug ] } %>
            <% end %>
            <%= form.field :amount_per_day, as: :number_field, label_text: "A day", step: "0.01" %>
            <%= form.field :unit, label_text: "in" do %>
              <%= form.select :unit, PetFood::UNITS %>
            <% end %>
            <%# The bag carries its own unit: a sack is sold in kilos and fed
                in grams, and making the owner convert produced a confident
                wrong reorder date rather than an error. %>
            <%= form.field :package_amount, as: :number_field, label_text: "Bag size", step: "0.01" %>
            <%= form.field :package_unit, label_text: "in" do %>
              <%= form.select :package_unit, PetFood::UNITS %>
            <% end %>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <%= form.field :package_cost, as: :number_field, label_text: "Price a bag", step: "0.01" %>
            <%# Prefilled rather than defaulted server-side: the value is on
                screen where it can be cleared, and clearing it means the app
                makes no reorder claim at all. %>
            <%= form.field :opened_on, as: :date_field, label_text: "Bag opened", value: Date.current,
                  hint: "Clear it and the app makes no reorder claim." %>
            <%= form.field :started_on, as: :date_field, label_text: "Feeding since" %>
          </div>
          <label class="flex items-start gap-2 text-sm">
            <%= check_box_tag :replaces_current, "1", false, class: "mt-0.5 size-4 rounded accent-primary-600" %>
            <span class="text-soft">This replaces what <%= pet.pronouns.is %> on now — move the old one to the diet history</span>
          </label>
          <%= form.submit "Add to the shelf", class: "btn btn-primary btn-sm" %>
        <% end %>
      </details>
    <% end %>
  </div>
<% end %>
