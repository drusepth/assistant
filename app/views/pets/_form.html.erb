<%= form_with model: pet, class: "space-y-4" do |form| %>
  <%= render "pets/photo_field", form: form, pet: pet %>
  <%= form.field :name %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= form.field :species do %>
      <%= form.select :species, Pet::SPECIES.map { |slug| [ Pet::SPECIES_LABELS[slug], slug ] } %>
    <% end %>
    <div data-controller="breed-guess" data-breed-guess-url-value="<%= breed_guess_path %>">
      <%= form.field :breed do %>
        <%= form.text_field :breed, placeholder: "Golden retriever, tabby, lop…", data: { breed_guess_target: "input" } %>
        <%= render "pets/breed_guess", pet: pet %>
      <% end %>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%# Sex is what the app reads to decide whether to write "she", "he" or
        "they" about this pet (D-pronouns), which is why the hint says so —
        leaving it blank is a real answer, not an unfinished form. The
        override beside it is the household that calls their male cat "they"
        not being argued with. %>
    <%= form.field :sex, hint: "Also picks the pronoun the app uses, unless you set one beside it." do %>
      <%= form.select :sex, Pet::SEXES.map { |slug| [ Pet::SEX_LABELS[slug], slug ] }, include_blank: "Not recorded" %>
    <% end %>
    <%= form.field :pronoun, label_text: "Refer to #{pet.name.presence || "them"} as",
          hint: "Only if the sex beside it gets it wrong." do %>
      <%= form.select :pronoun, Pronouns.options, include_blank: "Follow the sex" %>
    <% end %>
  </div>
  <label class="flex items-start gap-2 text-sm">
    <%= form.check_box :neutered, class: "mt-0.5" %>
    <span class="text-soft">Spayed or neutered</span>
  </label>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= form.field :color, label_text: "Colour and markings", placeholder: "Black with a white chest" %>
    <%= form.field :microchip, label_text: "Microchip number" %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= form.field :born_on, as: :date_field, label_text: "Date of birth" %>
    <%= form.field :adopted_on, as: :date_field, label_text: "Adoption day",
          hint: "The gotcha day — what the app celebrates when there's no known birthday." %>
  </div>
  <%# A rescue's date of birth is a vet's guess, and the app would rather say
      "about 4" than print a birthday it was never really told. %>
  <label class="flex items-start gap-2 text-sm">
    <%= form.check_box :born_on_estimated, class: "mt-0.5" %>
    <span class="text-soft">That date of birth is an estimate</span>
  </label>

  <%= form.field :weight_kg, as: :number_field, label_text: "Weight (kg)", step: "0.01",
        hint: "The current number, for vet prep — not a log." %>

  <%# Type the vet, don't go and make a contact first: a name you already
      have is offered as you type and linked, a new one becomes a contact
      (Pets::VetContact). Blank means no vet on file. %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%= form.field :vet_name, label_text: "Vet", placeholder: "Dr. Alvarez, Riverside Animal Clinic",
          list: "pet-vet-contacts", autocomplete: "off",
          hint: "Pick someone from your contacts, or type a new name and they'll be added." %>
    <%= form.field :vet_phone, as: :telephone_field, label_text: "Vet's phone", autocomplete: "off" %>
  </div>
  <datalist id="pet-vet-contacts">
    <% Person.visible_to(Current.user).order(:name).distinct.pluck(:name).each do |name| %>
      <option value="<%= name %>"></option>
    <% end %>
  </datalist>

  <%= form.field :notes, as: :text_area, hint: "Temperament, allergies, what the sitter needs to know." %>

  <% if pet.persisted? %>
    <%= render layout: "shared/advanced", locals: { hint: "The end of a life, or a rehoming." } do %>
      <div class="space-y-4">
        <p class="hint">Either date stops every reminder about <%= pet.name %> and moves <%= pet.pronouns.object %> to Remembered. Nothing is deleted — <%= pet.pronouns.possessive %> photos, papers and history stay exactly where they are.</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <%= form.field :died_on, as: :date_field, label_text: "Died" %>
          <%= form.field :left_on, as: :date_field, label_text: "Rehomed" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <%# D9: sharing is a row someone created, never implied by living in the
        same house. The box writes ordinary grants, listed in Settings. %>
    <% if Current.user.household.users.where.not(id: Current.user.id).exists? %>
      <label class="flex items-start gap-2 text-sm">
        <%= check_box_tag :share_with_household, "1", true, class: "mt-0.5" %>
        <span class="text-soft">Everyone in the household looks after this pet — share <%= pet.pronouns.object %>, and everything filed under <%= pet.pronouns.possessive %> name</span>
      </label>
    <% end %>
  <% end %>

  <div class="flex items-center gap-2 pt-2">
    <%= form.submit %>
    <%= link_to "Cancel", pet.persisted? ? pet_path(pet) : section_path("people"), class: "btn btn-ghost" %>
  </div>
<% end %>
