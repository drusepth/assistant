<%# The mechanism, said out loud once (D-pet-primitive). A pet's lens is an
    ordinary section, so every capture form in the app can file to her — and
    the one place worth explaining that is her own page. %>
<%= render Ui::CardComponent.new(title: "Filed under #{pet.name}",
      subtitle: "#{pet.pronouns.possessive.capitalize} name is a tag, so #{pet.pronouns.possessive} vet visits stay Health and #{pet.pronouns.possessive} food stays Money.") do %>
  <div class="space-y-3">
    <div class="flex flex-wrap gap-2">
      <%= link_to "Add an event", new_event_path(section_ids: [ pet.section_id ]), class: "btn btn-secondary btn-sm" %>
      <%= link_to "Add a task", new_task_path(section_ids: [ pet.section_id ]), class: "btn btn-secondary btn-sm" %>
      <%= link_to "Add a note", new_note_path(section_ids: [ pet.section_id ]), class: "btn btn-secondary btn-sm" %>
      <%= link_to "Add a document", new_document_path(section_ids: [ pet.section_id ]), class: "btn btn-secondary btn-sm" %>
    </div>
    <p class="text-sm">
      <%= link_to section_path(pet.section.slug), class: "text-primary-700 hover:underline" do %>
        Everything filed under <%= pet.name %> →
      <% end %>
    </p>
  </div>
<% end %>
