<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 px-4 py-3 sm:flex-nowrap">
  <div class="min-w-0">
    <p class="text-sm font-medium text-ink"><%= suggestion.title %></p>
    <% if suggestion.body.present? %>
      <p class="mt-0.5 text-xs text-soft"><%= suggestion.body %></p>
    <% end %>
    <% if suggestion.sections.any? %>
      <div class="mt-1 flex flex-wrap items-center gap-1.5">
        <% suggestion.sections.each do |section| %>
          <%= render Ui::SectionChipComponent.new(section: section) %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex shrink-0 items-center gap-1.5">
    <%= button_to suggestion.accept_label, accept_suggestion_path(suggestion), method: :post, class: "btn btn-primary btn-sm" %>
    <%= button_to "Later", snooze_suggestion_path(suggestion), method: :post, class: "btn btn-ghost btn-sm" %>
    <%= button_to "Dismiss", dismiss_suggestion_path(suggestion), method: :post, class: "btn btn-ghost btn-sm" %>
  </div>
</div>
