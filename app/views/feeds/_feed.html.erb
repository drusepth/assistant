<%# One subscription, on one line. Honest about the last fetch: a feed that
    has been failing for a week says so here rather than going quiet, which
    is the failure mode that made people stop trusting readers. Locals:
    feed, unread_counts. %>
<% unread = unread_counts.fetch(feed.id, 0) %>
<div class="reader-line group">
  <div class="min-w-0 flex-1">
    <%= link_to feed.display_title, reader_path(feed: feed.id),
          class: "text-sm font-semibold text-ink hover:underline" %>
    <% if unread.positive? %>
      <span class="text-xs tabular-nums text-soft">(<%= unread %>)</span>
    <% end %>
    <p class="flex flex-wrap items-center gap-x-1.5 text-xs text-soft">
      <span class="truncate"><%= feed.host || feed.url %></span>
      <% feed.sections.each do |section| %>
        <span class="chip <%= section_chip_classes(section) %>"><%= section.name %></span>
      <% end %>
      <% unless feed.active? %><span>· paused</span><% end %>
      <% if !feed.healthy? %>
        <span class="text-primary-800">· failing — <%= feed.last_error %></span>
      <% elsif feed.last_fetched_at %>
        <span>· checked <%= reader_age(feed.last_fetched_at) %> ago</span>
      <% else %>
        <span>· first check on its way</span>
      <% end %>
    </p>
  </div>

  <div class="reader-verbs">
    <%= button_to "Check", refresh_feed_path(feed), class: "reader-verb", form_class: "contents" %>
    <%= link_to "Edit", edit_feed_path(feed), class: "reader-verb" %>
    <%= button_to "Unfollow", feed_path(feed), method: :delete, class: "reader-verb",
          form_class: "contents",
          form: { data: { turbo_confirm: "Unfollow #{feed.display_title}? Its items go too — anything you saved from it as a task or note stays." } } %>
  </div>
</div>
