<%# One subscription, on one line. Honest about the last fetch: a feed that
    has been failing for a week says so here rather than going quiet, which
    is the failure mode that made people stop trusting readers. Locals:
    feed, unread_counts. %>
<% unread = unread_counts.fetch(feed.id, 0) %>
<div class="reader-line group">
  <div class="min-w-0 flex-1">
    <%= link_to feed.display_title, reader_path(feed: feed.id),
          class: "text-sm font-semibold text-ink hover:underline" %>
    <% if unread.positive? %>
      <span class="text-xs tabular-nums text-soft">(<%= unread %>)</span>
    <% end %>
    <p class="flex flex-wrap items-center gap-x-1.5 text-xs text-soft">
      <span class="truncate"><%= feed.host || feed.url %></span>
      <% feed.sections.each do |section| %>
        <span class="chip <%= section_chip_classes(section) %>"><%= section.name %></span>
      <% end %>
      <%# Why it is in the catch-all matters, because it is what says whether
          Re-file will do anything: a feed the model has never seen is one
          answer away from a hobby, and one it has already considered needs
          a hobby to exist first (D-hobby-feeds). %>
      <% if feed_unfiled?(feed) %>
        <span>· <%= feed.classified? ? "no hobby matched" : "not filed yet" %></span>
      <% end %>
      <% unless feed.active? %><span>· paused</span><% end %>
      <% if !feed.healthy? %>
        <span class="text-primary-800">· failing — <%= feed.last_error %></span>
      <% elsif feed.last_fetched_at %>
        <span>· checked <%= reader_age(feed.last_fetched_at) %> ago</span>
      <% else %>
        <span>· first check on its way</span>
      <% end %>
    </p>
  </div>

  <%# Filing a stray feed where you noticed it was stray. The Edit page can
      do this too, but "notice it, open a form, find the picker, save" is
      three screens away from the row that told you, and this is the one
      correction the classifier will actually make people want.

      From `lg` only, with the verbs it belongs to. On a phone a select plus
      a button is most of the row's width, so the title wrapped to three
      lines and the picker still read "File under…" — a full-height control
      shouting at every stray in a list you came to *scan*. Filing is a
      pointer-side job; the phone keeps the list. %>
  <% if feed_unfiled?(feed) && lenses.any? %>
    <%= form_with model: feed, url: feed_path(feed), method: :patch, class: "hidden shrink-0 items-baseline gap-1.5 lg:flex" do |form| %>
      <%= hidden_field_tag :return_to, request.fullpath %>
      <%# One hobby, submitted as the one-element array `section_ids` expects:
          a multi-select in a list row is a scroll box, and filing a stray is
          a one-decision job. Anything more goes through Edit. %>
      <%= form.select :section_ids, options_from_collection_for_select(lenses, :id, :name),
            { include_blank: "File under…" },
            { name: "feed[section_ids][]", class: "input py-1 text-xs",
              "aria-label": "File #{feed.display_title} under a hobby" } %>
      <%= form.submit "File", class: "btn btn-secondary btn-sm" %>
    <% end %>
  <% end %>

  <div class="reader-verbs">
    <%# "Re-file" asks the model again (D-hobby-feeds), and only appears
        where it can change something: a filed feed's row has enough verbs
        on it already, and Edit is where second thoughts about a hobby the
        user chose belong. %>
    <% if feed_unfiled?(feed) %>
      <%= button_to "Re-file", refile_feed_path(feed), class: "reader-verb", form_class: "contents" %>
    <% end %>
    <%= button_to "Check", refresh_feed_path(feed), class: "reader-verb", form_class: "contents" %>
    <%= link_to "Edit", edit_feed_path(feed), class: "reader-verb" %>
    <%= button_to "Unfollow", feed_path(feed), method: :delete, class: "reader-verb",
          form_class: "contents",
          form: { data: { turbo_confirm: "Unfollow #{feed.display_title}? Its items go too — anything you saved from it as a task or note stays." } } %>
  </div>
</div>
