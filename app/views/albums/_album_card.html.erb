<%= link_to album_path(album), class: "card group block overflow-hidden p-0" do %>
  <div class="aspect-[4/3] overflow-hidden bg-stone-100">
    <% if (cover = album.cover) %>
      <%= image_tag url_for(cover.image.variant(:thumb)), alt: album.title, loading: "lazy",
            class: "size-full object-cover transition-transform duration-150 group-hover:scale-105" %>
    <% else %>
      <div class="flex size-full items-center justify-center text-stone-300">
        <%= icon(:photo, css_class: "size-10") %>
      </div>
    <% end %>
  </div>
  <div class="p-3">
    <p class="text-sm font-medium text-ink"><%= album.title %></p>
    <p class="mt-0.5 text-xs text-soft">
      <%= pluralize(album.photos.size, "photo") %><% if album.user_id != Current.user.id %> · by <%= album.user.name %><% end %>
    </p>
  </div>
<% end %>
