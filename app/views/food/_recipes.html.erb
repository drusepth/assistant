<%# The recipe box, glimpsed (D-food-section): the library stays in the Vault,
    and this strip is what we actually eat, with the way in. %>
<%= render Ui::CardComponent.new(title: "Recipes", count: panel.recipes_count) do |card| %>
  <% card.with_actions do %>
    <%= link_to "Add a recipe", new_recipe_path, class: "btn btn-ghost btn-sm" %>
    <%= link_to "Open the recipe box", recipes_path, class: "btn btn-secondary btn-sm" %>
  <% end %>
  <% if panel.recipes.any? %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <% panel.recipes.each do |recipe| %>
        <%= render "recipes/recipe_card", recipe: recipe %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-soft">No recipes yet. Paste one in — ingredients become structure on their own — or import one from a link.</p>
  <% end %>
<% end %>
