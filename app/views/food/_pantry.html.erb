<%# In the kitchen (docs/FOOD_PLAN.md §4): what's about to go off, then how
    much is where. %>
<% kitchen = panel.kitchen %>
<%= render Ui::CardComponent.new(title: "In the kitchen", count: panel.pantry_counts.values.sum) do |card| %>
  <% card.with_actions do %>
    <%= link_to "Open", kitchen_pantry_items_path(kitchen), class: "btn btn-secondary btn-sm" %>
  <% end %>
  <% if panel.expiring.any? %>
    <h3 class="mb-1 text-xs font-bold uppercase tracking-[0.12em] text-soft">Use soon</h3>
    <ul class="mb-3 divide-y divide-edge">
      <% panel.expiring.each do |item| %>
        <li class="flex items-center justify-between gap-2 border-l-4 py-1.5 pl-2 text-sm <%= item.expired? ? "border-l-red-400" : "border-l-primary-400" %>">
          <span class="min-w-0 truncate text-ink"><%= item.item %></span>
          <span class="shrink-0 text-xs text-soft"><%= pantry_item_dates(item) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="flex flex-wrap gap-2">
    <% Food::LOCATIONS.each do |location, label| %>
      <%= link_to kitchen_pantry_items_path(kitchen, location: location), class: "chip bg-canvas text-ink hover:bg-stone-100" do %>
        <%= label %> <span class="tabular-nums text-soft"><%= panel.pantry_counts[location].to_i %></span>
      <% end %>
    <% end %>
  </div>
  <% if (line = panel.food_budget) %>
    <p class="mt-3 text-sm text-soft">
      <%= link_to line.category.name, spending_path, class: "font-medium text-ink hover:underline" %>:
      <%= number_to_currency(line.spent_cents / 100.0, unit: "", precision: 0) %><% if line.target? %> of <%= number_to_currency(line.target_cents / 100.0, unit: "", precision: 0) %><% end %>
      <%= panel.viewer.household.currency %> this month
    </p>
  <% end %>
  <% if panel.pantry_counts.empty? %>
    <p class="mt-3 text-sm text-soft">Nothing tracked yet. Check things off the list and they land here; open it to add what's already in.</p>
  <% end %>
<% end %>
