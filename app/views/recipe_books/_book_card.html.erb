<%= link_to recipe_book_path(book), class: "card group block overflow-hidden p-0" do %>
  <div class="aspect-[4/3] overflow-hidden bg-stone-100">
    <% cover = book.cover %>
    <% if cover&.image&.attached? %>
      <%= image_tag url_for(cover.image.variant(:card)), alt: book.title, loading: "lazy",
            class: "size-full object-cover transition-transform duration-150 group-hover:scale-105" %>
    <% else %>
      <div class="flex size-full items-center justify-center text-stone-300">
        <%= icon(:book_open, css_class: "size-10") %>
      </div>
    <% end %>
  </div>
  <div class="p-3">
    <p class="text-sm font-medium text-ink"><%= book.title %></p>
    <p class="mt-0.5 flex min-w-0 items-center gap-1.5 text-xs text-soft">
      <span class="shrink-0"><%= pluralize(book.recipes.size, "recipe") %></span>
      <% if book.user_id != Current.user.id %>
        <span aria-hidden="true">·</span>
        <%= render Ui::UserLabelComponent.new(user: book.user, truncate: true) do %>
          by <%= book.user.name %>
        <% end %>
      <% end %>
    </p>
  </div>
<% end %>
