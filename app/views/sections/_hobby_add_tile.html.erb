<%# The shrunken capture (docs/HOBBIES.md §1): once lenses exist, adding
    another hobby is a quiet tile at the end of the grid, not the page's
    headline. Dashed on purpose — an invitation, not a card. %>
<div class="rounded-xl border border-dashed border-edge p-5">
  <p class="text-sm font-medium text-soft">Add another hobby</p>
  <%= form_with url: hobbies_path, class: "mt-2 flex gap-2" do %>
    <%= text_field_tag :name, nil, class: "input", placeholder: "Name a hobby…" %>
    <%= submit_tag "Add", class: "btn btn-secondary" %>
  <% end %>
  <% if suggestions.any? %>
    <div class="mt-3">
      <%= render "sections/hobby_suggestions", suggestions: suggestions %>
    </div>
  <% end %>
</div>
