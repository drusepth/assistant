<%# One collection of people (D-people-circles): the circle and every group
    lens render through this same card — faces, name, one line of signal,
    and actions that end in contact. The tile can't be one big link the way
    a hobby card is: it carries its own links and a form, and an <a> inside
    an <a> is invalid markup and a broken touch target. So the title is the
    link and `group-hover:` carries the whole-card affordance. %>
<div class="card group relative flex flex-col gap-3 border-edge p-4 transition hover:border-primary-300 hover:shadow-sm">
  <%= render "sections/circle_card_summary", card: card %>

  <%# Adding someone is the card's main verb, so it is a visible "+" beside
      the faces rather than a text link in the footer (D-person-picker).
      Still a <details> — no JS to open it — whose summary sits in the
      corner and whose form unfolds at the foot of the card. An empty
      circle's card skips it: the page's lead capture sits right above and
      does the same thing. %>
  <% unless local_assigns[:capture_above] %>
    <details class="group/add" data-controller="details-focus" data-action="keydown.esc->details-focus#close">
      <summary class="absolute right-4 top-4 flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-dashed border-primary-300 text-primary-700 transition hover:border-primary-500 hover:bg-primary-50 [&::-webkit-details-marker]:hidden"
               title="Add someone" aria-label="<%= card.circle? ? "Add someone to your circle" : "Add someone to #{card.name}" %>">
        <%= icon(:plus, css_class: "size-5 transition group-open/add:rotate-45") %>
      </summary>
      <div class="border-t border-edge pt-3">
        <%= render "sections/circle_add_person",
              url: card.circle? ? people_circle_path : people_memberships_path,
              section: card.section,
              label: card.circle? ? "Add to your circle" : "Add to #{card.name}" %>
      </div>
    </details>
  <% end %>

  <% unless card.circle? %>
    <div class="mt-auto border-t border-edge pt-2.5 text-xs font-semibold">
      <%= link_to "Plan something", new_tool_run_path("get_together", inputs: { who: card.name }),
            class: "text-primary-700 hover:underline" %>
    </div>
  <% end %>
</div>
