<%# The one capture for "put a person here" (D-people-circles), shared by the
    circle card, every group card, and the group page — pick from people you
    already have, or name someone new. Circle-first ordering is the
    picker-scaling rule from docs/PEOPLE.md §3: the address book is the
    thing that gets long, and the people you tend are the ones you mean. %>
<%= form_with url: url, class: "space-y-2" do %>
  <% if local_assigns[:section] %>
    <%= hidden_field_tag :section_id, section.id %>
  <% end %>
  <% if candidates.any? %>
    <%= select_tag :person_id, options_from_collection_for_select(candidates, :id, :name),
          include_blank: "Choose someone…", class: "input w-full text-sm", "aria-label": label %>
  <% end %>
  <%= text_field_tag :name, nil, class: "input w-full text-sm",
        placeholder: candidates.any? ? "…or someone new" : "Name someone…", "aria-label": label %>
  <%= submit_tag "Add", class: "btn btn-secondary w-full" %>
<% end %>
