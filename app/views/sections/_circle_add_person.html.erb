<%# The one capture for "put a person here" (D-people-circles), shared by the
    circle card, every group card, and the group page: one type-to-find
    field (D-person-picker) — pick someone you have, or type someone new —
    and its button. The address book is the thing that gets long, so it is
    searched, never listed. %>
<%= form_with url: url, class: "flex items-center gap-2" do %>
  <% if local_assigns[:section] %>
    <%= hidden_field_tag :section_id, section.id %>
  <% end %>
  <%= render Ui::PersonPickerComponent.new(
        place: local_assigns[:section] ? :group : :circle, section: local_assigns[:section],
        label: label, input_class: "text-sm") %>
  <%= submit_tag "Add", class: "btn btn-secondary shrink-0" %>
<% end %>
