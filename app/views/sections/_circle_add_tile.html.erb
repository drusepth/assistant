<%# The shrunken group capture (D-people-circles), the _hobby_add_tile
    precedent: once collections exist, starting another one is a quiet tile
    at the end of the grid, not a headline card. Dashed on purpose — an
    invitation, not a card. Closed it is one "+ New group"; opened, one
    field (D-person-picker) — the name box and a full-width button were
    the loudest thing in the grid. %>
<details class="group/new flex flex-col rounded-2xl border border-dashed border-edge p-4 transition hover:border-primary-300"
         data-controller="details-focus" data-action="keydown.esc->details-focus#close">
  <summary class="flex flex-1 cursor-pointer list-none flex-col items-center justify-center gap-2 py-3 text-center group-open/new:flex-none group-open/new:items-start group-open/new:py-0 [&::-webkit-details-marker]:hidden">
    <span class="flex size-10 items-center justify-center rounded-full border border-dashed border-primary-300 text-primary-700 group-open/new:hidden">
      <%= icon(:plus, css_class: "size-5") %>
    </span>
    <span class="text-sm font-medium text-primary-700 group-open/new:text-soft">New group</span>
    <span class="text-xs text-soft group-open/new:hidden">Family, church, the book club, the mutual-aid crew — each gets its own page.</span>
  </summary>
  <%= form_with url: groups_path, class: "mt-3 flex items-center gap-2" do %>
    <%= text_field_tag :name, nil, class: "input text-sm", placeholder: "Name it…", "aria-label": "Name the group" %>
    <%= submit_tag "Create", class: "btn btn-secondary shrink-0" %>
  <% end %>
</details>
