<%# The shrunken group capture (D-people-circles), the _hobby_add_tile
    precedent: once collections exist, starting another one is a quiet tile
    at the end of the grid, not a headline card. Dashed on purpose — an
    invitation, not a card. %>
<div class="flex flex-col justify-center gap-2 rounded-2xl border border-dashed border-edge p-4">
  <p class="text-sm font-medium text-soft">Start a group</p>
  <p class="text-xs text-soft">Family, church, the book club, the mutual-aid crew — each one gets its own page.</p>
  <%= form_with url: groups_path, class: "mt-1 space-y-2" do %>
    <%= text_field_tag :name, nil, class: "input w-full text-sm", placeholder: "Name it…", "aria-label": "Name the group" %>
    <%= submit_tag "Add", class: "btn btn-secondary w-full" %>
  <% end %>
</div>
