<%# Subsections never render as header chips — the list scales (hobby
    lenses are unbounded, Money seeds seven) and a chip cloud has no pull.
    They get the browse grids below instead. %>
<%= render Ui::PageHeaderComponent.new(title: @section.qualified_name) do |header| %>
  <%# A lens a record owns (a pet's) is removed by removing the record. %>
  <% if @section.removable? %>
    <% header.with_actions do %>
      <% group = @section.parent&.slug == "people" %>
      <%= button_to group ? "Remove this group" : "Remove this hobby",
            group ? group_path(@section) : hobby_path(@section), method: :delete, class: "btn btn-ghost",
            data: { turbo_confirm: "Remove #{@section.name}? Your items stay — they just lose this tag." } %>
    <% end %>
  <% end %>
<% end %>

<div class="space-y-8">
  <%# Per-section lead panels (D37): a built-out section registers
      Sections::Panels::<Slug> and its partial under sections/panels/ —
      this file and the controller never change per section. Sections
      without a panel get the generic browse grid: seeded subsections
      (Money, Rights) are a fixed handful that's often empty, so they
      browse as compact tiles — name + one line of signal. %>
  <% if @panel %>
    <%= render @panel.partial, panel: @panel, section: @section, summaries: @subsection_summaries %>
  <% elsif @subsection_summaries.any? %>
    <div>
      <h2 class="mb-3 text-sm font-medium text-soft">Browse</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <%= render partial: "sections/subsection_tile", collection: @subsection_summaries, as: :summary %>
      </div>
    </div>
  <% end %>

  <%# Act zone (D18): what the app can do here — present even, especially,
      when the section is empty. %>
  <% if @tools.any? %>
    <div>
      <h2 class="mb-3 text-sm font-medium text-soft">Tools</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @tools.each do |tool| %>
          <%= render Ui::ToolCardComponent.new(tool: tool) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Attend zone (D18): the pull-side slice of the agent's suggestions —
      the Dashboard is the push surface for the same rows. %>
  <% if @suggestions.any? %>
    <%= render Ui::CardComponent.new(title: "Needs your attention", padded: false) do %>
      <div class="divide-y divide-edge"><%= render @suggestions %></div>
    <% end %>
  <% end %>

  <%# Browse zone: the lens itself. The empty state is quick capture
      pre-tagged with this section — never a dead end. %>
  <% if [ @events, @tasks, @documents, @people, @goals, @notes, @photos ].all?(&:empty?) %>
    <%= render Ui::EmptyStateComponent.new(
          title: "Nothing in #{@section.name} yet",
          description: "Anything you add here starts tagged #{@section.name} — and one item can live in several sections at once."
        ) do |empty| %>
      <% empty.with_action do %>
        <div class="flex flex-wrap justify-center gap-2">
          <%= link_to "Add a task", new_task_path(section_ids: [ @section.id ]), class: "btn btn-primary" %>
          <%= link_to "Add an event", new_event_path(section_ids: [ @section.id ]), class: "btn btn-secondary" %>
          <%= link_to "Add a note", new_note_path(section_ids: [ @section.id ]), class: "btn btn-secondary" %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="space-y-6">
      <% if @tasks.any? %>
        <%= render Ui::CardComponent.new(title: "Open tasks", padded: false) do %>
          <div class="divide-y divide-edge"><%= render @tasks %></div>
        <% end %>
      <% end %>

      <% if @events.any? && !@panel&.hidden_browse&.include?(:events) %>
        <%= render Ui::CardComponent.new(title: "Upcoming events", padded: false) do %>
          <div class="divide-y divide-edge"><%= render @events %></div>
        <% end %>
      <% end %>

      <% if @goals.any? %>
        <%= render Ui::CardComponent.new(title: "Goals", padded: false) do %>
          <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2"><%= render @goals %></div>
        <% end %>
      <% end %>

      <% if @documents.any? %>
        <%= render Ui::CardComponent.new(title: "Documents", padded: false) do %>
          <div class="divide-y divide-edge"><%= render @documents %></div>
        <% end %>
      <% end %>

      <% if @people.any? && !@panel&.hidden_browse&.include?(:people) %>
        <%= render Ui::CardComponent.new(title: "People", padded: false) do %>
          <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2"><%= render @people %></div>
        <% end %>
      <% end %>

      <% if @notes.any? %>
        <%= render Ui::CardComponent.new(title: "Notes", padded: false) do %>
          <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2"><%= render @notes %></div>
        <% end %>
      <% end %>

      <% if @photos.any? %>
        <div data-controller="lightbox">
          <%= render Ui::CardComponent.new(title: "Photos") do |card| %>
            <% card.with_actions do %>
              <%= link_to "All #{@photo_count}", photos_path(section: @section.slug), class: "btn btn-ghost btn-sm" %>
            <% end %>
            <div class="grid grid-cols-3 gap-1.5 sm:grid-cols-6">
              <%= render partial: "photos/photo_tile", collection: @photos, as: :photo %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
