<%# The Pets hub lead panel (D-pets-section): the pets and — once there are
    enough of them — their care at a glance. The pet tools live on each pet's
    page; the two only the hub can offer ride the strip. %>
<%= render "sections/pets_strip", pets: panel.pets, remembered: panel.remembered_pets,
      arrival: panel.arrival_tool, lost_pet: panel.lost_pet_tool,
      lost_pet_inputs: panel.lost_pet_tool && panel.tool_inputs(panel.lost_pet_tool) %>

<% if panel.show_care? %>
  <%= render Ui::CardComponent.new(
        title: "Routine care",
        subtitle: "Booked means you can stop thinking about it. Due means it's worth a call this week."
      ) do %>
    <div class="space-y-3">
      <% panel.care.each do |pet, statuses, vaccines| %>
        <div class="flex flex-wrap items-center gap-2">
          <%= link_to pet.name, pet_path(pet), class: "min-w-24 text-sm font-medium text-ink hover:text-primary-700" %>
          <%= render "sections/care_chips", statuses: statuses %>
          <%= render "pets/vaccine_chips", pet: pet, entries: vaccines %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
