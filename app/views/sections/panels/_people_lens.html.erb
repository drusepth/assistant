<%# A group page's lead panel (D-people-circles): who's in it, how to add
    someone, and how to end up in touch with them. Everything else on the
    page — tools, suggestions, the lens lists — is the ordinary D18
    anatomy. %>
<%= render Ui::CardComponent.new(title: "Members", count: panel.members.size, padded: false) do |card| %>
  <% card.with_actions do %>
    <%= link_to "Plan something", new_tool_run_path("get_together", inputs: { who: section.name }), class: "btn btn-ghost" %>
  <% end %>

  <%# Adding leads the card: on a group page it is the main thing to do,
      and on a group that was just made it is the only thing (D-person-picker). %>
  <div class="border-b border-edge p-4">
    <div class="max-w-md">
      <%= render "sections/circle_add_person",
            url: people_memberships_path, section: section,
            label: panel.members.any? ? "Add to #{section.name}" : "Who's in #{section.name}?",
            autofocus: params[:fresh].present? %>
    </div>
  </div>

  <%= render "sections/group_members", members: panel.members, section: section %>
<% end %>
