<%# What counts as this hobby, as words (D-story-matching).
    
    The rule that carries stories out of a broad feed and into the hobby
    they are about, shown as the thing it actually is: a list of words on
    the hobby's own page, with a button to remove each one. A matcher
    nobody can audit is worse than no matcher — that is the whole reason
    this block exists rather than the routing happening silently.

    Locals: panel, section. %>
<%= render Ui::CardComponent.new(
      title: "What counts as #{section.name}",
      subtitle: "Stories from feeds that aren't filed here join this river when they match — " \
                "a word in the headline, or two of them anywhere. The feeds themselves don't move."
    ) do |card| %>
  <% if panel.model? %>
    <% card.with_actions do %>
      <%= button_to panel.watchlist.any_terms? ? "Suggest more" : "Suggest words",
            watchlist_author_path(section_id: section.id),
            class: "reader-filter", form_class: "contents" %>
    <% end %>
  <% end %>

  <div class="space-y-4">
    <% { terms: "Words that mean #{section.name}", negatives: "Never these" }.each do |kind, label| %>
      <% words = panel.watchlist.public_send(kind) %>
      <%# The negatives row is hidden until it has something in it or the
          terms do: an empty list of exceptions to an empty list is a form
          asking a question nobody has yet. %>
      <% next if kind == :negatives && words.empty? && !panel.watchlist.any_terms? %>
      <div>
        <p class="label"><%= label %></p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <% words.each do |word| %>
            <span class="chip bg-stone-100 text-stone-700">
              <%= word %>
              <%= button_to "×", watchlist_terms_path(section_id: section.id, term: word, kind: kind),
                    method: :delete, class: "text-stone-500 hover:text-ink", form_class: "contents",
                    aria: { label: "Remove #{word}" } %>
            </span>
          <% end %>
          <%= form_with url: watchlist_terms_path, class: "flex items-center gap-2" do %>
            <%= hidden_field_tag :section_id, section.id %>
            <%= hidden_field_tag :kind, kind %>
            <%= text_field_tag :term, nil, class: "input h-8 w-40 py-1 text-sm",
                  placeholder: kind == :terms ? "warbler" : "never this word" %>
            <%= submit_tag "Add", class: "btn btn-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# The receipt. A rule that says nothing about what it did is a rule
        nobody can judge. %>
    <% if panel.watchlist.any_terms? %>
      <p class="text-xs text-soft">
        <% if panel.matched_this_week.positive? %>
          <%= pluralize(panel.matched_this_week, "story") %> matched this week.
          Wrong one? “Not this” on the row takes it out and remembers.
        <% else %>
          Nothing matched this week.
        <% end %>
      </p>
    <% end %>

    <% panel.refused.each do |row| %>
      <p class="text-xs text-soft">
        “<%= row["term"] %>” isn't on the list — <%= row["detail"] %>.
      </p>
    <% end %>

    <% panel.suspensions.each do |suspension| %>
      <div class="callout callout-warn text-sm">
        <p>
          <% if suspension.terms.present? %>“<%= suspension.terms %>” matched<% else %>These words matched<% end %>
          almost everything in <%= suspension.feed.display_title %>, so this list is paused for that feed.
          Narrow the words and start it again.
        </p>
        <%= button_to "Watch it again",
              watchlist_resume_path(section_id: section.id, feed_id: suspension.feed.id),
              class: "btn btn-secondary btn-sm mt-2", form_class: "contents" %>
      </div>
    <% end %>
  </div>
<% end %>
