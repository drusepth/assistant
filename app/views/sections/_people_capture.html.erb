<%# The People identity capture (docs/PEOPLE.md §2): the dashboard is about
    the circle — relationships the user chose to tend — not the imported
    roster. Each answer sets keep_in_touch; the Address Book keeps everyone
    else. %>
<%= render Ui::CardComponent.new(
      title: circle.any? ? "Add someone to your circle" : "Who do you want to stay close to?",
      subtitle: "This page is about the relationships you're tending — your full address book stays in the vault."
    ) do %>
  <div class="space-y-3">
    <%= form_with url: people_circle_path, class: "capture-row" do %>
      <% if candidates.any? %>
        <%= select_tag :person_id,
              options_from_collection_for_select(candidates, :id, :name),
              include_blank: "Choose from your address book…", class: "input sm:max-w-60" %>
      <% end %>
      <%= text_field_tag :name, nil, class: "input sm:max-w-60",
            placeholder: candidates.any? ? "…or add someone new" : "Name someone…" %>
      <%= submit_tag "Add", class: "btn btn-primary" %>
    <% end %>
    <% if candidates.none? && circle.none? %>
      <p class="hint">
        Or <%= link_to "import your address book", new_people_import_path, class: "text-primary-700 hover:underline" %>
        and pick from it here.
      </p>
    <% end %>
  </div>
<% end %>
