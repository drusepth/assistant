<%# The pets on the Pets hub (D-pets-section), in the same card language as
    the circle and the groups on the People page. Her vet visit is still
    Health + her name, and both pages are right.

    A household with no pets sees one dashed tile and nothing else. %>
<%# No "Your pets" label: the page is titled Pets. %>
<div>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <% pets.each do |card| %>
      <%= link_to card.path, class: "card group flex items-center gap-3 border-edge p-4 transition hover:border-primary-300 hover:shadow-sm" do %>
        <%= render Ui::AvatarComponent.new(person: card.pet, size: :md, tone: :sage) %>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-ink group-hover:text-primary-700"><%= card.name %></p>
          <p class="mt-0.5 text-xs text-soft"><%= card.signal %></p>
        </div>
      <% end %>
    <% end %>

    <%# The arrival tool sits under the tile it belongs to: getting ready for a
        pet and adding one are the same moment. %>
    <div class="flex min-h-20 flex-col items-center justify-center gap-1 rounded-xl border border-dashed border-edge p-4 text-center transition hover:border-primary-300">
      <%= link_to "+ Add a pet", new_pet_path, class: "text-sm font-medium text-soft hover:text-primary-700" %>
      <% if local_assigns[:arrival] %>
        <%= link_to "Bringing one home soon? Get ready →", new_tool_run_path(arrival.slug), class: "text-xs text-soft hover:text-primary-700" %>
      <% end %>
    </div>
  </div>

  <% if local_assigns[:lost_pet] %>
    <p class="mt-3 text-sm">
      <%= link_to "#{pets.one? ? "#{pets.first.name} is" : "A pet is"} missing →",
            new_tool_run_path(lost_pet.slug, inputs: lost_pet_inputs.presence),
            class: "font-medium text-primary-800 hover:underline" %>
    </p>
  <% end %>

  <% if remembered.any? %>
    <%# Quiet, at the foot, and never a prompt to do anything. %>
    <div class="mt-4">
      <h3 class="mb-2 text-xs font-medium text-soft">Remembered</h3>
      <div class="flex flex-wrap gap-2">
        <% remembered.each do |card| %>
          <%= link_to card.path, class: "chip inline-flex items-center gap-2 bg-stone-100 py-1 pr-3 pl-1 text-stone-600 hover:text-stone-800" do %>
            <%= render Ui::AvatarComponent.new(person: card.pet, size: :xs, tone: :stone) %>
            <span><%= card.name %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
