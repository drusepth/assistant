<%# One tool, generated from its registry metadata: title, description,
    inputs with their labels and hints, and the kind that says what comes
    back. Prose is optional and per-tool (docs/ABOUT_PLAN.md §3) — writing
    one flagship page does not strand the other fifty. %>
<% content_for :title, @tool.title %>
<% content_for :description, @tool.description %>

<header class="max-w-3xl">
  <p class="mb-3 text-sm">
    <%= link_to "← Everything it does", about_tools_path, class: "text-primary-700 hover:underline" %>
  </p>
  <h1 class="display text-3xl sm:text-4xl"><%= @tool.title %></h1>
  <p class="mt-4 text-lg text-soft"><%= @tool.description %></p>
</header>

<% if @prose %>
  <div class="mt-10 max-w-3xl"><%= render @prose %></div>
<% end %>

<div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%= render Ui::CardComponent.new(title: "What it asks you for") do %>
    <% if @tool.inputs.any? %>
      <dl class="space-y-4">
        <% @tool.inputs.each do |input| %>
          <div>
            <dt class="text-sm font-semibold">
              <%= input.label %><%= tag.span " · optional", class: "font-normal text-soft" unless input.required? %>
            </dt>
            <% if input.hint.present? %>
              <dd class="mt-0.5 text-sm text-soft"><%= input.hint %></dd>
            <% end %>
          </div>
        <% end %>
      </dl>
      <p class="mt-5 border-t border-edge pt-4 text-sm text-soft">
        That's the whole form. Anything else it needs — who your people are,
        what's in your documents, what you've already told it — it reads from
        what you've filed rather than asking twice.
      </p>
    <% else %>
      <p class="text-sm text-soft">Nothing. It works from what you've already filed.</p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "What you get back") do %>
    <%= render "about/tools/outcome", tool: @tool %>
  <% end %>
</div>

<% if @hubs.any? %>
  <section class="mt-12">
    <h2 class="display text-xl">Where it lives</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @hubs.each do |hub| %>
        <%= link_to hub.title, about_hub_path(hub), class: "chip bg-surface text-soft hover:text-ink" %>
      <% end %>
    </div>
  </section>
<% end %>

<p class="mt-12 text-sm text-soft">
  Like everything here, this runs on the model you configured, on your own
  machine. Nothing you type into it leaves the house —
  <%= link_to "how that works", about_page_path("privacy"), class: "text-primary-700 hover:underline" %>.
</p>
