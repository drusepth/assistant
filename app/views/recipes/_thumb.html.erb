<%# The one place a recipe's picture is decided (dish photo, or a warm
    monogram tile) — shared by the library, books, and the public pages. %>
<% variant = local_assigns[:variant] || :card %>
<div class="aspect-[4/3] overflow-hidden bg-stone-100">
  <% if recipe.image.attached? %>
    <%= image_tag url_for(recipe.image.variant(variant)), alt: recipe.title, loading: "lazy",
          class: "size-full object-cover transition-transform duration-150 group-hover:scale-105" %>
  <% else %>
    <div class="flex size-full items-center justify-center <%= recipe_tile_classes(recipe) %>">
      <span class="font-display text-3xl tracking-tight"><%= recipe_monogram(recipe) %></span>
    </div>
  <% end %>
</div>
