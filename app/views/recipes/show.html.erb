<% scale_path = ->(count) { recipe_path(@recipe, servings: count) } %>
<%= turbo_stream_from Current.user, :recipes if @owned %>

<%= render Ui::PageHeaderComponent.new(title: @recipe.title) do |header| %>
  <% unless @owned %>
    <% header.with_meta do %>
      <%= render Ui::UserLabelComponent.new(user: @recipe.user) do %>
        shared by <%= @recipe.user.name %>
      <% end %>
    <% end %>
  <% end %>
  <% header.with_actions do %>
    <button type="button" class="btn btn-secondary print:hidden"
            data-controller="print" data-action="print#now">Print</button>
    <% if @owned %>
      <%= button_to "Cooked it", cook_recipe_path(@recipe), method: :post, class: "btn btn-secondary" %>
      <%= link_to "Edit", edit_recipe_path(@recipe), class: "btn btn-secondary" %>
      <%= button_to "Delete", @recipe, method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete this recipe? Any books it's in keep their other recipes." } %>
    <% end %>
  <% end %>
<% end %>

<% if @owned && @recipe.import_status.present? %>
  <div class="card mb-6 flex flex-wrap items-center justify-between gap-3 p-4 print:hidden">
    <% if @recipe.importing? %>
      <p class="text-sm text-soft">Reading it<span class="animate-pulse">…</span> this page updates itself when it's done.</p>
    <% elsif @recipe.import_failed? %>
      <p class="min-w-0 text-sm text-ink">
        <span class="font-semibold">That import didn't work.</span>
        <span class="text-soft"><%= @recipe.import_error %></span>
      </p>
      <div class="row-actions">
        <%= button_to "Try again", retry_import_recipe_path(@recipe), method: :post, class: "btn btn-secondary btn-sm" %>
        <%= link_to "Fill it in myself", edit_recipe_path(@recipe), class: "btn btn-ghost btn-sm" %>
      </div>
    <% else %>
      <p class="min-w-0 text-sm text-ink">
        <span class="font-semibold">Imported — give it a read.</span>
        <span class="text-soft">Amounts came from the page; check them before you cook from it.</span>
      </p>
      <div class="row-actions">
        <%= button_to "Looks right", confirm_import_recipe_path(@recipe), method: :post, class: "btn btn-secondary btn-sm" %>
        <%= link_to "Edit", edit_recipe_path(@recipe), class: "btn btn-ghost btn-sm" %>
      </div>
    <% end %>
  </div>
<% end %>

<%# The facts a cook wants before starting, on one line under the title —
    they used to be a card in the rail, which put the admin furniture above
    the food. %>
<div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-soft">
  <% if @recipe.servings %><span>Serves <%= @recipe.servings %></span><% end %>
  <% if @recipe.timing.present? %>
    <span aria-hidden="true">·</span><span><%= @recipe.timing %></span>
  <% end %>
  <% if @recipe.source_name.present? || @recipe.source_url.present? %>
    <span aria-hidden="true">·</span>
    <span>
      From
      <% if (source = recipe_source_url(@recipe)) %>
        <%= link_to recipe_source_label(@recipe, source), source, class: "text-primary-700 underline",
              rel: "noopener noreferrer nofollow", target: "_blank" %>
      <% else %>
        <%= @recipe.source_name %>
      <% end %>
    </span>
  <% end %>
  <% if @recipe.times_cooked.positive? %>
    <span aria-hidden="true">·</span>
    <span title="<%= "Last cooked #{l(@recipe.last_cooked_on, format: :long)}" if @recipe.last_cooked_on %>">
      Cooked <%= pluralize(@recipe.times_cooked, "time") %>
    </span>
  <% end %>
  <% if @recipe.sections.any? %>
    <span class="flex flex-wrap items-center gap-1.5"><%= render "shared/item_chips", item: @recipe %></span>
  <% end %>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <% if @recipe.image.attached? %>
      <%# Capped: a 4:3 hero at full width pushes the actual recipe below
          the fold on a laptop, and off the first page in print. %>
      <%= image_tag url_for(@recipe.image.variant(:hero)), alt: @recipe.title,
            class: "max-h-80 w-full rounded-2xl object-cover print:max-h-48" %>
    <% end %>

    <% if @recipe.description.present? %>
      <p class="max-w-2xl text-sm text-soft"><%= @recipe.description %></p>
    <% end %>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-5">
      <div class="sm:col-span-2">
        <%= render Ui::CardComponent.new(title: "Ingredients") do %>
          <%= render "recipes/ingredients", recipe: @recipe, servings: @servings, factor: @factor,
                scale_path: scale_path, have: @kitchen_have %>
          <%= render "recipes/kitchen", recipe: @recipe, servings: @servings, kitchen: @kitchen,
                kitchen_split: [ @kitchen_have, @kitchen_need ], kitchen_stocked: @kitchen_stocked %>
        <% end %>
      </div>
      <div class="sm:col-span-3">
        <%= render Ui::CardComponent.new(title: "Method") do %>
          <%= render "recipes/method", recipe: @recipe %>
        <% end %>
      </div>
    </div>

    <% if @recipe.notes.present? %>
      <%= render Ui::CardComponent.new(title: "Notes") do %>
        <p class="whitespace-pre-wrap text-sm text-ink"><%= @recipe.notes %></p>
      <% end %>
    <% end %>
  </div>

  <%# Everything below is the owner's furniture: it never prints, and it
      sits after the food on a phone. %>
  <div class="space-y-6 print:hidden">
    <% if @owned %>
      <%= render Ui::CardComponent.new(title: "Photo",
            subtitle: @recipe.image.attached? ? "Swap it for another" : "What it looks like") do %>
        <%= form_with model: @recipe, class: "space-y-2" do |form| %>
          <%= form.file_field :image, accept: "image/*" %>
          <%= form.submit "Upload", class: "btn btn-secondary btn-sm" %>
        <% end %>

        <% if @recent_photos&.any? %>
          <details class="mt-3">
            <summary class="cursor-pointer text-xs text-primary-700 hover:underline">Use one from Photos</summary>
            <div class="mt-2 grid grid-cols-4 gap-1.5">
              <% @recent_photos.each do |photo| %>
                <%= button_to attach_photo_recipe_path(@recipe, photo_id: photo.id), method: :post,
                      class: "block aspect-square overflow-hidden rounded-lg", form: { class: "contents" } do %>
                  <%= image_tag url_for(photo.image.variant(:thumb)), alt: photo.display_title,
                        class: "size-full cursor-pointer object-cover hover:opacity-80" %>
                <% end %>
              <% end %>
            </div>
            <p class="hint mt-1">Picks the same file, not a copy of it.</p>
          </details>
        <% end %>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new(title: "Books", subtitle: "Where this recipe is filed") do %>
      <% if @books.any? %>
        <ul class="mb-4 space-y-2">
          <% @books.each do |book| %>
            <li class="flex items-center justify-between gap-2 text-sm">
              <%= link_to book.title, book, class: "min-w-0 truncate text-ink hover:underline" %>
              <% if @owned && book.user_id == Current.user.id %>
                <%= button_to "Remove", remove_from_book_recipe_path(@recipe, recipe_book_id: book.id),
                      method: :delete, class: "btn btn-ghost btn-sm" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @owned %>
        <% if @available_books&.any? %>
          <%= form_with url: add_to_book_recipe_path(@recipe), class: "capture-row" do %>
            <%= select_tag :recipe_book_id, options_from_collection_for_select(@available_books, :id, :title),
                  class: "input min-w-0 flex-1" %>
            <%= submit_tag "Add", class: "btn btn-secondary" %>
          <% end %>
        <% else %>
          <p class="text-sm text-soft">
            <%= @books.any? ? "In every book you have." : "No books yet." %>
            <%= link_to "Make one", new_recipe_book_path, class: "text-primary-700 underline" %>.
          </p>
        <% end %>
      <% end %>
    <% end %>

    <% if @owned %>
      <%= render "shared/share_controls", subject: @recipe %>
      <%= render "share_links/card", subject: @recipe, links: @share_links, noun: "recipe",
            detail: "Anyone with the link can read this recipe — the method, the ingredients, "\
                    "your notes, and your first name. They can't see anything else here, and "\
                    "revoking cuts them off." %>
    <% end %>
  </div>
</div>
