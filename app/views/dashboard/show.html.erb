<div data-controller="quick-add" data-action="keydown.esc@window->quick-add#closeAll click@window->quick-add#clickOutside">
  <%# The hero absorbs the page header: the household's name is the title of
      its own dashboard, and the quick-add row rides along inside it. %>
  <%= render "hero", hero: @hero, quick_task: @quick_task, quick_note: @quick_note,
        quick_event: @quick_event, quick_goal: @quick_goal %>
</div>

<% attention_count = @overdue_tasks.size + @due_today_tasks.size %>
<%# The attention strip: a solid accent disc, the headline count, each kind
    of pressure as its own tinted badge, then the way through to Today. %>
<div class="card mb-6 px-5 py-4">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="size-8 shrink-0 rounded-full bg-primary-600"></span>
    <% if attention_count.positive? %>
      <p class="font-semibold text-ink">
        <%= pluralize(attention_count, "thing") %> need<%= "s" if attention_count == 1 %> attention
      </p>
      <% if @overdue_tasks.any? %>
        <span class="chip bg-primary-200 font-bold text-primary-800"><%= @overdue_tasks.size %> overdue</span>
      <% end %>
      <% if @due_today_tasks.any? %>
        <span class="chip bg-sage-200 font-bold text-sage-700"><%= @due_today_tasks.size %> due today</span>
      <% end %>
      <%= link_to "Open Today →", today_path,
            class: "ml-auto text-sm font-semibold text-primary-800 hover:text-primary-900" %>
    <% else %>
      <p class="font-semibold text-ink">All clear — nothing overdue, nothing due today.</p>
    <% end %>
  </div>
  <% if Current.user.digest.present? && Current.user.digest_generated_at&.after?(8.days.ago) %>
    <p class="mt-2 text-sm text-ink/90"><%= Current.user.digest %></p>
    <p class="mt-1 text-xs text-soft">Your assistant's weekly read — phrased by AI from the locally-computed facts above, refreshed each scan.</p>
  <% else %>
    <p class="mt-1 text-xs text-soft">This summary is computed locally; your assistant's phrased weekly digest appears after the first weekly scan.</p>
  <% end %>
</div>

<% if @suggestions.any? %>
  <div class="mb-6">
    <%= render Ui::CardComponent.new(title: "From your assistant",
          subtitle: "Suggestions from a weekly look at your own data — accept, snooze, or dismiss", padded: false) do %>
      <div class="divide-y divide-edge"><%= render @suggestions %></div>
    <% end %>
  </div>
<% end %>

<%# The daily mail digest (EMAIL_PLAN.md §7): deterministic selection,
    optional phrased line, feedback buttons teaching sender rules.
    Renders nothing on a quiet day — silence is a feature. %>
<% digest = Current.user.mail_digest %>
<% if digest.present? && Array(digest["items"]).any? && digest["date"] == Date.current.iso8601 %>
  <div class="mb-6">
    <%= render Ui::CardComponent.new(title: "Mail",
          subtitle: "Today's mail worth a look — from your linked #{"mailbox".pluralize(Current.user.linked_accounts.where(provider: "email").count)}", padded: false) do %>
      <% if digest["phrased"].present? %>
        <p class="border-b border-edge px-5 py-3 text-sm text-ink/90"><%= digest["phrased"] %></p>
      <% end %>
      <div class="divide-y divide-edge">
        <% Array(digest["items"]).each do |item| %>
          <div class="flex flex-wrap items-center gap-2 px-5 py-2.5 text-sm">
            <%= link_to mail_path(item["id"]), class: "min-w-0 flex-1 basis-full sm:basis-0" do %>
              <span class="font-medium text-ink"><%= item["from"] %></span>
              <span class="text-soft">— <%= item["subject"] %></span>
              <% if item["deadline_on"] %><span class="chip bg-primary-200 text-primary-800">deadline <%= item["deadline_on"] %></span><% end %>
            <% end %>
            <span class="row-actions">
              <%= button_to "More like this", email_sender_rules_path(email: item["from_email"], rule: "vip"),
                    method: :post, class: "btn btn-ghost btn-sm", title: "Always treat mail from this sender as important" %>
              <%= button_to "Not important", email_sender_rules_path(email: item["from_email"], rule: "mute"),
                    method: :post, class: "btn btn-ghost btn-sm", title: "Stop surfacing mail from this sender" %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <%= render Ui::CardComponent.new(title: "Needs attention", padded: false) do |card| %>
    <% card.with_actions { link_to "Today view", today_path, class: "btn btn-ghost btn-sm" } %>
    <% needing = @overdue_tasks + @due_today_tasks %>
    <% if needing.any? %>
      <div class="divide-y divide-edge"><%= render partial: "tasks/task", collection: needing %></div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">Nothing needs attention right now.</p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Next 7 days", padded: false) do |card| %>
    <% card.with_actions { link_to "Calendar", calendar_path, class: "btn btn-ghost btn-sm" } %>
    <% if @upcoming_events.any? %>
      <div class="divide-y divide-edge"><%= render @upcoming_events %></div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">No upcoming events this week.</p>
    <% end %>
  <% end %>
</div>

<%# The hub board: every enabled life area as a doorway to its section page.
    Busy areas go wide and list rows, quiet ones stay narrow — so the board
    is a map of where the pressure actually is this week. %>
<% if @board.cards.any? %>
  <section class="mt-6">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h2 class="text-xs font-bold uppercase tracking-[0.12em] text-stone-600">Your life</h2>
      <%= link_to "Settings", settings_path, class: "text-xs text-soft hover:text-ink" %>
    </div>
    <%# auto-rows-fr keeps a narrow "Clear" card the same height as the wide
        card beside it, so the board reads as a grid rather than a collage. %>
    <div class="grid grid-cols-1 auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <%= render partial: "board_card", collection: @board.sorted_cards, as: :board_card %>
    </div>
  </section>
<% end %>

<%= render "runtime" %>

