<div data-controller="quick-add" data-action="keydown.esc->quick-add#closeAll">
  <%= render Ui::PageHeaderComponent.new(title: "Dashboard", subtitle: Date.current.strftime("%A, %B %-d")) do |header| %>
    <% header.with_actions do %>
      <% [ [ "task", "Task", "btn-secondary" ], [ "note", "Note", "btn-secondary" ],
           [ "event", "Event", "btn-secondary" ], [ "goal", "Goal", "btn-primary" ] ].each do |name, label, style| %>
        <%= tag.button type: "button", class: "btn #{style}", aria: { expanded: false },
              data: { quick_add_target: "button", action: "quick-add#toggle", quick_add_name_param: name } do %>
          <%= icon(:plus, css_class: "size-4") %> <%= label %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% [ [ "task", "New task", render("tasks/quick_form", task: @quick_task, return_to: root_path, autofocus: false) ],
       [ "note", "New note", render("notes/quick_form", note: @quick_note, return_to: root_path, autofocus: false) ],
       [ "event", "New event", render("events/quick_form", event: @quick_event, return_to: root_path, autofocus: false) ],
       [ "goal", "New goal", render("goals/quick_form", goal: @quick_goal, return_to: root_path, autofocus: false) ] ].each do |name, title, form| %>
    <div class="mb-6 hidden max-w-xl card p-5" data-quick-add-target="panel" data-name="<%= name %>">
      <h2 class="mb-3 text-sm font-semibold text-ink"><%= title %></h2>
      <%= form %>
    </div>
  <% end %>
</div>

<% attention_count = @overdue_tasks.size + @due_today_tasks.size %>
<div class="mb-6 rounded-xl border border-primary-200 bg-primary-50 px-5 py-4">
  <% if attention_count.positive? %>
    <p class="text-sm font-medium text-primary-900">
      <%= pluralize(attention_count, "thing") %> need<%= "s" if attention_count == 1 %> attention:
      <% parts = [] %>
      <% parts << pluralize(@overdue_tasks.size, "overdue task") if @overdue_tasks.any? %>
      <% parts << pluralize(@due_today_tasks.size, "task") + " due today" if @due_today_tasks.any? %>
      <%= parts.join(" and ") %>.
    </p>
  <% else %>
    <p class="text-sm font-medium text-primary-900">All clear — nothing overdue, nothing due today.</p>
  <% end %>
  <% if Current.user.digest.present? && Current.user.digest_generated_at&.after?(8.days.ago) %>
    <p class="mt-2 text-sm text-primary-900/90"><%= Current.user.digest %></p>
    <p class="mt-1 text-xs text-primary-800/70">Your assistant's weekly read — phrased by AI from the locally-computed facts above, refreshed each scan.</p>
  <% else %>
    <p class="mt-1 text-xs text-primary-800/70">This summary is computed locally; your assistant's phrased weekly digest appears after the first weekly scan.</p>
  <% end %>
</div>

<% if @suggestions.any? %>
  <div class="mb-6">
    <%= render Ui::CardComponent.new(title: "From your assistant",
          subtitle: "Suggestions from a weekly look at your own data — accept, snooze, or dismiss", padded: false) do %>
      <div class="divide-y divide-edge"><%= render @suggestions %></div>
    <% end %>
  </div>
<% end %>

<%# The daily mail digest (EMAIL_PLAN.md §7): deterministic selection,
    optional phrased line, feedback buttons teaching sender rules.
    Renders nothing on a quiet day — silence is a feature. %>
<% digest = Current.user.mail_digest %>
<% if digest.present? && Array(digest["items"]).any? && digest["date"] == Date.current.iso8601 %>
  <div class="mb-6">
    <%= render Ui::CardComponent.new(title: "Mail",
          subtitle: "Today's mail worth a look — from your linked #{"mailbox".pluralize(Current.user.linked_accounts.where(provider: "email").count)}", padded: false) do %>
      <% if digest["phrased"].present? %>
        <p class="border-b border-edge px-5 py-3 text-sm text-primary-900/90"><%= digest["phrased"] %></p>
      <% end %>
      <div class="divide-y divide-edge">
        <% Array(digest["items"]).each do |item| %>
          <div class="flex flex-wrap items-center gap-2 px-5 py-2.5 text-sm">
            <%= link_to mail_path(item["id"]), class: "min-w-0 flex-1" do %>
              <span class="font-medium text-ink"><%= item["from"] %></span>
              <span class="text-soft">— <%= item["subject"] %></span>
              <% if item["deadline_on"] %><span class="chip bg-amber-100 text-amber-800">deadline <%= item["deadline_on"] %></span><% end %>
            <% end %>
            <span class="flex shrink-0 items-center gap-1">
              <%= button_to "More like this", email_sender_rules_path(email: item["from_email"], rule: "vip"),
                    method: :post, class: "btn btn-ghost btn-sm", title: "Always treat mail from this sender as important" %>
              <%= button_to "Not important", email_sender_rules_path(email: item["from_email"], rule: "mute"),
                    method: :post, class: "btn btn-ghost btn-sm", title: "Stop surfacing mail from this sender" %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <%= render Ui::CardComponent.new(title: "Needs attention", padded: false) do |card| %>
    <% card.with_actions { link_to "Today view", today_path, class: "btn btn-ghost btn-sm" } %>
    <% needing = @overdue_tasks + @due_today_tasks %>
    <% if needing.any? %>
      <div class="divide-y divide-edge"><%= render partial: "tasks/task", collection: needing %></div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">Nothing needs attention right now.</p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Next 7 days", padded: false) do |card| %>
    <% card.with_actions { link_to "Calendar", calendar_path, class: "btn btn-ghost btn-sm" } %>
    <% if @upcoming_events.any? %>
      <div class="divide-y divide-edge"><%= render @upcoming_events %></div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">No upcoming events this week.</p>
    <% end %>
  <% end %>
</div>
