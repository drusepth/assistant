<%= render Ui::PageHeaderComponent.new(title: "Passwords", subtitle: "Your household's vault — sealed with your own password") do |header| %>
  <% header.with_actions do %>
    <% if vault_unlocked? %>
      <%= button_to "Lock", lock_credentials_path, method: :post, class: "btn btn-ghost" %>
    <% end %>
    <%= link_to "Add a password", new_credential_path, class: "btn btn-primary" %>
  <% end %>
<% end %>

<% if @keyring.nil? %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    Your vault initializes the next time you sign in — sign out and back in once to get started.
  </div>
<% elsif !vault_unlocked? %>
  <div class="mb-4 rounded-lg border border-edge bg-surface p-4">
    <p class="mb-2 text-sm font-medium text-ink">Vault locked — names are visible, secrets are sealed.</p>
    <%= form_with url: unlock_credentials_path, class: "flex flex-wrap items-center gap-2" do |form| %>
      <%= form.password_field :password, placeholder: "Your account password", autocomplete: "current-password",
            class: "input max-w-xs", required: true %>
      <%= form.submit "Unlock" %>
    <% end %>
  </div>
<% elsif @keyring.recovery_pending? %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-200 bg-amber-50 p-4">
    <p class="text-sm text-amber-900">
      <span class="font-medium">No recovery kit saved.</span>
      If you ever reset your password without one, these secrets are gone for good.
    </p>
    <%# turbo: false — #recovery renders the kit instead of redirecting (the code
        exists only in that response body), and Turbo drops any non-redirect 200
        it gets back from a form, so the button would do nothing at all. %>
    <%= button_to "Generate recovery kit", recovery_credentials_path, method: :post,
          class: "btn btn-secondary btn-sm", form: { data: { turbo: false } } %>
  </div>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-2">
  <%= form_with url: credentials_path, method: :get, class: "flex-1 min-w-48" do |form| %>
    <%= form.hidden_field :kind, value: @kind if @kind %>
    <%= form.search_field :q, value: @query, placeholder: "Search your vault…", autofocus: @credentials.any?,
          class: "input w-full" %>
  <% end %>
  <div class="flex flex-wrap gap-1.5">
    <%= link_to "All", credentials_path(q: @query.presence),
          class: "chip #{@kind.nil? ? "bg-primary-100 text-primary-800" : "bg-stone-100 text-stone-700"}" %>
    <% Credential::KINDS.each do |kind, settings| %>
      <%= link_to settings[:label].pluralize, credentials_path(kind: kind, q: @query.presence),
            class: "chip #{@kind == kind ? "bg-primary-100 text-primary-800" : "bg-stone-100 text-stone-700"}" %>
    <% end %>
  </div>
</div>

<% if @credentials.any? %>
  <% if @credentials.any?(&:totp_present) %>
    <p class="mb-3 hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"
       data-controller="clock-drift" data-clock-drift-server-time-value="<%= Time.current.to_i %>"></p>
  <% end %>
  <div class="card divide-y divide-edge">
    <%= render partial: "credential", collection: @credentials %>
  </div>
<% elsif @query.present? || @kind %>
  <p class="py-8 text-center text-sm text-soft">Nothing matches.</p>
<% else %>
  <%= render Ui::EmptyStateComponent.new(
        title: "Your vault is empty",
        description: "Store the household's passwords here instead of renting a manager — private to you until you share, sealed with your own password."
      ) do |empty| %>
    <% empty.with_action do %>
      <div class="flex flex-wrap justify-center gap-2">
        <%= link_to "Coming from another password manager?", import_credentials_path, class: "btn btn-secondary" %>
        <%= link_to "Add a password", new_credential_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <%= render Ui::CardComponent.new(title: "Vault tools") do %>
    <div class="space-y-3 text-sm">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Import from another manager", import_credentials_path, class: "btn btn-secondary btn-sm" %>
        <% if vault_unlocked? %>
          <%= link_to "Password health", health_credentials_path, class: "btn btn-secondary btn-sm" %>
          <%= button_to @keyring&.recovery_pending? ? "Generate recovery kit" : "Regenerate recovery kit",
                recovery_credentials_path, method: :post, class: "btn btn-secondary btn-sm",
                form: { data: { turbo: false } } %>
        <% end %>
      </div>
      <% if vault_unlocked? %>
        <%# Same reason: #export answers with the CSV itself, not a redirect, and a
            Turbo-driven submit would swallow it instead of saving the file. %>
        <%= form_with url: export_credentials_path, data: { turbo: false },
              class: "flex flex-wrap items-center gap-2 border-t border-edge pt-3" do |form| %>
          <span class="text-soft">Download my passwords (CSV):</span>
          <%= form.password_field :password, placeholder: "Confirm with your password", autocomplete: "current-password",
                class: "input max-w-56", required: true %>
          <%= form.submit "Download", class: "btn btn-secondary btn-sm" %>
        <% end %>
      <% else %>
        <p class="text-xs text-soft">Unlock to check password health, manage your recovery kit, or export.</p>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Emergency access",
        subtitle: "If something happens to you, a chosen household member can request your vault — you get the waiting period to say no") do %>
    <div class="space-y-3 text-sm">
      <% @emergency_contacts.each do |contact| %>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
            <%= render Ui::UserLabelComponent.new(user: contact.contact_user, css_class: "font-medium text-ink") %>
            <span class="text-soft">· <%= contact.wait_days %>-day wait</span>
            <% if contact.requested? %>
              <span class="chip bg-amber-100 text-amber-800">requested <%= contact.requested_at.to_date %></span>
            <% end %>
          </span>
          <span class="flex gap-2">
            <% if contact.requested? %>
              <%= button_to "Deny", deny_emergency_contact_path(contact), method: :post, class: "btn btn-danger btn-sm" %>
            <% end %>
            <%= button_to "Revoke", emergency_contact_path(contact), method: :delete, class: "btn btn-ghost btn-sm" %>
          </span>
        </div>
      <% end %>

      <% eligible = Current.user.household.users.where.not(id: [ Current.user.id ] + @emergency_contacts.map(&:contact_user_id)).select { |u| u.keyring.present? } %>
      <% if vault_unlocked? && eligible.any? %>
        <%= form_with url: emergency_contacts_path, class: "flex flex-wrap items-center gap-2 #{"border-t border-edge pt-3" if @emergency_contacts.any?}" do |form| %>
          <%= select_tag :contact_user_id, options_from_collection_for_select(eligible, :id, :name), class: "input w-auto" %>
          <%= select_tag :wait_days, options_for_select([ [ "3-day wait", 3 ], [ "7-day wait", 7 ], [ "14-day wait", 14 ], [ "30-day wait", 30 ] ], 7), class: "input w-auto" %>
          <%= form.submit "Add emergency contact", class: "btn btn-secondary btn-sm" %>
        <% end %>
        <p class="text-xs text-soft">
          The wait is enforced by this app, not by cryptography — whoever runs the server plus your contact could
          bypass it together. Off by default; your visible choice.
        </p>
      <% elsif @emergency_contacts.none? %>
        <p class="text-soft"><%= vault_unlocked? ? "No other members with vaults yet — they need to sign in once first." : "Unlock your vault to set this up." %></p>
      <% end %>

      <% if @recent_events.any? %>
        <div class="space-y-2 border-t border-edge pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-stone-400">Vault activity</p>
          <ul class="space-y-1.5">
            <% @recent_events.each do |event| %>
              <li class="flex items-baseline justify-between gap-2 text-xs <%= event.alarming? ? "text-amber-900" : "text-soft" %>">
                <span>
                  <%= event.describe %>
                  <% if event.credential %>
                    — <%= link_to event.credential.name, credential_path(event.credential), class: "underline" %>
                  <% end %>
                </span>
                <span class="shrink-0"><%= event.created_at.to_date %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @emergency_roles.any? %>
        <div class="space-y-2 border-t border-edge pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-stone-400">You're a contact for</p>
          <% @emergency_roles.each do |role| %>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <%= render Ui::UserLabelComponent.new(user: role.user, css_class: "font-medium text-ink", truncate: true) %>
              <% if role.releasable? %>
                <%= link_to "Open their vault", access_emergency_contact_path(role), class: "btn btn-danger btn-sm" %>
              <% elsif role.requested? %>
                <span class="text-soft">opens <%= (role.requested_at + role.wait_days.days).to_date %> unless denied</span>
              <% else %>
                <%= button_to "Request emergency access", request_access_emergency_contact_path(role), method: :post,
                      class: "btn btn-secondary btn-sm",
                      data: { turbo_confirm: "#{role.user.name} will be notified and can deny for #{role.wait_days} days. Continue?" } %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
