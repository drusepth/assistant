<%= render Ui::PageHeaderComponent.new(title: "Import passwords",
      subtitle: "Bring your vault over from Bitwarden, LastPass, 1Password, Chrome, or Firefox") %>

<div class="max-w-xl space-y-4">
  <%= form_with url: import_credentials_path, multipart: true, class: "card space-y-4 p-5" do |form| %>
    <%= form.file_field :file, accept: ".csv" %>
    <p class="text-xs text-soft">
      Export a CSV from your old manager (usually Settings → Export), drop it here, then delete that file —
      it holds your passwords in plain text. Duplicates are skipped automatically.
    </p>
    <%= form.submit "Import" %>
  <% end %>

  <div class="rounded-lg border border-edge bg-stone-50 p-4 text-xs text-soft">
    <p class="mb-1 font-medium text-ink">Where the export lives</p>
    <p>Bitwarden: Tools → Export vault (CSV). LastPass: Advanced Options → Export. 1Password: File → Export (CSV).
       Chrome: Passwords → Settings → Export. Firefox: about:logins → ⋯ → Export.</p>
  </div>
</div>
