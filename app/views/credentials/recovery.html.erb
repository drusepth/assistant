<%# The once-only display (D-vault-crypto §4.2): the code exists in
    plaintext here and nowhere else — no-store headers, nothing persisted
    but the wrap. %>
<%= render Ui::PageHeaderComponent.new(title: "Your recovery kit",
      subtitle: "The one way back into your vault if you ever reset your password") %>

<div class="max-w-xl space-y-4">
  <div class="card space-y-4 p-6 text-center" data-controller="clipboard" data-clipboard-text-value="<%= @code %>">
    <p class="text-sm text-soft">Write this down and keep it off this machine. It will not be shown again.</p>
    <p class="select-all font-mono text-2xl tracking-wider text-ink"><%= @code %></p>
    <button type="button" class="btn btn-secondary btn-sm" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
  </div>

  <div class="rounded-lg border border-edge bg-stone-50 p-4 text-sm text-soft">
    <p class="mb-1 font-medium text-ink">Where to keep it</p>
    <p>Anywhere that isn't this server: a printed page in the fire box, a note in another password manager,
       an envelope with your documents. Anyone holding it (plus this server's disk) can read your vault.</p>
  </div>

  <%= button_to "I saved it — done", recovery_confirm_credentials_path, method: :post, class: "btn btn-primary w-full" %>
</div>
