<%# Secrets never render here — copy buttons fetch them per-click (no-store JSON). %>
<div class="flex items-center gap-3 p-3">
  <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-sm font-semibold text-primary-700">
    <%= credential.name.first.upcase %>
  </div>
  <div class="min-w-0 flex-1">
    <%= link_to credential.name, credential_path(credential), class: "block truncate text-sm font-medium text-ink hover:underline" %>
    <p class="truncate text-xs text-soft">
      <%= credential.username.presence || credential.kind_settings[:label] %>
      <% if credential.user_id != Current.user.id %> · shared by <%= credential.user.name %><% end %>
    </p>
  </div>
  <div class="flex shrink-0 items-center gap-1.5"
       data-controller="secret" data-secret-url-value="<%= reveal_credential_path(credential) %>">
    <% if credential.username.present? %>
      <button type="button" class="btn btn-ghost btn-sm" title="Copy username"
              data-action="secret#copyText" data-secret-text-param="<%= credential.username %>">user</button>
    <% end %>
    <% if credential.kind != "note" %>
      <button type="button" class="btn btn-ghost btn-sm" title="Copy <%= credential.kind == "card" ? "card number" : "password" %>"
              data-action="secret#copy" data-secret-field-param="<%= credential.kind == "card" ? "number" : "password" %>">
        <%= credential.kind == "card" ? "number" : "pass" %>
      </button>
    <% end %>
    <% if credential.totp_present %>
      <button type="button" class="btn btn-ghost btn-sm font-mono" title="Copy one-time code"
              data-action="secret#totp">2FA</button>
    <% end %>
  </div>
</div>
