<%= render Ui::PageHeaderComponent.new(title: "Edit #{@credential.name}") %>
<div class="max-w-xl">
  <% if vault_unlocked? && @credential.secret_lost_for?(Current.user) %>
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
      Re-entering the sealed fields below restores this entry — the old secret was lost in a password reset.
    </div>
  <% end %>
  <%= render "form", credential: @credential %>
</div>
