<% own = @credential.user_id == Current.user.id %>

<%= render Ui::PageHeaderComponent.new(title: @credential.name,
      subtitle: @credential.kind_settings[:label]) do |header| %>
  <% unless own %>
    <% header.with_meta do %>
      <%= render Ui::UserLabelComponent.new(user: @credential.user) do %>
        shared by <%= @credential.user.name %> — read-only
      <% end %>
    <% end %>
  <% end %>
  <% header.with_actions do %>
    <% if own %>
      <%= link_to "Edit", edit_credential_path(@credential), class: "btn btn-secondary" %>
      <%= button_to "Delete", credential_path(@credential), method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete #{@credential.name} from your vault for good?" } %>
    <% end %>
  <% end %>
<% end %>

<% unless vault_unlocked? %>
  <div class="mb-4 rounded-lg border border-edge bg-surface p-4">
    <p class="mb-2 text-sm font-medium text-ink">Vault locked — unlock to reveal or copy.</p>
    <%= form_with url: unlock_credentials_path, class: "flex flex-wrap items-center gap-2" do |form| %>
      <%= form.password_field :password, placeholder: "Your account password", autocomplete: "current-password",
            class: "input max-w-xs", required: true %>
      <%= form.submit "Unlock" %>
    <% end %>
  </div>
<% end %>

<% if @secret_lost %>
  <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <span class="font-medium">This entry's secret was lost in a password reset.</span>
    The details below are intact — <%= own ? link_to("re-enter the secret", edit_credential_path(@credential), class: "underline") : "ask #{@credential.user.name} to re-share it" %>.
  </div>
<% end %>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <%= render Ui::CardComponent.new(title: "Details") do %>
      <dl class="space-y-3 text-sm" data-controller="secret" data-secret-url-value="<%= reveal_credential_path(@credential) %>">
        <% if @credential.username.present? %>
          <div class="flex items-center justify-between gap-2">
            <dt class="text-soft"><%= @credential.kind_settings[:username_label] || "Username" %></dt>
            <dd class="flex items-center gap-1.5 font-medium text-ink">
              <%= @credential.username %>
              <button type="button" class="btn btn-ghost btn-sm" data-action="secret#copyText"
                      data-secret-text-param="<%= @credential.username %>">copy</button>
            </dd>
          </div>
        <% end %>
        <% if @credential.url.present? %>
          <div class="flex items-center justify-between gap-2">
            <dt class="text-soft"><%= @credential.kind_settings[:url_label] || "Website" %></dt>
            <dd class="truncate font-medium text-ink"><%= @credential.url %></dd>
          </div>
        <% end %>

        <% unless @secret_lost %>
          <% @credential.kind_settings[:secret_fields].each do |field| %>
            <% next if field == "totp" %>
            <div class="flex items-center justify-between gap-2 border-t border-edge pt-3">
              <dt class="text-soft"><%= field.humanize %></dt>
              <dd class="flex items-center gap-1.5">
                <span class="font-mono text-ink" data-secret-slot="<%= field %>">••••••••</span>
                <button type="button" class="btn btn-ghost btn-sm" data-action="secret#toggle"
                        data-secret-field-param="<%= field %>">reveal</button>
                <button type="button" class="btn btn-ghost btn-sm" data-action="secret#copy"
                        data-secret-field-param="<%= field %>">copy</button>
              </dd>
            </div>
          <% end %>
          <% if @credential.totp_present %>
            <div class="flex items-center justify-between gap-2 border-t border-edge pt-3">
              <dt class="text-soft">One-time code</dt>
              <dd class="flex items-center gap-1.5">
                <button type="button" class="btn btn-secondary btn-sm font-mono" data-action="secret#totp"
                       >show &amp; copy</button>
              </dd>
            </div>
          <% end %>
          <div class="flex items-center justify-between gap-2 border-t border-edge pt-3">
            <dt class="text-soft">Notes</dt>
            <dd class="flex items-center gap-1.5 text-right">
              <span class="whitespace-pre-wrap text-ink" data-secret-slot="notes">••••</span>
              <button type="button" class="btn btn-ghost btn-sm" data-action="secret#toggle"
                      data-secret-field-param="notes">reveal</button>
            </dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <p class="mt-2 text-xs text-soft">
      <% if @credential.secret_changed_at %>Secret last changed <%= @credential.secret_changed_at.to_date %>.<% end %>
      <% if @credential.last_used_at %>Last used <%= @credential.last_used_at.to_date %>.<% end %>
    </p>
  </div>

  <div class="space-y-4">
    <% if own %>
      <%# The vault twist on the standard sharing card (PASSWORDS_PLAN §4.5):
          share/revoke ride credential-scoped routes because both need the
          unlocked vault — a share wraps the item key, a revoke rotates it. %>
      <%= render Ui::CardComponent.new(title: "Sharing", subtitle: "Read-only for them; you stay the owner") do %>
        <% shared = @credential.shared_with %>
        <% if shared.any? %>
          <ul class="mb-4 space-y-2">
            <% shared.each do |user| %>
              <li class="flex items-center justify-between gap-2 text-sm">
                <%= render Ui::UserLabelComponent.new(user: user, css_class: "text-ink", truncate: true) %>
                <%= button_to "Revoke", unshare_credential_path(@credential, grantee_id: user.id), method: :delete,
                      class: "btn btn-danger btn-sm" %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if vault_unlocked? && !@secret_lost %>
          <% eligible = Current.user.household.users.where.not(id: [ Current.user.id ] + shared.map(&:id)).select { |u| u.keyring.present? } %>
          <% no_keyring = Current.user.household.users.where.not(id: Current.user.id).count - shared.size - eligible.size %>
          <% if eligible.any? %>
            <%= form_with url: share_credential_path(@credential), class: "flex flex-wrap items-center gap-2" do |form| %>
              <%= select_tag :grantee_id, options_from_collection_for_select(eligible, :id, :name), class: "input min-w-40 flex-1" %>
              <%= form.submit "Share" %>
            <% end %>
            <% if eligible.many? %>
              <%= button_to "Share with everyone in the household", share_credential_path(@credential, everyone: 1),
                    method: :post, class: "btn btn-secondary btn-sm mt-3 w-full" %>
            <% end %>
          <% elsif shared.none? %>
            <p class="text-sm text-soft">No other members with vaults yet.</p>
          <% end %>
          <% if no_keyring.positive? %>
            <p class="mt-2 text-xs text-soft"><%= pluralize(no_keyring, "member") %> can't receive shares until they sign in once.</p>
          <% end %>
        <% else %>
          <p class="text-sm text-soft">Unlock your vault to change sharing.</p>
        <% end %>
      <% end %>

      <%# Q-vault-audit, resolved: shares and revokes are logged, routine
          reveals are not — last_used_at already answers "when did I use
          this", and a log of your own clicks buries the events that matter. %>
      <% if @events&.any? %>
        <%= render Ui::CardComponent.new(title: "Sharing history") do %>
          <ul class="space-y-2 text-sm">
            <% @events.each do |event| %>
              <li class="flex items-baseline justify-between gap-2">
                <span class="text-ink"><%= event.describe %></span>
                <span class="shrink-0 text-xs text-soft"><%= event.created_at.to_date %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
