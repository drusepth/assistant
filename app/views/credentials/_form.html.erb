<% editing = credential.persisted? %>
<% settings = credential.kind_settings %>

<%= form_with model: credential, class: "space-y-4" do |form| %>
  <% if credential.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">
      <%= credential.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% if editing %>
    <%= form.hidden_field :kind %>
  <% else %>
    <div class="flex flex-wrap gap-1.5">
      <% Credential::KINDS.each do |kind, kind_settings| %>
        <%= link_to kind_settings[:label], new_credential_path(kind: kind),
              class: "chip #{credential.kind == kind ? "bg-primary-100 text-primary-800" : "bg-stone-100 text-stone-700"}" %>
      <% end %>
    </div>
    <%= form.hidden_field :kind %>
  <% end %>

  <%= form.field :name, hint: credential.kind == "wifi" ? "e.g. Home wifi" : nil %>
  <% if settings[:username_label] %>
    <%= form.field :username, label_text: settings[:username_label] %>
  <% end %>
  <% if settings[:url_label] %>
    <%= form.field :url, label_text: settings[:url_label], hint: "Optional." %>
  <% end %>

  <div class="space-y-4 rounded-lg border border-edge bg-stone-50 p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-stone-400">
      Sealed fields<% if editing %> — leave blank to keep the current value<% end %>
    </p>

    <% if settings[:secret_fields].include?("password") %>
      <div data-controller="password-generator" class="space-y-2">
        <div class="space-y-1">
          <label class="text-sm font-medium text-ink" for="secrets_password">Password</label>
          <div class="flex items-center gap-2">
            <input type="text" name="secrets[password]" id="secrets_password" value="" autocomplete="off"
                   spellcheck="false" class="input flex-1 font-mono" <%= "placeholder=unchanged" if editing %>
                   data-password-generator-target="field" data-action="input->password-generator#measure">
            <button type="button" class="btn btn-secondary btn-sm" data-action="password-generator#generate">Generate</button>
          </div>
          <div class="flex items-center justify-between text-xs text-soft">
            <span data-password-generator-target="meter"></span>
            <span class="flex items-center gap-2">
              <label class="flex items-center gap-1"><input type="checkbox" checked data-password-generator-target="symbols" class="size-3.5 rounded accent-primary-600"> symbols</label>
              <label class="flex items-center gap-1"><input type="checkbox" data-password-generator-target="passphrase" class="size-3.5 rounded accent-primary-600"> passphrase</label>
            </span>
          </div>
        </div>
      </div>
    <% end %>

    <% (settings[:secret_fields] - %w[ password totp ]).each do |field| %>
      <div class="space-y-1">
        <label class="text-sm font-medium text-ink" for="secrets_<%= field %>"><%= field.humanize %></label>
        <input type="text" name="secrets[<%= field %>]" id="secrets_<%= field %>" value="" autocomplete="off"
               spellcheck="false" class="input font-mono" <%= "placeholder=unchanged" if editing %>>
      </div>
    <% end %>

    <% if settings[:secret_fields].include?("totp") %>
      <div class="space-y-1">
        <label class="text-sm font-medium text-ink" for="secrets_totp">Two-factor secret (TOTP)</label>
        <input type="text" name="secrets[totp]" id="secrets_totp" value="" autocomplete="off" spellcheck="false"
               class="input font-mono" placeholder="<%= editing && credential.totp_present ? "unchanged" : "Paste the setup key or otpauth:// link" %>">
        <p class="text-xs text-soft">From the site's 2FA setup — the "can't scan?" key next to the QR code.</p>
        <% if editing && credential.totp_present %>
          <label class="flex items-center gap-2 text-xs text-soft">
            <%= check_box_tag :remove_totp, "1", false, class: "size-3.5 rounded accent-primary-600" %> Remove the stored TOTP secret
          </label>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-1">
      <label class="text-sm font-medium text-ink" for="secrets_notes">Notes</label>
      <textarea name="secrets[notes]" id="secrets_notes" rows="3" autocomplete="off" class="input"
                placeholder="<%= editing ? "unchanged — security questions, recovery codes, anything sealed" : "Security questions, recovery codes, anything sealed" %>"></textarea>
      <% if editing %>
        <label class="flex items-center gap-2 text-xs text-soft">
          <%= check_box_tag :remove_notes, "1", false, class: "size-3.5 rounded accent-primary-600" %> Clear the stored notes
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= form.submit editing ? "Save changes" : "Save to vault" %>
    <%= link_to "Cancel", editing ? credential_path(credential) : credentials_path, class: "btn btn-ghost" %>
  </div>
<% end %>
