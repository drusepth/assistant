<%# Computed in-request while unlocked, never stored (PASSWORDS_PLAN W4). %>
<%= render Ui::PageHeaderComponent.new(title: "Password health",
      subtitle: "#{@report.checked} #{"entry".pluralize(@report.checked)} checked — nothing here is saved anywhere") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Back to the vault", credentials_path, class: "btn btn-ghost" %>
  <% end %>
<% end %>

<% if @report.findings.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: "Nothing to flag",
        description: "No reused, common, weak, or year-old passwords among your entries.") %>
<% else %>
  <div class="card divide-y divide-edge">
    <% @report.findings.each do |finding| %>
      <div class="flex flex-wrap items-center justify-between gap-2 p-3">
        <div class="min-w-0">
          <%= link_to finding.credential.name, credential_path(finding.credential), class: "text-sm font-medium text-ink hover:underline" %>
          <p class="text-xs text-soft"><%= finding.credential.username %></p>
        </div>
        <div class="flex items-center gap-1.5">
          <% finding.problems.each do |problem| %>
            <span class="chip <%= problem == "aging" ? "bg-stone-100 text-stone-700" : "bg-red-100 text-red-800" %>"
                  title="<%= { "common" => "On the common-passwords list — crackers try these first",
                               "weak" => "Short or low-variety — easy to brute-force",
                               "reused" => "Used on more than one entry — one breach opens them all",
                               "aging" => "Unchanged for over a year" }[problem] %>">
              <%= problem %>
            </span>
          <% end %>
          <%= link_to "Fix", edit_credential_path(finding.credential), class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<p class="mt-3 text-xs text-soft">
  The common-passwords check runs against a local list (<%= @report.dataset_size %> entries, no network) —
  a household admin can import a bigger one from /admin.
</p>
