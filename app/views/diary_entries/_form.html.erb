<% editing = entry.persisted? %>

<%# Autosave covers a *new* entry too — the longest anyone writes without a
    save is their first sitting, so that is exactly the stretch that must
    not depend on remembering to submit. The controller POSTs the first
    save, then re-points itself (and this form) at the entry it created. %>
<div data-turbo-cache="false" data-controller="diary-autosave"
     data-diary-autosave-url-value="<%= diary_entry_path(entry) if editing %>"
     data-diary-autosave-create-url-value="<%= diary_entries_path unless editing %>">
  <%= form_with model: entry, url: editing ? diary_entry_path(entry) : diary_entries_path,
        method: editing ? :patch : :post, class: "space-y-4",
        data: { diary_autosave_target: "form" } do |form| %>
    <% if entry.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">
        <%= entry.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%# Optimistic locking: two tabs on one entry would otherwise let the
        slower one silently overwrite the other's words. %>
    <% if editing %>
      <%= form.hidden_field :lock_version, data: { diary_autosave_target: "lock" } %>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%# Backdating is first-class: people write up yesterday, or fill in a
          week from a trip. %>
      <label class="text-sm font-medium text-ink" for="entry_date">Date</label>
      <input type="date" name="entry_date" id="entry_date" class="input w-auto"
             value="<%= entry.entry_date.iso8601 %>"
             data-action="change->diary-autosave#queue">
      <span class="ml-auto text-xs text-soft" data-diary-autosave-target="status" aria-live="polite"></span>
    </div>

    <input type="text" name="diary[title]" id="diary_title" value="<%= opened.title %>"
           placeholder="Title (optional)" autocomplete="off" spellcheck="true"
           class="input w-full text-lg font-medium"
           data-action="input->diary-autosave#queue">

    <textarea name="diary[body]" id="diary_body" rows="18" autofocus
              placeholder="<%= placeholder %>" spellcheck="true"
              class="input w-full resize-y leading-relaxed"
              data-diary-autosave-target="body"
              data-action="input->diary-autosave#queue"><%= opened.body %></textarea>

    <div class="flex flex-wrap items-center gap-3">
      <%# A word the writer types, never one the app infers (D32). %>
      <input type="text" name="diary[mood]" id="diary_mood" value="<%= opened.mood %>"
             placeholder="A word for today (optional)" autocomplete="off" maxlength="40"
             class="input w-56" data-action="input->diary-autosave#queue">
      <div class="ml-auto flex items-center gap-2">
        <%= link_to "Cancel", editing ? diary_entry_path(entry) : diary_entries_path, class: "btn btn-ghost" %>
        <%= form.submit editing ? "Done" : "Save entry", data: { diary_autosave_target: "submit" } %>
      </div>
    </div>
  <% end %>

  <p class="mt-3 text-xs text-soft">
    Markdown works here — <code>**bold**</code>, <code># headings</code>, <code>- lists</code>.
  </p>
</div>
