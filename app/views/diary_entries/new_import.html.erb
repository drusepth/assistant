<%= render Ui::PageHeaderComponent.new(title: "Import your diary",
      subtitle: "Bring years of writing over from Day One, Obsidian, or a folder of Markdown") %>

<div class="max-w-xl space-y-4">
  <%= form_with url: import_diary_entries_path, multipart: true, class: "card space-y-4 p-5" do |form| %>
    <%= form.file_field :file, accept: ".zip,.json,.md,.markdown,.txt" %>
    <p class="text-xs text-soft">
      Everything you import is sealed with your password the moment it lands. Afterwards, delete the file you
      uploaded — it holds your diary in plain text. Entries you've already imported are skipped.
    </p>
    <%= form.submit "Import" %>
  <% end %>

  <div class="rounded-lg border border-edge bg-stone-50 p-4 text-xs text-soft">
    <p class="mb-1 font-medium text-ink">What works</p>
    <p class="mb-2">
      <span class="font-medium">Day One:</span> Settings → Import/Export → Export JSON. Drop the whole zip in.
    </p>
    <p class="mb-2">
      <span class="font-medium">Markdown:</span> a zip of <code>.md</code> files, or a single one. The date comes
      from <code>date:</code> front matter, or from a <code>2024-01-15</code> in the filename. A file with neither
      is skipped rather than filed under today — a diary with wrong dates is worse than one with gaps.
    </p>
    <p>A <code># Heading</code> on the first line becomes the entry's title.</p>
  </div>

  <%= link_to "Back to your diary", diary_entries_path, class: "btn btn-ghost" %>
</div>
