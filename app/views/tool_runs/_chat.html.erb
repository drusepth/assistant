<%# The chat surface (D29), shared by the run page and any page hosting a
    subject-bound conversation (D30: task pages). Locals:
      run          — the chat run, or nil when no turn has been sent yet
      tool         — the chat tool class (quick replies, recap copy)
      composer_url — where the composer posts
      openers      — assistant-styled opening lines shown while run is nil
      title        — optional card title (panel only)
      layout       — :screen (owns the viewport) or :panel (a card in a page)

    D-chat-shell: the two layouts want opposite things, so the shell is one
    partial and only its wrapper differs. A :screen chat is the page — no card,
    no page header, chrome folded into its own bar; a :panel is a bounded card
    that flows with the document around it. %>
<% layout = local_assigns.fetch(:layout, :panel) %>
<% screen = layout == :screen %>
<% title = local_assigns[:title] %>

<% if screen %>
  <%= render "tool_runs/chat_shell", run: run, tool: tool, composer_url: composer_url,
        openers: local_assigns.fetch(:openers, []), screen: true %>
<% else %>
  <%= render Ui::CardComponent.new(title: title, padded: false) do %>
    <%= render "tool_runs/chat_shell", run: run, tool: tool, composer_url: composer_url,
          openers: local_assigns.fetch(:openers, []), screen: false %>
  <% end %>

  <%# On a screen the recap lives in the overflow menu, where the rest of the
      session's verbs are; a panel has no menu, so it keeps the footer. %>
  <% if run&.recappable? %>
    <div class="mt-6 flex items-center justify-between gap-4">
      <p class="text-xs text-soft"><%= tool.recap_hint %></p>
      <div class="shrink-0"><%= render "tool_runs/recap_button", tool_run: run %></div>
    </div>
  <% end %>
<% end %>
