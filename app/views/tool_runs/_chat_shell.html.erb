<%# Bar (screen only), transcript, composer — the three rows of the chat
    surface, in the one layout that serves both shapes. See tool_runs/_chat
    for which wrapper puts it on the page. %>
<% thinking = run&.awaiting_reply? %>
<%# A suggestion the user already took is noise, not an offer. %>
<% suggestions = run ? run.unused_quick_replies : tool.quick_replies %>
<%# The newest page of turns, and whether there is history above them. %>
<% messages, earlier = run ? run.tool_run_messages.window : [ [], false ] %>

<div class="<%= screen ? "chat-screen" : "chat-panel #{"min-h-72" if run}" %>"
     data-controller="chat-scroll<%= " chat-viewport" if screen %>">
  <% if screen %>
    <%= render "tool_runs/screen_bar", run: run, tool: tool %>
  <% end %>

  <div class="relative flex min-h-0 flex-1 flex-col">
    <%# Natural reading order — oldest first — so the transcript copies,
        reads aloud, and selects the way a conversation should; chat-scroll
        keeps it pinned to the newest turn and offers a way back down when
        the user has scrolled off to read history. %>
    <%# The id is what lets a morphing refresh match this element to itself
        and mutate its children, rather than swapping the scroller out from
        under its observer and scroll position. %>
    <%# gap-1 is the spacing *within* a run of turns from one speaker; anything
        that stands alone adds its own mt-3 on top (see chat_turns and
        tool_runs/_message). A single uniform gap between every bubble is what
        made three quick messages read as three separate events. %>
    <div id="chat-transcript" class="chat-transcript flex flex-col gap-1 p-4 sm:p-5"
         role="log" aria-live="polite" aria-relevant="additions" aria-busy="<%= thinking.present? %>"
         data-chat-scroll-target="scroller" data-action="scroll->chat-scroll#track">
      <% if run %>
        <% if (recap = run.previous_recap) %>
          <p class="mt-3 text-center text-xs text-soft">
            Picking up from last time —
            <%= link_to recap.title, recap, class: "underline decoration-stone-300 underline-offset-2 hover:text-ink" %>
          </p>
        <% end %>

        <%# History the reader asked for is *their* state, and a morph would
            throw it away — the server only ever renders the newest page. So
            the seam and everything loaded through it live in one permanent
            element, keyed to this run so it can't be matched on another
            conversation's page. %>
        <div id="chat-history-<%= run.id %>" class="flex flex-col gap-1" data-turbo-permanent>
          <%= render "tool_runs/earlier", run: run, before: (messages.first if earlier) %>
        </div>

        <% chat_turns(messages).each do |turn| %>
          <%= render "tool_runs/message", message: turn.message,
                continues: turn.continues, ends_group: turn.ends_group %>
        <% end %>
      <% else %>
        <% openers.each do |opener| %>
          <div class="mt-3 flex justify-start">
            <div class="bubble bubble-assistant bubble-assistant-tail whitespace-pre-wrap"><%= opener %></div>
          </div>
        <% end %>
      <% end %>

      <% if thinking %>
        <%= render "tool_runs/thinking" %>
      <% elsif run&.reply_failed? %>
        <div class="mt-3 flex justify-center">
          <%= button_to "Try again", retry_reply_tool_run_path(run), method: :post,
                class: "btn btn-secondary btn-sm" %>
        </div>
      <% end %>

      <%# What the session produced. On a screen there is nowhere below the
          composer for it to live, and it belongs to the conversation anyway. %>
      <% if screen && run %>
        <%= render "tool_runs/outcomes", run: run %>
      <% end %>
    </div>

    <button type="button" class="absolute bottom-3 left-1/2 hidden -translate-x-1/2 rounded-full border border-edge bg-surface p-2 text-soft shadow-sm transition-colors hover:text-ink"
            aria-label="Jump to the latest message"
            data-chat-scroll-target="jump" data-action="chat-scroll#jump">
      <%= icon(:arrow_down, css_class: "size-4") %>
    </button>
  </div>

  <%# On a screen the composer is the last row of the viewport, so it owes the
      gesture bar its inset; in a panel it is mid-page and doesn't. %>
  <div class="shrink-0 border-t border-edge p-3 sm:p-4 <%= "pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:pb-[calc(1rem+env(safe-area-inset-bottom))]" if screen %>">
    <%# A morphing refresh re-renders the send button from the server, which
        knows about the in-flight lock but not about the empty draft in front
        of the user — and connect() won't run again to re-apply it. %>
    <%# The queue key is the composer URL: stable per conversation, distinct
        between the run page and a task's panel, and already unique. %>
    <%= form_with url: composer_url, class: "space-y-2.5",
          data: { controller: "chat-input",
                  chat_input_queue_key_value: composer_url,
                  action: "submit->chat-input#beforeSubmit " \
                          "turbo:submit-start->chat-input#submitStart " \
                          "turbo:submit-end->chat-input#reset " \
                          "turbo:morph@document->chat-input#refreshSend " \
                          "turbo:morph@document->chat-input#renderPending " \
                          "turbo:render@document->chat-input#refreshSend " \
                          "turbo:render@document->chat-input#renderPending " \
                          "keydown@window->chat-input#noteKeyboard " \
                          "online@window->chat-input#flush " \
                          "offline@window->chat-input#refreshOffline" } do %>
      <%# The turn as it looks before the server has heard about it
          (D-chat-optimistic). The id carries the token the form posts, so the
          morph that follows matches the server's bubble to this one instead of
          removing one and inserting the other. %>
      <template data-chat-input-target="optimisticTemplate">
        <div class="mt-3 flex flex-col items-end">
          <div class="bubble bubble-user bubble-user-tail">
            <p class="whitespace-pre-wrap" data-optimistic-text></p>
          </div>
        </div>
      </template>

      <%# The same turn when it couldn't leave at all — see the offline queue
          in chat_input_controller. It lives here rather than in the transcript
          markup because nothing on the server knows about it. %>
      <template data-chat-input-target="pendingTemplate">
        <div class="mt-3 flex flex-col items-end" data-pending-bubble>
          <div class="bubble bubble-user bubble-user-tail opacity-60">
            <p class="whitespace-pre-wrap" data-pending-text></p>
          </div>
          <p class="mt-1 flex flex-wrap items-center justify-end gap-2 px-1 text-[0.6875rem] text-soft">
            <span data-pending-status></span>
            <button type="button" class="cursor-pointer underline underline-offset-2 hover:text-ink"
                    data-action="chat-input#retry" data-chat-input-id-param="">Retry</button>
            <button type="button" class="cursor-pointer underline underline-offset-2 hover:text-ink"
                    data-action="chat-input#discard" data-chat-input-id-param="">Discard</button>
          </p>
        </div>
      </template>

      <template data-chat-input-target="thinkingTemplate">
        <%= render "tool_runs/thinking" %>
      </template>

      <%= hidden_field_tag :client_token, nil, data: { chat_input_target: "token" } %>
      <p class="px-1 text-xs text-soft" role="status" data-chat-input-target="offline" hidden></p>

      <% if suggestions.any? && !thinking %>
        <div class="chat-suggestions" data-chat-input-target="suggestions">
          <% suggestions.each do |reply| %>
            <button type="button" class="chip cursor-pointer border border-edge bg-surface text-soft transition-colors hover:border-primary-300 hover:text-ink"
                    data-action="chat-input#quickReply" data-chat-input-text-param="<%= reply %>">
              <%= reply %>
            </button>
          <% end %>
        </div>
      <% end %>

      <div class="composer">
        <%= label_tag "chat-composer", "Your message", class: "sr-only" %>
        <%= text_area_tag :content, nil, rows: 1, id: "chat-composer", class: "composer-input",
              autocomplete: "off", placeholder: "Type a message…",
              enterkeyhint: "send", autocapitalize: "sentences", autocorrect: "on", spellcheck: "true",
              data: { turbo_permanent: true, chat_input_target: "input",
                      action: "keydown->chat-input#keydown input->chat-input#grow" } %>
        <%# Two ways to be disabled, and only one of them is the composer's.
            `data-locked` is the server saying a reply is in flight; the
            empty-draft dimming is JS, applied on top and never over it — so
            with JS off the button still sends. %>
        <%= tag.button type: "submit", class: "composer-send", disabled: thinking,
              aria: { label: thinking ? "Writing a reply…" : "Send" },
              data: { chat_input_target: "send", locked: thinking.presence } do %>
          <%= icon(:paper_airplane, css_class: "size-5") %>
        <% end %>
      </div>
      <p class="hidden px-1 text-right text-xs text-soft sm:block">
        Enter to send · Shift+Enter for a new line
      </p>
    <% end %>
  </div>
</div>
