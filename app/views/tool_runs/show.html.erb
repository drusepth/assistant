<%= turbo_stream_from @tool_run %>

<%# A live chat run is a screen, not a page (D-chat-shell): it owns the
    viewport so the composer is welded to the bottom and the transcript is the
    only thing that scrolls. Everything the page header carried folds into the
    screen's own bar below `lg`; above it, the header comes back. %>
<% if @tool_run.chat? && @tool_run.done? %>
  <% content_for :bleed, true %>
  <div class="chat-page lg:px-8 lg:pb-6">
    <div class="hidden lg:block">
      <%= render Ui::PageHeaderComponent.new(
            title: @tool_run.tool.title,
            subtitle: "Started #{@tool_run.created_at.strftime("%B %-d, %Y")}"
          ) do |header| %>
        <% header.with_actions do %>
          <%= link_to "All conversations", chats_path, class: "btn btn-secondary" %>
          <% if @tool_run.subject %>
            <%= link_to "Open the #{@tool_run.subject.model_name.human.downcase}", @tool_run.subject, class: "btn btn-secondary" %>
          <% else %>
            <%= link_to "New session", new_tool_run_path(@tool_run.tool_slug, inputs: @tool_run.inputs), class: "btn btn-secondary" %>
          <% end %>
          <%= button_to "Delete", @tool_run, method: :delete, class: "btn btn-danger",
                data: { turbo_confirm: "Delete this conversation? The transcript is gone for good — saved recaps stay in your notes." } %>
        <% end %>
      <% end %>
    </div>

    <%= render "tool_runs/chat", run: @tool_run, tool: @tool_run.tool, layout: :screen,
          composer_url: tool_run_messages_path(@tool_run) %>
  </div>
<% else %>
  <%# Everything else: a draft-kind run of any status, and a chat run that
      hasn't opened yet or failed to. These flow in the page. %>
  <%# An agent run says so in its own subtitle: a run the user never
      started should never read as one they forgot starting. %>
  <%= render Ui::PageHeaderComponent.new(
        title: @tool_run.tool.title,
        subtitle: @tool_run.origin_agent? ?
          "Prepared by your assistant on #{@tool_run.created_at.strftime("%B %-d, %Y")}" :
          "#{@tool_run.chat? ? "Started" : "Run on"} #{@tool_run.created_at.strftime("%B %-d, %Y")}"
      ) do |header| %>
    <% if @tool_run.finished? %>
      <% header.with_actions do %>
        <%# A subject-bound run (D30) has no form to run again from — its
            inputs are the item it's bound to, so the way back is the item. %>
        <% if @tool_run.subject %>
          <%= link_to "Open the #{@tool_run.subject.model_name.human.downcase}", @tool_run.subject, class: "btn btn-secondary" %>
        <% else %>
          <%= link_to "Run again", new_tool_run_path(@tool_run.tool_slug, inputs: @tool_run.inputs), class: "btn btn-secondary" %>
        <% end %>
        <%= button_to "Delete", @tool_run, method: :delete, class: "btn btn-danger",
              data: { turbo_confirm: @tool_run.chat? ?
                "Delete this conversation? The transcript is gone for good — saved recaps stay in your notes." :
                "Delete this run? Anything you added from it (notes, tasks, events) stays." } %>
      <% end %>
    <% end %>
  <% end %>

<div class="max-w-3xl space-y-6">
  <% if @tool_run.queued? || @tool_run.running? %>
    <%= render Ui::CardComponent.new do %>
      <div class="space-y-4">
        <%# Decoration only — the sentence under it is what a screen reader
            should hear, so the bars stay out of the accessibility tree.
            28 is two full wavelengths of the atom's 14-bar phase, so the
            wave meets both edges of the card at the same point. %>
        <div class="working-bars" aria-hidden="true">
          <% 28.times do %><span class="working-bar"></span><% end %>
        </div>
        <p class="text-sm text-soft">Working on it — this page updates by itself when the draft is ready.</p>
      </div>
    <% end %>
  <% elsif @tool_run.failed? %>
    <%= render Ui::CardComponent.new(title: "That didn't work") do %>
      <p class="text-sm text-red-600"><%= @tool_run.error %></p>
    <% end %>
  <% elsif @tool_run.prepared? %>
    <%= render "tool_runs/prepared", tool_run: @tool_run %>
  <% elsif @tool_run.discarded? %>
    <%= render Ui::CardComponent.new(title: "Discarded") do %>
      <p class="text-sm text-soft">You read this draft and said no — nothing was ever saved.</p>
    <% end %>
  <% else %>
    <%# Ask-your-email answers render here rather than landing anything —
        "Save as note" is the explicit door into the primitive pool
        (D-mirror-layer). %>
    <% if (answer = @tool_run.output["answer"]).present? %>
      <%= render Ui::CardComponent.new(title: answer["question"],
            subtitle: "Answered from #{answer["searched"]} — save it if it's worth keeping") do |card| %>
        <% card.with_actions do %>
          <%= button_to "Save as note", save_answer_tool_run_path(@tool_run), method: :post, class: "btn btn-secondary btn-sm" %>
        <% end %>
        <div class="prose-body text-sm"><%= Markdown.render(answer["body"]) %></div>
        <% if Array(answer["citations"]).any? %>
          <ul class="mt-3 space-y-1 border-t border-edge pt-3 text-xs text-soft">
            <% answer["citations"].each do |citation| %>
              <li>— <%= citation["from"] %><%= ", #{citation["date"]}" if citation["date"].present? %><%= ": #{citation["note"]}" if citation["note"].present? %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>

    <%# Offers first (D-tool-run-offers): what a draft run staged waits for
        the user's Add. Below them, anything the run filed directly — a plan's
        goal, a tool that writes its own rows, a saved answer. %>
    <% offers = @tool_run.offers %>
    <%= render "tool_runs/offers", run: @tool_run, offers: offers if offers.any? %>

    <% items = @tool_run.direct_items %>
    <% drafts = items.grep(Note) %>
    <% goals = items.grep(Goal) %>
    <% deadlines = items.grep(Event) %>
    <% rest = items - drafts - goals - deadlines %>

    <% drafts.each do |note| %>
      <%= render Ui::CardComponent.new(title: note.title, subtitle: "Draft — saved to your notes") do |card| %>
        <% card.with_actions do %>
          <%= link_to "Open note", note, class: "btn btn-secondary btn-sm" %>
        <% end %>
        <div class="prose-body text-[0.9375rem]"><%= Markdown.render(note.body) %></div>
      <% end %>
    <% end %>

    <% if goals.any? %>
      <%= render Ui::CardComponent.new(title: "The plan", subtitle: "Saved to your Tasks board", padded: false) do %>
        <div class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2"><%= render goals %></div>
      <% end %>
    <% end %>

    <% if rest.any? %>
      <%= render Ui::CardComponent.new(
            title: @tool_run.tool.kind == :plan ? "The steps" : "Follow-ups",
            subtitle: "Added to your tasks", padded: false
          ) do %>
        <div class="divide-y divide-edge"><%= render rest %></div>
      <% end %>
    <% end %>

    <% if deadlines.any? %>
      <%= render Ui::CardComponent.new(title: "Deadlines", subtitle: "Added to your calendar", padded: false) do %>
        <div class="divide-y divide-edge"><%= render deadlines %></div>
      <% end %>
    <% end %>

    <% if items.empty? && offers.empty? && @tool_run.output["answer"].blank? %>
      <%= render Ui::CardComponent.new do %>
        <p class="text-sm text-soft">The run finished but produced nothing — try again with more detail.</p>
      <% end %>
    <% end %>

    <%# Ask-then-send (D-career-web): the compose panel IS the review — the
        user's own mailbox, their edits, one explicit click. %>
    <% if @tool_run.tool_slug == "tailor_application" && @tool_run.done? %>
      <%= render "tool_runs/email_application", tool_run: @tool_run %>
    <% end %>

    <p class="text-xs text-soft">
      Drafts are yours to review, fill in, and send — nothing ever goes out without your explicit click.
    </p>
  <% end %>

  <%# Next-step cards render for chat and draft runs alike — a check-in's
      find-a-therapist card is the D28 seam doing trust work. %>
  <% if @tool_run.done? && (next_steps = @tool_run.next_steps).any? %>
    <%= render Ui::CardComponent.new(title: "Suggested next steps", subtitle: "One click — the form comes prefilled") do %>
      <div class="divide-y divide-edge">
        <% next_steps.each do |step| %>
          <div class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
            <div class="min-w-0">
              <p class="text-sm font-medium text-ink"><%= step.tool.title %></p>
              <% if step.reason %>
                <p class="mt-0.5 text-xs text-soft"><%= step.reason %></p>
              <% end %>
            </div>
            <%= link_to "Start →", new_tool_run_path(step.tool.slug, inputs: step.inputs),
                  class: "btn btn-secondary btn-sm shrink-0" %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>
