<%= render Ui::PageHeaderComponent.new(title: @tool.title, subtitle: @tool.description) %>

<div class="max-w-xl">
  <div class="card p-6">
    <%= form_with url: run_tool_path(@tool.slug), class: "space-y-4" do %>
      <% if @tool_run.errors.any? %>
        <p class="field-error"><%= @tool_run.errors.full_messages.to_sentence %></p>
      <% end %>

      <% @tool.inputs.each do |input| %>
        <div class="space-y-1">
          <%= label_tag "inputs_#{input.name}", input.label, class: "label" %>
          <% if input.document? %>
            <% if @document_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@document_choices, :id, :title, @tool_run.inputs[input.name]),
                    include_blank: "Choose a document…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                Nothing in your documents yet —
                <%= link_to "upload one first", new_document_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.hobby? && @hobby_choices.any? %>
            <%= select_tag "inputs[#{input.name}]",
                  options_for_select(@hobby_choices.map(&:name), @tool_run.inputs[input.name]),
                  include_blank: input.required? ? "Choose a hobby…" : "All my hobbies",
                  class: "input", id: "inputs_#{input.name}" %>
          <% else %>
            <%= text_field_tag "inputs[#{input.name}]", @tool_run.inputs[input.name], class: "input", id: "inputs_#{input.name}" %>
          <% end %>
          <% if input.hint %>
            <p class="hint"><%= input.hint %></p>
          <% end %>
        </div>
      <% end %>

      <div class="flex items-center gap-2">
        <%= submit_tag "Run", class: "btn btn-primary" %>
        <%= link_to "Cancel", section_path(@tool.section_slugs.first), class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
