<%= render Ui::PageHeaderComponent.new(title: @tool.title, subtitle: @tool.description) %>

<div class="max-w-xl">
  <div class="card p-6">
    <%= form_with url: run_tool_path(@tool.slug), class: "space-y-4" do %>
      <% if @tool_run.errors.any? %>
        <p class="field-error"><%= @tool_run.errors.full_messages.to_sentence %></p>
      <% end %>

      <%= render partial: "tool_runs/input", collection: @tool.basic_inputs, as: :input %>

      <% if @tool.advanced_inputs.any? %>
        <details class="rounded-xl border border-edge p-4" <%= "open" if @tool_run.errors.any? %>>
          <summary class="cursor-pointer text-sm font-medium text-ink">Advanced</summary>
          <div class="mt-3 space-y-4">
            <%= render partial: "tool_runs/input", collection: @tool.advanced_inputs, as: :input %>
          </div>
        </details>
      <% end %>

      <div class="flex items-center gap-2">
        <%= submit_tag "Run", class: "btn btn-primary" %>
        <%= link_to "Cancel", section_path(@tool.section_slugs.first), class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
