<%= render Ui::PageHeaderComponent.new(title: @tool.title, subtitle: @tool.description) %>

<div class="max-w-xl space-y-4">
  <%# Picking a session back up is usually the better move — the tutor already
      knows where you got to (D-chat-index). %>
  <% if @recent_chats&.any? %>
    <%= render Ui::CardComponent.new(title: "Pick up where you left off", padded: false) do |card| %>
      <% card.with_actions do %>
        <%= link_to "All conversations", chats_path, class: "btn btn-secondary btn-sm" %>
      <% end %>
      <div class="divide-y divide-edge">
        <% @recent_chats.each do |run| %>
          <%= link_to tool_run_path(run), class: "flex items-baseline justify-between gap-3 px-5 py-2.5 text-sm transition-colors hover:bg-canvas" do %>
            <span class="min-w-0 truncate text-ink">
              Started <%= l(run.created_at.to_date, format: :long) %>
            </span>
            <span class="shrink-0 text-xs text-soft"><%= time_ago_in_words(run.created_at) %> ago</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="card p-6">
    <%= form_with url: run_tool_path(@tool.slug), class: "space-y-4" do %>
      <% if @tool_run.errors.any? %>
        <p class="field-error"><%= @tool_run.errors.full_messages.to_sentence %></p>
      <% end %>

      <% @tool.inputs.each do |input| %>
        <div class="space-y-1">
          <% if input.checkboxes? %>
            <p class="label"><%= input.label %></p>
            <div class="grid grid-cols-1 gap-2 pt-1 sm:grid-cols-2">
              <% input.options.each do |option| %>
                <label class="flex items-center gap-2 text-sm text-ink">
                  <%= check_box_tag "inputs[#{input.name}][]", option,
                        Array(@tool_run.inputs[input.name]).include?(option),
                        id: "inputs_#{input.name}_#{option.parameterize(separator: "_")}" %>
                  <%= option %>
                </label>
              <% end %>
            </div>
            <% if input.hint %>
              <p class="hint"><%= input.hint %></p>
            <% end %>
            <% next %>
          <% end %>
          <%= label_tag "inputs_#{input.name}", input.label, class: "label" %>
          <% if input.select? %>
            <%= select_tag "inputs[#{input.name}]",
                  options_for_select(input.options, @tool_run.inputs[input.name]),
                  include_blank: "Choose…", class: "input", id: "inputs_#{input.name}" %>
          <% elsif input.document? %>
            <% if @document_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@document_choices, :id, :title, @tool_run.inputs[input.name]),
                    include_blank: "Choose a document…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                Nothing in your documents yet —
                <%= link_to "upload one first", new_document_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.person? %>
            <% if @person_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@person_choices, :id, :name, @tool_run.inputs[input.name]),
                    include_blank: "Choose a person…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                Nobody in your address book yet —
                <%= link_to "add someone first", new_person_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.pet? %>
            <% if @pet_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@pet_choices, :id, :name, @tool_run.inputs[input.name]),
                    include_blank: "Choose a pet…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                No pets yet —
                <%= link_to "add one first", new_pet_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.email_message? %>
            <% if @email_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@email_choices, :id, :choice_label, @tool_run.inputs[input.name]),
                    include_blank: "Choose an email…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                No mirrored mail yet —
                <%= link_to "link a mailbox first", settings_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.ledger_month? %>
            <%= select_tag "inputs[#{input.name}]",
                  options_for_select(@ledger_month_choices, @tool_run.inputs[input.name]),
                  class: "input", id: "inputs_#{input.name}" %>
          <% elsif input.budget_category? %>
            <% if @budget_category_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@budget_category_choices, :id, :name, @tool_run.inputs[input.name]),
                    include_blank: "The whole budget", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                No envelopes yet —
                <%= link_to "build your budget first", new_tool_run_path("build_my_budget"), class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.date? %>
            <%= date_field_tag "inputs[#{input.name}]", @tool_run.inputs[input.name], class: "input", id: "inputs_#{input.name}" %>
          <% elsif input.hobby? && @hobby_choices.any? %>
            <%= select_tag "inputs[#{input.name}]",
                  options_for_select(@hobby_choices.map(&:name), @tool_run.inputs[input.name]),
                  include_blank: input.required? ? "Choose a hobby…" : "All my hobbies",
                  class: "input", id: "inputs_#{input.name}" %>
          <% elsif input.topic? %>
            <% if @topic_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    grouped_options_for_select(@topic_choices.map { |subject, topics| [ subject.title, topics.map { |topic| [ topic.title, topic.id ] } ] }, @tool_run.inputs[input.name]),
                    include_blank: "Choose a topic…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                No subjects on the go yet —
                <%= link_to "start one first", curriculum_shelf_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.study_subject? %>
            <% if @study_subject_choices.any? %>
              <%= select_tag "inputs[#{input.name}]",
                    options_from_collection_for_select(@study_subject_choices, :id, :title, @tool_run.inputs[input.name]),
                    include_blank: "Choose a subject…", class: "input", id: "inputs_#{input.name}" %>
            <% else %>
              <p class="hint">
                No subjects on the go yet —
                <%= link_to "start one first", curriculum_shelf_path, class: "text-primary-700 hover:underline" %>.
              </p>
            <% end %>
          <% elsif input.textarea? %>
            <%= text_area_tag "inputs[#{input.name}]", @tool_run.inputs[input.name], class: "input", rows: 6, id: "inputs_#{input.name}" %>
          <% else %>
            <%= text_field_tag "inputs[#{input.name}]", @tool_run.inputs[input.name], class: "input", id: "inputs_#{input.name}" %>
          <% end %>
          <% if input.hint %>
            <p class="hint"><%= input.hint %></p>
          <% end %>
        </div>
      <% end %>

      <div class="flex items-center gap-2">
        <%= submit_tag "Run", class: "btn btn-primary" %>
        <%= link_to "Cancel", section_path(@tool.section_slugs.first), class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
