<%# One line in the river (D-feed-reader). Google Reader's row, which
    nothing since has improved on: source, headline, the first few words,
    the age — one line, at a height where twenty fit on a screen. Unread
    carries the weight; read recedes without disappearing.

    Text and a link out, never the publisher's HTML (it's stripped at parse
    time), because the article belongs to the site that wrote it. Locals:
    item. %>
<% url = reader_safe_url(item.url) %>
<article id="<%= dom_id(item) %>" class="reader-line group">
  <%# The source column: fixed and truncated, so four hundred headlines all
      start at the same x. Below `lg` it moves into the meta line, where
      there is room for it. %>
  <span class="hidden w-32 shrink-0 truncate text-xs text-soft lg:block xl:w-44">
    <%= item.source_name %>
  </span>

  <%# One line on a wide screen — the headline and as much of the opening
      as fits, cut cleanly rather than wrapped. %>
  <div class="min-w-0 flex-1 lg:truncate">
    <% if item.saved? %>
      <span class="text-sage-700" title="Saved" aria-label="Saved">★</span>
    <% end %>
    <h3 class="inline text-sm <%= item.read? ? "font-normal text-soft" : "font-semibold text-ink" %>">
      <% if url %>
        <%= link_to item.title, url, class: "hover:underline", **ReaderHelper::OUTBOUND %>
      <% else %>
        <%= item.title %>
      <% end %>
    </h3>
    <%# The opening words are wide-screen furniture: on a phone the headline
        is the whole row, and a two-line preview under every one of forty
        items is the density this list exists to avoid. %>
    <% if (blurb = item.blurb(200)).present? %>
      <span class="hidden text-sm text-soft lg:inline"> — <%= blurb %></span>
    <% end %>
  </div>

  <%# Below `lg` this line carries what the wide screen puts in its own
      columns — source, age, hobby — in front of the verbs, so a phone row
      is a headline and one small line rather than three. %>
  <div class="reader-verbs">
    <span class="min-w-0 max-w-[45%] truncate lg:hidden"><%= item.source_name %></span>
    <span class="lg:hidden" aria-hidden="true">·</span>
    <span class="lg:hidden"><%= reader_age(item.published_on) %></span>
    <% item.feed.sections.each do |section| %>
      <span class="chip <%= section_chip_classes(section) %> lg:hidden"><%= section.name %></span>
    <% end %>
    <span class="hidden flex-1 lg:block" aria-hidden="true"></span>
    <% if item.saved? %>
      <%= button_to "Unsave", unsave_feed_item_path(item), method: :patch,
            class: "reader-verb", form_class: "contents" %>
    <% else %>
      <%= button_to "Save", save_feed_item_path(item), method: :patch,
            class: "reader-verb", form_class: "contents" %>
    <% end %>

    <% if item.read? %>
      <%= button_to "Unread", unread_feed_item_path(item), method: :patch,
            class: "reader-verb", form_class: "contents" %>
    <% else %>
      <%= button_to "Read", read_feed_item_path(item), method: :patch,
            class: "reader-verb", form_class: "contents" %>
    <% end %>

    <%# The point of the whole section (docs/HOBBIES.md): a river that ends
        in doing something, not in a better-groomed reading list. %>
    <%= link_to "Task", new_task_path(title: item.title, section_ids: item.feed.section_ids),
          class: "reader-verb" %>
  </div>

  <time class="hidden w-12 shrink-0 text-right text-xs tabular-nums text-soft lg:block"
        datetime="<%= item.published_on.iso8601 %>" title="<%= l(item.published_on, format: :long) %>">
    <%= reader_age(item.published_on) %>
  </time>
</article>
