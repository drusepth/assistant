<%= render Ui::PageHeaderComponent.new(title: "Today", subtitle: Date.current.strftime("%A, %B %-d")) do |header| %>
  <% header.with_actions do %>
    <%= quick_add :task, label: "Task for today", title: "New task for today",
          prefill: { due_on: Date.current }, primary: true %>
  <% end %>
<% end %>

<%= render "today/glance",
      overdue: @overdue_tasks.size, due_today: @today_tasks.size, events: @today_events.size %>

<div class="space-y-6">
  <% if @overdue_tasks.any? %>
    <%= render Ui::CardComponent.new(title: "Overdue", subtitle: "Oldest first — claim one for today or push it to tomorrow",
          count: @overdue_tasks.size, anchor: "overdue", padded: false) do %>
      <div class="item-stack">
        <%= render partial: "tasks/task", collection: @overdue_tasks, locals: { reschedule: true, dom_prefix: "overdue" } %>
      </div>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Due today", count: @today_tasks.size, anchor: "due-today", padded: false) do %>
    <% if @today_tasks.any? %>
      <div class="item-stack">
        <%= render partial: "tasks/task", collection: @today_tasks, locals: { dom_prefix: "due-today" } %>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">Nothing due today.</p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Today's events", count: @today_events.size, anchor: "todays-events", padded: false) do %>
    <% if @today_events.any? %>
      <div class="item-stack">
        <% @today_events.each do |event| %>
          <%# A finished event stays on the page — it's how the day reads back
              — but it steps out of the way of what's still ahead. %>
          <div class="<%= "opacity-50" if event.finished? %>">
            <%= render "events/event", event: event, dom_prefix: "today" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">No events today.</p>
    <% end %>
  <% end %>

  <%= render "reminders/upcoming", reminders: @reminders %>

  <% weekend_prep = @prep_range.count > 1 %>
  <%= render Ui::CardComponent.new(
        title: weekend_prep ? "Get ready for the weekend" : "Get ready for tomorrow",
        subtitle: weekend_prep ? "Saturday through Monday" : "Tasks due and events happening tomorrow",
        count: @prep_tasks.size + @prep_events.size, padded: false) do |card| %>
    <% card.with_actions do %>
      <%= quick_add :task, name: "tomorrow_task", label: "Task for tomorrow", title: "New task for tomorrow",
            prefill: { due_on: Date.tomorrow }, small: true %>
    <% end %>

    <% if @early_events.any? %>
      <div class="border-b border-edge bg-primary-100 px-5 py-2.5 text-xs text-primary-900">
        Early start tomorrow: <%= @early_events.map { |event| "#{event.title} at #{event.starts_at.strftime("%-l:%M %p")}" }.to_sentence %> — worth prepping tonight.
      </div>
    <% end %>

    <% if @prep_tasks.any? || @prep_events.any? %>
      <% if weekend_prep %>
        <div class="item-stack">
          <% @prep_range.each do |day| %>
            <% day_tasks = @prep_tasks.select { |task| task.due_on == day } %>
            <% day_events = @prep_events.select { |event| [ event.starts_at.to_date, @prep_range.first ].max == day } %>
            <% next if day_tasks.empty? && day_events.empty? %>
            <p class="stack-label"><%= day.strftime("%A") %></p>
            <%= render partial: "tasks/task", collection: day_tasks, locals: { dom_prefix: "prep" } %>
            <%= render partial: "events/event", collection: day_events, locals: { dom_prefix: "prep" } %>
          <% end %>
        </div>
      <% else %>
        <div class="item-stack">
          <%= render partial: "tasks/task", collection: @prep_tasks, locals: { dom_prefix: "prep" } %>
          <%= render partial: "events/event", collection: @prep_events, locals: { dom_prefix: "prep" } %>
        </div>
      <% end %>
    <% else %>
      <p class="px-5 py-8 text-center text-sm text-soft">Nothing on the books <%= weekend_prep ? "this weekend" : "for tomorrow" %> yet.</p>
    <% end %>
  <% end %>

  <% if @week_events_by_day.any? %>
    <%= render Ui::CardComponent.new(title: "Coming up this week",
          count: @week_events_by_day.sum { |_day, events| events.size }, padded: false) do %>
      <div class="item-stack">
        <% @week_events_by_day.each do |day, events| %>
          <p class="stack-label"><%= day.strftime("%A, %b %-d") %></p>
          <%= render partial: "events/event", collection: events, locals: { dom_prefix: "week" } %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @unscheduled_tasks.any? %>
    <%# The undated list is where claiming matters most: these have no date to
        move, so the two buttons are the only way they ever land on a day. %>
    <%= render Ui::CardComponent.new(title: "Unscheduled", subtitle: "Open tasks with no date, oldest first",
          count: @unscheduled_count, anchor: "unscheduled", padded: false) do %>
      <div class="item-stack">
        <%= render partial: "tasks/task", collection: @unscheduled_tasks, locals: { reschedule: true, dom_prefix: "unscheduled" } %>
      </div>
      <% if @unscheduled_count > @unscheduled_tasks.length %>
        <div class="border-t border-edge px-4 py-2.5">
          <%= link_to "View all #{@unscheduled_count} unscheduled tasks →", tasks_path, class: "text-xs font-medium text-primary-700 hover:text-primary-800" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
