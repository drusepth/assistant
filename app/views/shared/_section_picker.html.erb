<%# Sections are the assistant's job, not the user's (D16) — this is the
    correction path, so it stays folded away behind one line rather than
    opening every form with a wall of lenses. It lists only the sections the
    household turned on (plus whatever is already applied). %>
<% item = form.object %>
<details class="rounded-xl border border-edge px-3 py-2" <%= "open" if item.errors.any? %>>
  <summary class="cursor-pointer text-sm font-medium text-ink">
    Sections <span class="font-normal text-soft">— <%= section_picker_summary(item) %></span>
  </summary>

  <div class="mt-2 flex flex-wrap gap-1.5">
    <%= form.collection_check_boxes :section_ids, section_picker_choices(item), :id, :qualified_name do |builder| %>
      <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-edge px-2.5 py-1 text-xs font-medium text-soft has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 has-[:checked]:text-primary-800">
        <%= builder.check_box(class: "size-3.5 accent-primary-600") %>
        <%= builder.text %>
      </label>
    <% end %>
  </div>
</details>
