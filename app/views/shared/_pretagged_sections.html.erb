<%# Carries section pre-tags (e.g. from a section page's quick capture)
    through the minimal new forms. Hand-tagging here means auto-sort leaves
    the item's sections alone (D16).

    A pet's lens is the one pre-tag worth a choice: from Rex's page the form
    offers every pet as a chip, Rex already on, so a job that is both pets'
    is one tap away rather than a trip to the full form's section picker. %>
<% if item.sections.any? %>
  <% pets = pet_tag_choices(item) %>
  <% pet_lens_ids = pets ? pets.map(&:section_id) : [] %>
  <% others = item.sections.reject { |section| pet_lens_ids.include?(section.id) } %>
  <% others.each do |section| %>
    <%= form.hidden_field :section_ids, multiple: true, value: section.id %>
  <% end %>
  <% if pets %>
    <fieldset class="space-y-1">
      <legend class="label">For</legend>
      <div class="flex flex-wrap gap-1.5">
        <% pets.each do |pet| %>
          <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-edge px-2.5 py-1 text-xs font-medium text-soft has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 has-[:checked]:text-primary-800">
            <%= check_box_tag "#{form.object_name}[section_ids][]", pet.section_id, item.section_ids.include?(pet.section_id),
                  id: nil, class: "size-3.5 accent-primary-600" %>
            <%= pet.name %>
          </label>
        <% end %>
      </div>
    </fieldset>
    <% if others.any? %>
      <p class="hint">Will also be filed under <%= others.map(&:qualified_name).to_sentence %>.</p>
    <% end %>
  <% else %>
    <p class="hint">Will be filed under <%= item.sections.map(&:qualified_name).to_sentence %>.</p>
  <% end %>
<% end %>
