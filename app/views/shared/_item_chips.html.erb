<%# Section chips + shared-by attribution, used inside every item row. %>
<% item.sections.each do |section| %>
  <%= render Ui::SectionChipComponent.new(section: section) %>
<% end %>
<% if item.user_id != Current.user.id %>
  <span class="text-xs text-soft">from <%= item.user.name %></span>
<% end %>
