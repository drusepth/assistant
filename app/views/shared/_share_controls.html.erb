<%# Item-level sharing (D9). Only rendered for the item's owner, and not at
    all in a one-person household: with nobody to share with and nothing to
    revoke, the card has no verb. Settings says how sharing starts. %>
<% members = Current.user.household.users.where.not(id: Current.user.id).order(:name) %>
<% grants = subject.access_grants.where(grantor: Current.user).includes(:grantee) %>
<% return if members.none? && grants.none? %>

<%= render Ui::CardComponent.new(title: "Sharing", subtitle: "Private to you unless shared") do %>
  <% if grants.any? %>
    <ul class="mb-4 space-y-2">
      <% grants.each do |grant| %>
        <li class="flex items-center justify-between gap-2 text-sm">
          <%= render Ui::UserLabelComponent.new(user: grant.grantee, css_class: "text-ink", truncate: true) %>
          <%= button_to "Revoke", access_grant_path(grant), method: :delete, class: "btn btn-danger btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% available = members.where.not(id: grants.map(&:grantee_id)) %>
  <% if available.any? %>
    <%= form_with url: access_grants_path, class: "flex flex-wrap items-center gap-2" do |form| %>
      <%= hidden_field_tag :subject_type, subject.class.name %>
      <%= hidden_field_tag :subject_id, subject.id %>
      <%= select_tag :grantee_id, options_from_collection_for_select(available, :id, :name), class: "input min-w-40 flex-1" %>
      <%= form.submit "Share" %>
    <% end %>
    <% if available.many? %>
      <%= button_to "Share with everyone in the household",
            access_grants_path(subject_type: subject.class.name, subject_id: subject.id, everyone: 1),
            method: :post, class: "btn btn-secondary btn-sm mt-3 w-full" %>
    <% end %>
  <% end %>
<% end %>
