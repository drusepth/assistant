<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Assistant">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-ink antialiased">
    <% if authenticated? %>
      <div class="flex min-h-screen">
        <aside class="flex w-64 shrink-0 flex-col border-r border-edge bg-surface">
          <%= link_to root_path, class: "flex items-center gap-2 px-6 py-5" do %>
            <span class="size-2.5 rounded-full bg-primary-500"></span>
            <span class="text-base font-bold tracking-tight">Assistant</span>
          <% end %>

          <nav class="flex-1 space-y-6 overflow-y-auto px-3 pb-4">
            <div class="space-y-0.5">
              <%= nav_link_to "Dashboard", root_path, :home %>
              <%= nav_link_to "Today", today_path, :inbox %>
              <%= nav_link_to "Calendar", calendar_path, :calendar %>
              <%= nav_link_to "Tasks", tasks_path, :check_circle %>
              <%= nav_link_to "Documents", documents_path, :document %>
              <%= nav_link_to "Goals", goals_path, :flag %>
              <%= nav_link_to "People", people_path, :users %>
              <%= nav_link_to "Notes", notes_path, :note %>
            </div>

            <div>
              <p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-stone-400">Sections</p>
              <div class="space-y-0.5">
                <% Current.user.enabled_sections.each do |section| %>
                  <%= section_nav_link(section) %>
                <% end %>
              </div>
            </div>
          </nav>

          <div class="space-y-1 border-t border-edge p-3">
            <%= nav_link_to "Settings", settings_path, :cog %>
            <div class="flex items-center justify-between px-3 py-1">
              <span class="truncate text-xs text-soft"><%= Current.user.name %></span>
              <%= button_to "Sign out", session_path, method: :delete,
                    class: "cursor-pointer text-xs text-soft hover:text-ink" %>
            </div>
          </div>
        </aside>

        <main class="min-w-0 flex-1">
          <div class="mx-auto max-w-6xl px-8 py-8">
            <%= render Ui::FlashComponent.new(flash: flash) %>
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <main class="flex min-h-screen items-center justify-center p-6">
        <div class="w-full max-w-sm">
          <div class="mb-6 flex items-center justify-center gap-2">
            <span class="size-2.5 rounded-full bg-primary-500"></span>
            <span class="text-lg font-bold tracking-tight">Assistant</span>
          </div>
          <%= render Ui::FlashComponent.new(flash: flash) %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
