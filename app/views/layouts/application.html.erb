<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Assistant">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-ink antialiased">
    <% if authenticated? %>
      <div data-controller="nav" data-action="keydown.esc@window->nav#close turbo:before-visit@window->nav#close">
        <header class="sticky top-0 z-20 flex items-center gap-1 border-b border-edge bg-surface px-2 py-1.5 lg:hidden">
          <button type="button" class="flex size-11 cursor-pointer items-center justify-center rounded-lg text-soft hover:bg-stone-100 hover:text-ink"
                  data-action="nav#toggle" aria-label="Open menu">
            <%= icon(:bars_3, css_class: "size-6") %>
          </button>
          <%= link_to root_path, class: "flex items-center gap-2 px-2 py-2" do %>
            <span class="size-2.5 rounded-full bg-primary-500"></span>
            <span class="text-base font-bold tracking-tight">Assistant</span>
          <% end %>
        </header>

        <div class="hidden fixed inset-0 z-30 bg-black/40 lg:hidden" data-nav-target="backdrop" data-action="click->nav#close"></div>

        <div class="min-h-screen lg:flex">
        <aside class="fixed inset-y-0 left-0 z-40 flex h-dvh w-64 shrink-0 -translate-x-full flex-col border-r border-edge bg-surface transition-transform duration-200 lg:sticky lg:top-0 lg:translate-x-0 lg:transition-none"
               data-nav-target="drawer">
          <div class="flex items-center justify-between pr-2">
            <%= link_to root_path, class: "flex items-center gap-2 px-6 py-5" do %>
              <span class="size-2.5 rounded-full bg-primary-500"></span>
              <span class="text-base font-bold tracking-tight">Assistant</span>
            <% end %>
            <button type="button" class="flex size-11 cursor-pointer items-center justify-center rounded-lg text-soft hover:bg-stone-100 hover:text-ink lg:hidden"
                    data-action="nav#close" aria-label="Close menu">
              <%= icon(:x_mark, css_class: "size-6") %>
            </button>
          </div>

          <nav class="flex-1 space-y-6 overflow-y-auto px-3 pb-4">
            <div class="space-y-0.5">
              <%= nav_link_to "Dashboard", root_path, :home %>
              <%= nav_link_to "Today", today_path, :inbox %>
              <%= nav_link_to "Calendar", calendar_path, :calendar %>
              <%= nav_link_to "Tasks", tasks_path, :check_circle %>
            </div>

            <div>
              <p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-stone-400">Your life</p>
              <div class="space-y-0.5">
                <% Current.user.enabled_sections.each do |section| %>
                  <%= section_nav_link(section) %>
                <% end %>
              </div>
            </div>

            <div>
              <p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-stone-400">Vault</p>
              <div class="space-y-0.5">
                <%= nav_link_to "Address Book", people_path, :users %>
                <%= nav_link_to "Documents", documents_path, :document %>
                <%= nav_link_to "Notes", notes_path, :note %>
                <% if Current.user.linked_accounts.where(provider: "email").exists? %>
                  <%= nav_link_to "Mail", mail_index_path, :envelope %>
                <% end %>
              </div>
            </div>
          </nav>

          <div class="space-y-1 border-t border-edge p-3">
            <% if Current.user.admin? %>
              <%= nav_link_to "Admin", admin_root_path, :warning %>
            <% end %>
            <%= nav_link_to "Settings", settings_path, :cog %>
            <div class="flex items-center justify-between gap-2 px-3 py-1">
              <span class="min-w-0 truncate text-xs text-soft"><%= Current.user.name %></span>
              <%= button_to "Sign out", session_path, method: :delete,
                    class: "cursor-pointer rounded-md px-2 py-2 text-xs text-soft hover:text-ink" %>
            </div>
          </div>
        </aside>

        <main class="min-w-0 flex-1">
          <div class="mx-auto max-w-6xl px-4 py-6 sm:px-8 sm:py-8">
            <%= render Ui::FlashComponent.new(flash: flash) %>
            <%= yield %>
          </div>
        </main>
        </div>
      </div>
    <% else %>
      <main class="flex min-h-screen items-center justify-center p-6">
        <div class="w-full max-w-sm">
          <div class="mb-6 flex items-center justify-center gap-2">
            <span class="size-2.5 rounded-full bg-primary-500"></span>
            <span class="text-lg font-bold tracking-tight">Assistant</span>
          </div>
          <%= render Ui::FlashComponent.new(flash: flash) %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
