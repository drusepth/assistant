<%= render Ui::PageHeaderComponent.new(title: @message.subject.presence || "(no subject)",
      subtitle: "#{@thread.size > 1 ? "#{@thread.size} messages in this thread — " : ""}mirrored from #{@message.linked_account&.display_name || "a disconnected mailbox"}") %>

<div class="mb-4">
  <%= link_to "← All mail", mail_index_path, class: "text-sm font-medium text-primary-700" %>
</div>

<div class="max-w-3xl space-y-4">
  <% @thread.each do |message| %>
    <% current = message.id == @message.id %>
    <div class="card <%= "ring-1 ring-primary-300" if current && @thread.size > 1 %>">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="font-medium text-ink">
          <%= message.outbound? ? "You" : (message.from_name.presence || message.from_email) %>
        </span>
        <span class="text-soft">→ <%= Array(message.to_emails).join(", ").presence || "?" %></span>
        <% if message.person %>
          <%= link_to message.person, class: "chip gap-1.5 bg-primary-50 py-0.5 pl-0.5 text-primary-800" do %>
            <%= render Ui::AvatarComponent.new(person: message.person, size: :xs) %>
            <%= message.person.name %>
          <% end %>
        <% end %>
        <span class="ml-auto text-xs text-soft"><%= message.sent_at&.strftime("%b %-d, %Y at %-l:%M %p") %></span>
      </div>

      <% if message.triage.present? %>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
          <% category = message.triage["category"] %>
          <% if category == "action_needed" %>
            <span class="chip bg-red-50 text-red-700">needs action</span>
          <% elsif category == "time_sensitive" %>
            <span class="chip bg-amber-100 text-amber-800">time-sensitive</span>
          <% elsif category == "noise" %>
            <span class="chip bg-stone-100 text-stone-500">noise</span>
          <% else %>
            <span class="chip bg-stone-100 text-stone-600"><%= category %></span>
          <% end %>
          <% if message.triage["deadline_on"] %>
            <span class="chip bg-amber-100 text-amber-800">deadline <%= message.triage["deadline_on"] %></span>
          <% end %>
          <% if message.triage["why"] %><span class="text-soft"><%= message.triage["why"] %></span><% end %>
        </div>
      <% elsif message.backfilled? && message.id == @message.id %>
        <div class="mt-2">
          <%= button_to "Label this thread", triage_mail_path(message), method: :post, class: "btn btn-ghost btn-sm" %>
        </div>
      <% end %>

      <div class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-ink"><%= message.body_text.presence || "(no text content)" %></div>

      <% if Array(message.attachments).any? %>
        <div class="mt-3 space-y-1.5 border-t border-edge pt-3">
          <% Array(message.attachments).each_with_index do |attachment, index| %>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <%= icon(:document, css_class: "size-4 text-stone-400") %>
              <span class="min-w-0 truncate text-ink"><%= attachment["filename"].presence || "attachment" %></span>
              <span class="text-xs text-soft"><%= number_to_human_size(attachment["size"].to_i) %></span>
              <%= button_to "Save to vault", promote_mail_path(message, kind: "document", attachment: index),
                    method: :post, class: "btn btn-secondary btn-sm ml-auto" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# The promotion row (D-mirror-layer): the one door into the primitive pool. %>
      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-edge pt-3">
        <%= button_to "→ Task", promote_mail_path(message, kind: "task"), method: :post, class: "btn btn-secondary btn-sm" %>
        <%= form_with url: promote_mail_path(message, kind: "event"), method: :post, class: "flex items-center gap-1" do %>
          <%= date_field_tag :date, message.sent_at&.to_date || Date.current, class: "input w-auto py-1 text-xs", id: "event_date_#{message.id}" %>
          <%= submit_tag "→ Event", class: "btn btn-secondary btn-sm" %>
        <% end %>
        <%= button_to "→ Note", promote_mail_path(message, kind: "note"), method: :post, class: "btn btn-secondary btn-sm" %>

        <span class="ml-auto flex items-center gap-2">
          <% if message.outbound? %>
            <% if message.reply_wanted_by %>
              <span class="chip bg-amber-100 text-amber-800">Nudge if no reply by <%= message.reply_wanted_by.strftime("%b %-d") %></span>
            <% else %>
              <%= form_with url: remind_mail_path(message), method: :post, class: "flex items-center gap-1" do %>
                <%= date_field_tag :on, 1.week.from_now.to_date, class: "input w-auto py-1 text-xs", id: "remind_on_#{message.id}" %>
                <%= submit_tag "Remind me if no reply", class: "btn btn-ghost btn-sm" %>
              <% end %>
            <% end %>
          <% end %>
          <%= button_to "Remove from mirror", mail_path(message), method: :delete, class: "btn btn-danger btn-sm",
                data: { turbo_confirm: "Remove this message from the assistant's mirror? It stays in your real mailbox, but the assistant won't see it again." } %>
        </span>
      </div>

      <% if (items = message.promoted_items).any? %>
        <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-edge pt-3 text-xs text-soft">
          <span>Became:</span>
          <% items.each do |item| %>
            <%= link_to "#{item.model_name.human}: #{item.try(:title).presence || item.try(:body)&.truncate(40)}",
                  url_for(item), class: "chip bg-primary-50 text-primary-800" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
