<%= form_with model: diner, url: diner.persisted? ? kitchen_diner_path(kitchen, diner) : kitchen_diners_path(kitchen), class: "mt-3 space-y-3" do |form| %>
  <% members = kitchen.cooks.order(:name) %>
  <% unless diner.persisted? %>
    <%= form.field :user_id, label_text: "Someone who cooks here" do %>
      <%= form.collection_select :user_id, members, :id, :name, { include_blank: "Someone else" } %>
    <% end %>
  <% end %>
  <%= form.field :name, hint: diner.persisted? ? nil : "Leave blank for a household member; “Grandma, Sundays” for anyone else", required: false %>
  <fieldset>
    <legend class="text-sm font-medium text-ink">Can't eat</legend>
    <%= hidden_field_tag "diner[allergens][]", "", id: nil %>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
      <% Food::ALLERGENS.each do |value, label| %>
        <label class="flex items-center gap-1.5 text-sm">
          <%= check_box_tag "diner[allergens][]", value, diner.allergens.include?(value), id: "#{dom_id(diner, :allergen)}_#{value}" %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </fieldset>
  <%= form.field :diet_note, label_text: "How they eat", hint: "“vegetarian”, “no pork”, “hates coriander”" %>
  <%= form.submit (diner.persisted? ? "Save" : "Add"), class: "btn btn-secondary btn-sm" %>
<% end %>
