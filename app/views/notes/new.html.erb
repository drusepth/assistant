<%= render Ui::PageHeaderComponent.new(title: "New note") %>
<div class="max-w-xl">
  <div class="card p-6">
    <%= form_with model: @note, class: "space-y-4" do |form| %>
      <div class="space-y-1">
        <%= form.text_area :body, rows: 6, placeholder: "What should your assistant remember?", autofocus: true, required: true %>
        <%= form.errors_for :body %>
        <p class="hint"><%= note_auto_sort_hint %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= form.submit "Save note" %>
        <%= link_to "Cancel", notes_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
