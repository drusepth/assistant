<div class="card flex h-full flex-col p-4">
  <%= link_to note, class: "group min-w-0 flex-1" do %>
    <% if note.title.present? %>
      <h3 class="text-sm font-medium text-ink group-hover:text-primary-700"><%= note.title %></h3>
    <% end %>
    <p class="mt-1 line-clamp-4 text-sm text-soft"><%= note.body %></p>
  <% end %>
  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <%= render "shared/item_chips", item: note %>
    <span class="ml-auto text-xs text-stone-400"><%= note.updated_at.strftime("%b %-d") %></span>
  </div>
</div>
