<%# Minimal capture form (D16). Locals: task; optional return_to (local path
    to land on after create), autofocus, and cancel_url — omit cancel_url to
    get a button that closes the enclosing quick-add panel instead.
    `namespace` prefixes the field ids so two copies on one page (see
    QuickAddHelper) don't share an id. %>
<%= form_with model: task, class: "space-y-4", namespace: local_assigns[:namespace] do |form| %>
  <div class="space-y-1">
    <%= form.text_field :title, placeholder: "What needs doing?", autofocus: local_assigns.fetch(:autofocus, true), required: true %>
    <%= form.errors_for :title %>
    <p class="hint"><%= task_auto_sort_hint %></p>
  </div>
  <%= form.hidden_field :goal_id %>
  <%# Folded, because most tasks are just words — but one tap away, because
      "remind me to call the pharmacy at 4pm" and "take the trash out every
      Thursday" are tasks too (D-reminders-on-tasks). A due date a page
      prefilled rides inside, still sent while folded. %>
  <details class="rounded-lg border border-edge px-3 py-2" <%= "open" if task.repeat != "none" || task.remind_at.present? || task.errors[:base].any? %>>
    <summary class="cursor-pointer text-sm font-medium text-primary-700">
      Due date, repeat, reminder<%= " · due #{task.due_on == Date.current ? "today" : task.due_on.strftime("%b %-d")}" if task.due_on %>
    </summary>
    <div class="mt-3"><%= render "tasks/when_fields", form: form %></div>
  </details>
  <%= form.errors_for :base %>
  <% if task.goal %>
    <p class="hint">Will be added to the goal “<%= task.goal.title %>”.</p>
  <% end %>
  <%= render "shared/pretagged_sections", form: form, item: task %>
  <%= hidden_field_tag :return_to, local_assigns[:return_to], id: nil if local_assigns[:return_to].present? %>
  <div class="flex items-center gap-2">
    <%= form.submit "Add task" %>
    <% if local_assigns[:cancel_url] %>
      <%= link_to "Cancel", local_assigns[:cancel_url], class: "btn btn-ghost" %>
    <% else %>
      <button type="button" class="btn btn-ghost" data-action="quick-add#closeAll">Cancel</button>
    <% end %>
  </div>
<% end %>
