<%= turbo_stream_from Current.user, :tasks %>

<%= render Ui::PageHeaderComponent.new(title: "Tasks") do |header| %>
  <% header.with_actions do %>
    <%= quick_add :task %>
  <% end %>
<% end %>

<%# One box for everything: name the outcome, the assistant plans the steps
    (D17) — and files a day-sized capture as a plain task instead
    (D-goal-capture-routing). %>
<%= form_with model: @new_goal, class: "capture-row mb-4" do |form| %>
  <%= form.text_field :title, placeholder: goal_capture_placeholder, required: true, class: "flex-1" %>
  <%= form.submit "Add goal" %>
<% end %>

<%# One section, two surfaces (D-tasks-two-surfaces): the board for daily
    doing, Goals for occasional planning. Links, not a toggle — each surface
    is a URL, so back and bookmark work. %>
<nav class="tab-bar">
  <%= link_to tasks_path, class: class_names("tab", "tab-active" => @tab == "board") do %>
    <%= icon(:inbox, css_class: "size-4") %> Board
  <% end %>
  <%= link_to tasks_path(tab: "goals"), class: class_names("tab", "tab-active" => @tab == "goals") do %>
    <%= icon(:flag, css_class: "size-4") %> Goals
  <% end %>
</nav>

<%= render @tab == "goals" ? "goals_panel" : "board" %>
