<%= render Ui::PageHeaderComponent.new(title: "Tasks") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Open", tasks_path, class: "btn btn-sm #{@filter == "open" ? "btn-primary" : "btn-secondary"}" %>
    <%= link_to "Completed", tasks_path(filter: "completed"), class: "btn btn-sm #{@filter == "completed" ? "btn-primary" : "btn-secondary"}" %>
  <% end %>
<% end %>

<%= form_with model: Task.new, class: "mb-4 flex items-center gap-2" do |form| %>
  <%= form.text_field :title, placeholder: quick_add_placeholder, required: true, class: "flex-1" %>
  <%= form.submit "Add" %>
<% end %>

<% if @tasks.any? %>
  <div class="card divide-y divide-edge"><%= render @tasks %></div>
<% else %>
  <%= render Ui::EmptyStateComponent.new(
        title: @filter == "completed" ? "No completed tasks yet" : "No open tasks",
        description: "Tasks are doable things — errands, paperwork, follow-ups. Type one above to add it."
      ) %>
<% end %>
