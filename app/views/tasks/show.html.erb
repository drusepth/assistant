<% own = @task.user_id == Current.user.id %>

<%= render Ui::PageHeaderComponent.new(title: @task.title) do |header| %>
  <% if own %>
    <% header.with_actions do %>
      <%= button_to @task.completed? ? "Reopen" : "Complete",
            @task.completed? ? reopen_task_path(@task) : complete_task_path(@task),
            method: :patch, class: "btn btn-secondary" %>
      <%= link_to "Edit", edit_task_path(@task), class: "btn btn-secondary" %>
      <%= button_to "Delete", @task, method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete this task?" } %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream_from @conversation if @conversation %>

<%= render "shared/provenance", item: @task %>
<div class="grid grid-cols-1 max-w-4xl gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%= render Ui::CardComponent.new(title: "Details") do %>
      <dl class="space-y-3 text-sm">
        <div class="flex gap-2">
          <dt class="w-24 shrink-0 text-soft">Status</dt>
          <dd class="<%= @task.completed? ? "text-primary-700" : "text-ink" %>">
            <%= @task.completed? ? "Completed #{@task.completed_at.strftime("%b %-d, %Y")}" : "Open" %>
          </dd>
        </div>
        <% if @task.due_on %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Due</dt>
            <dd class="min-w-0 wrap-anywhere"><%= @task.due_on.strftime("%B %-d, %Y") %></dd>
          </div>
        <% end %>
        <%# The schedule the task form sets (D-reminders-on-tasks): read off
            the task's own fields, changed with Edit. %>
        <% if (rule = @task.recurrence) %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Repeats</dt>
            <dd class="min-w-0 wrap-anywhere"><%= rule.describe.upcase_first %></dd>
          </div>
        <% end %>
        <% if own && (@task.remind_time || !@task.completed?) %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Reminder</dt>
            <dd class="min-w-0 wrap-anywhere">
              <% if @task.remind_time %>
                <%= clock_label(@task.remind_time) %><%= rule ? " each time" : " on the day it's due" %>
              <% elsif rule %>
                None — it just comes back onto Today · <%= link_to "Add a time", edit_task_path(@task), class: "text-primary-700 hover:underline" %>
              <% else %>
                <%= link_to "Add a time or a repeat", edit_task_path(@task), class: "text-primary-700 hover:underline" %>
              <% end %>
            </dd>
          </div>
        <% end %>
        <% if @task.goal %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">Goal</dt>
            <dd class="min-w-0 wrap-anywhere"><%= link_to @task.goal.title, @task.goal, class: "text-primary-700 hover:underline" %></dd>
          </div>
        <% end %>
        <div class="flex gap-2">
          <dt class="w-24 shrink-0 text-soft">Sections</dt>
          <dd class="flex min-w-0 flex-wrap gap-1.5"><%= render "shared/item_chips", item: @task %></dd>
        </div>
        <% if @task.notes.present? %>
          <div>
            <dt class="mb-1 text-soft">Notes</dt>
            <dd class="whitespace-pre-wrap text-ink"><%= @task.notes %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%# The answer (D30): where a mental task's outcome — the decision, the
        list, the draft — is kept once it exists. It leads only where there is
        one or the task is thinking work; on an errand ("Buy batteries") it
        folds to one line, still a click away (D-task-answer-shape). %>
    <% if own %>
      <% answer_form = capture do %>
        <%= form_with model: @task, class: "space-y-3" do |form| %>
          <%= form.text_area :resolution, rows: 4,
                placeholder: "Write your answer, or work it out in the conversation below and save it from there." %>
          <div class="flex items-center gap-2">
            <%= form.submit "Save answer" %>
            <% unless @task.completed? %>
              <%= submit_tag "Save & complete", name: "save_and_complete", class: "btn btn-secondary" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if @task.resolution.present? || @task.mental_work? %>
        <%= render Ui::CardComponent.new(title: "Your answer",
              subtitle: "The decision, list, or draft this task ends with — keep it here") do %>
          <%= answer_form %>
        <% end %>
      <% else %>
        <details class="card p-4" data-answer-drawer>
          <summary class="cursor-pointer text-sm font-medium text-primary-700">Add an answer</summary>
          <p class="mt-1 text-xs text-soft">For a task that ends with a decision, a list, or a draft.</p>
          <div class="mt-3"><%= answer_form %></div>
        </details>
      <% end %>
    <% elsif @task.resolution.present? %>
      <%= render Ui::CardComponent.new(title: "Answer") do %>
        <p class="whitespace-pre-wrap text-sm text-ink"><%= @task.resolution %></p>
      <% end %>
    <% end %>

    <%# The embedded conversation (D30): the D29 chat surface, opening with
        the task's capture-time questions at zero model cost — the first
        LLM call is the reply to the user's first message. Owner-only, and
        hidden on completed tasks that never had one. %>
    <% if own && (!@task.completed? || @conversation) %>
      <%# An errand gets only the door, at every width: a chat panel under
          "Scoop litter" is the same misfit as an empty answer card
          (D-task-answer-shape). Thinking work, or a conversation already
          under way, gets the panel from `sm` up. %>
      <% panel = @task.mental_work? || @conversation %>
      <%# Below `sm` this is a door, not a panel (D-chat-shell): a card that is
          itself a scroller inside a scrolling page is the bug the screen
          layout exists to fix, so a phone gets the conversation full-screen
          instead of squeezed into a page it has to share. %>
      <%= link_to task_conversation_path(@task), class: "card flex items-center gap-3 p-4 transition-colors hover:bg-canvas #{"sm:hidden" if panel}" do %>
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary-600 text-white">
          <%= icon(:chat_bubble, css_class: "size-5") %>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-sm font-semibold text-ink">Talk it through</span>
          <span class="block truncate text-xs text-soft">
            <%= @conversation ? "Pick the conversation back up" : "Think it out loud — nothing is saved until you say so" %>
          </span>
        </span>
        <%= icon(:chevron_left, css_class: "size-4 shrink-0 rotate-180 text-soft") %>
      <% end %>

      <% if panel %>
        <div class="hidden space-y-6 sm:block">
          <%= render "tool_runs/chat", run: @conversation, tool: Tool::TaskChat,
                composer_url: task_conversation_path(@task),
                openers: @task.conversation_openers, title: "Talk it through" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <% if own %>
    <div class="space-y-6">
      <%= render "shared/share_controls", subject: @task %>
      <%# Reminders set before a task's schedule lived on its form ("the day
          before") still go off, so they stay listed and removable here. %>
      <% extras = @task.extra_reminders %>
      <% if extras.any? %>
        <%= render Ui::CardComponent.new(title: "More reminders", subtitle: "Sent to your phone at these times") do %>
          <ul class="space-y-2">
            <%= render partial: "reminders/reminder", collection: extras %>
          </ul>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
