<%= form_with model: task, class: "space-y-4" do |form| %>
  <%= form.field :title, placeholder: "What needs doing?" %>
  <%= form.field :notes, as: :text_area %>
  <%= form.field :due_on, label_text: "Due date" do %>
    <%= render "shared/date_shortcuts_field", form: form, method: :due_on %>
  <% end %>
  <%= form.field :goal_id, label_text: "Goal" do %>
    <%= form.collection_select :goal_id, Current.user.goals.order(:title), :id, :title, include_blank: "None" %>
  <% end %>
  <%= render layout: "shared/advanced", locals: { hint: section_filing_hint(form.object) } do %>
    <%= render "shared/section_picker", form: form %>
  <% end %>
  <div class="flex items-center gap-2 pt-2">
    <%= form.submit %>
    <%= link_to "Cancel", tasks_path, class: "btn btn-ghost" %>
  </div>
<% end %>
