<%# The task form's Repeat picker (D-task-routines): a chore — change the
    litter, buy the food — is one task that comes back onto the board on its
    cadence, reopened and pulled into Today, with a ping at the time picked.
    The cadence rides a standing reminder, so these are the reminder form's
    own fields and its reminder-form controller; the server composes the
    rule, so this works with JavaScript off. Locals: form (the task's). %>
<% routine = form.object.routine || Reminder.new(deliver_on: form.object.due_on || Date.current) %>
<% weekly = Reminder::WEEKLY_REPEATS.include?(routine.repeat) %>
<% repeating = routine.repeat != "none" %>
<div class="space-y-3" data-controller="reminder-form">
  <%= form.fields_for :routine, routine, include_id: false do |fields| %>
    <div class="flex flex-wrap items-start gap-2">
      <div class="min-w-40 flex-1">
        <%= fields.field :repeat, label_text: "Repeat" do %>
          <%= fields.select :repeat, Reminder::REPEAT_OPTIONS.map { |key, text| [ text, key ] }, {},
                data: { reminder_form_target: "repeat", action: "reminder-form#repeatChanged" } %>
        <% end %>
      </div>
      <div class="min-w-36 flex-1" data-reminder-form-target="until" <%= "hidden" unless repeating %>>
        <%= fields.field :deliver_on, as: :date_field, label_text: "Starting",
              value: routine.deliver_on || Date.current,
              data: { reminder_form_target: "date", action: "reminder-form#dateChanged" } %>
      </div>
      <div class="min-w-28" <%= "hidden" unless repeating %> data-reminder-form-target="until">
        <%= fields.field :deliver_time, as: :time_field, label_text: "At", hint: "Blank = #{Reminder::DEFAULT_HOUR}am" %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5" data-reminder-form-target="days" <%= "hidden" unless weekly %>>
      <span class="label">On</span>
      <% Recurrence::Rule::WEEKDAYS.keys.rotate(1).each do |code| %>
        <label class="cursor-pointer">
          <%= fields.check_box :repeat_days, { multiple: true, class: "peer sr-only", data: { reminder_form_target: "day" } }, code, nil %>
          <span class="chip chip-toggle"><%= Recurrence::Rule::DAY_NAMES[code].first(3) %></span>
        </label>
      <% end %>
    </div>

    <div class="max-w-48" data-reminder-form-target="until" <%= "hidden" unless repeating %>>
      <%= fields.field :repeat_until, as: :date_field, label_text: "Until", hint: "Blank = until you stop it",
            value: routine.repeat_until %>
    </div>

    <p class="text-xs text-soft" data-reminder-form-target="until" <%= "hidden" unless repeating %>>
      Each time it comes round, this task reopens, moves to Today, and you get a reminder.
    </p>
  <% end %>
</div>
