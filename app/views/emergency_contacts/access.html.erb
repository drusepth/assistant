<%# Emergency read (PASSWORDS_PLAN §7): released escrow, read-only, the
    owner was notified the moment this opened. Reveals ride a dedicated
    endpoint that unwraps owner-vault-key → owner-private-key → item key. %>
<%= render Ui::PageHeaderComponent.new(title: "#{@owner.name}'s vault",
      subtitle: "Emergency access — read-only. #{@owner.name} was notified when this opened.") do |header| %>
  <%# Of every page in the app, this is the one where knowing exactly whose
      vault you are standing in matters most. %>
  <% header.with_meta do %>
    <%= render Ui::UserLabelComponent.new(user: @owner, size: :sm) %>
  <% end %>
  <% header.with_actions do %>
    <%= link_to "Back", credentials_path, class: "btn btn-ghost" %>
  <% end %>
<% end %>

<% if @credentials.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: "Nothing stored", description: "#{@owner.name}'s vault is empty.") %>
<% else %>
  <div class="card divide-y divide-edge">
    <% @credentials.each do |credential| %>
      <div class="flex items-center gap-3 p-3"
           data-controller="secret" data-secret-url-value="<%= emergency_reveal_emergency_contact_path(@role, credential_id: credential.id) %>">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-ink"><%= credential.name %></p>
          <p class="truncate text-xs text-soft"><%= credential.username.presence || credential.kind_settings[:label] %></p>
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <% if credential.username.present? %>
            <button type="button" class="btn btn-ghost btn-sm" data-action="secret#copyText"
                    data-secret-text-param="<%= credential.username %>">user</button>
          <% end %>
          <% (credential.kind_settings[:secret_fields] - %w[ totp ]).each do |field| %>
            <button type="button" class="btn btn-ghost btn-sm" data-action="secret#copy"
                    data-secret-field-param="<%= field %>"><%= field == "password" ? "pass" : field %></button>
          <% end %>
          <button type="button" class="btn btn-ghost btn-sm" data-action="secret#copy"
                  data-secret-field-param="notes">notes</button>
          <% if credential.totp_present %>
            <button type="button" class="btn btn-ghost btn-sm font-mono" data-action="secret#copy"
                    data-secret-field-param="totp">2FA</button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%# The diary appears here only because its author deliberately turned it on
    (DIARY_PLAN §7). Off by default, and off is the state that needs no
    explaining — so nothing is said when it isn't included. %>
<% if @diary %>
  <section class="mt-8" data-turbo-cache="false">
    <h2 class="mb-1 text-sm font-semibold text-ink"><%= @owner.name %>'s diary</h2>
    <p class="mb-3 text-xs text-soft">
      <%= @owner.name %> chose to include their diary in emergency access. Read it as what it is.
    </p>
    <div class="card divide-y divide-edge">
      <% @diary.open_all(@owner.diary_entries.newest_first).each do |opened| %>
        <div class="p-4">
          <p class="mb-1 text-xs text-soft"><%= l(opened.entry.entry_date, format: :long) %></p>
          <% if opened.lost? %>
            <p class="text-sm italic text-soft">Sealed — the key to this entry is gone.</p>
          <% else %>
            <p class="mb-1 font-medium text-ink"><%= opened.display_title %></p>
            <div class="whitespace-pre-wrap text-sm text-ink"><%= opened.body %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
