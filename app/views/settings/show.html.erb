<%= render Ui::PageHeaderComponent.new(title: "Settings") %>

<div class="max-w-2xl space-y-6">
  <%= render Ui::CardComponent.new(title: "Your photo",
        subtitle: "Shown wherever the app says who someone is — your household, the dashboard, anything you share") do %>
    <div class="flex flex-wrap items-center gap-4">
      <%= render Ui::AvatarComponent.new(user: Current.user, size: :xl) %>
      <%= form_with model: Current.user, url: avatar_path, method: :patch, class: "min-w-56 flex-1 space-y-2" do |form| %>
        <%= form.file_field :avatar, accept: "image/png, image/jpeg, image/webp, image/gif" %>
        <p class="hint">Square works best — anything else is cropped to the middle. Up to <%= User::AVATAR_MAX_BYTES / 1.megabyte %> MB.</p>
        <div class="flex flex-wrap items-center gap-2">
          <%= form.submit "Save photo", class: "btn-sm" %>
          <% if Current.user.avatar.attached? %>
            <%= link_to "Remove photo", avatar_path, data: { turbo_method: :delete }, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Sections", subtitle: "Choose which sections appear in your sidebar — drag to reorder them") do %>
    <%= form_with url: settings_path, method: :patch, class: "space-y-3", data: { controller: "sortable" } do |form| %>
      <% @sections.each do |section| %>
        <label draggable="true"
               data-action="dragstart->sortable#dragStart dragover->sortable#dragOver drop->sortable#drop dragend->sortable#dragEnd"
               class="flex cursor-pointer flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-edge px-4 py-3 has-[:checked]:border-primary-300 has-[:checked]:bg-primary-50/50">
          <span class="cursor-grab text-stone-300 active:cursor-grabbing" title="Drag to reorder"><%= icon(:bars_3, css_class: "size-4") %></span>
          <%= hidden_field_tag "section_order[]", section.id, id: "section_order_#{section.slug}" %>
          <%= check_box_tag "enabled_section_ids[]", section.id, Current.user.section_enabled?(section),
                id: "section_#{section.slug}", class: "size-4 rounded accent-primary-600" %>
          <span class="size-2.5 rounded-full <%= section_dot_classes(section) %>"></span>
          <span class="text-sm font-medium text-ink"><%= section.name %></span>
          <% if section.children.any? %>
            <span class="min-w-0 text-xs text-soft"><%= section.children.map(&:name).join(" · ") %></span>
          <% end %>
          <%# The D20 agent dial: how proactively the assistant may nudge here.
              Quiet = weekly suggestions in-app; Active = daily; Off = never. %>
          <%= select_tag "agent_levels[#{section.id}]",
                options_for_select(UserSection::AGENT_LEVELS.map { |level| [ "Assistant: #{level.capitalize}", level ] },
                  @agent_levels[section.id] || UserSection::DEFAULT_AGENT_LEVEL),
                class: "input ml-auto w-auto max-w-full py-1 text-xs", id: "agent_level_#{section.slug}",
                title: "How proactively the assistant may make suggestions for #{section.name}" %>
        </label>
      <% end %>
      <%= form.submit "Save sections" %>
    <% end %>
  <% end %>

  <%# D-task-celebration: on by default, and one click from gone. The point
      of the party is the hit of dopamine, and something you can't switch off
      stops being a treat. %>
  <%= render Ui::CardComponent.new(title: "Celebrations",
        subtitle: "Confetti when you finish a task — bigger when you finish a goal or clear the board") do %>
    <%= form_with url: settings_path, method: :patch, class: "flex flex-wrap items-center gap-3" do |form| %>
      <%= hidden_field_tag :celebrations, Current.user.celebrations? ? "0" : "1" %>
      <%= form.submit Current.user.celebrations? ? "Turn celebrations off" : "Turn celebrations on",
            class: "btn btn-secondary" %>
      <span class="text-sm text-soft">
        Currently <strong class="text-ink"><%= Current.user.celebrations? ? "on" : "off" %></strong>.
        Reduced-motion settings are respected either way.
      </span>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Section sharing", subtitle: "Share everything you tag with a section — including future items") do %>
    <% if @section_grants.any? %>
      <ul class="mb-4 space-y-2">
        <% @section_grants.each do |grant| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-edge px-4 py-2.5 text-sm">
            <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
              <span class="font-medium text-ink"><%= grant.subject.qualified_name %></span>
              <span class="text-soft">→</span>
              <%= render Ui::UserLabelComponent.new(user: grant.grantee, css_class: "text-soft") %>
            </span>
            <%= button_to "Revoke", access_grant_path(grant), method: :delete, class: "btn btn-danger btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @household_members.any? %>
      <%= form_with url: access_grants_path, class: "flex flex-wrap items-center gap-2" do |form| %>
        <%= hidden_field_tag :subject_type, "Section" %>
        <%= select_tag :subject_id,
              options_from_collection_for_select(Section.order(:parent_id, :position), :id, :qualified_name),
              class: "input min-w-40 flex-1" %>
        <span class="text-sm text-soft">with</span>
        <%= select_tag :grantee_id, options_from_collection_for_select(@household_members, :id, :name), class: "input min-w-40 flex-1" %>
        <%= form.submit "Share" %>
      <% end %>
    <% else %>
      <p class="text-sm text-soft">No other household members yet — sharing kicks in once your household has more than one user.</p>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Connected accounts", subtitle: "Link your other services so the assistant can draw on them — you control what each one shares") do %>
    <div class="space-y-3">
      <% LinkedAccount::PROVIDERS.each do |provider, settings| %>
        <% accounts = @linked_accounts.fetch(provider, []) %>
        <div class="rounded-lg border px-4 py-3 <%= accounts.any? ? "border-primary-300 bg-primary-50/50" : "border-edge" %>">
          <div class="flex flex-wrap items-center gap-2">
            <%= icon(:link, css_class: "size-4 #{accounts.any? ? "text-primary-600" : "text-stone-300"}") %>
            <span class="text-sm font-medium text-ink"><%= settings[:label] %></span>
          </div>
          <p class="mt-1 text-xs text-soft"><%= settings[:description] %></p>

          <%= render partial: "settings/linked_account", collection: accounts, as: :account %>

          <%# Multi-link providers (email) can always add another mailbox;
              single-link providers connect once. %>
          <% if accounts.empty? || settings[:multi] %>
            <details class="mt-2">
              <summary class="cursor-pointer text-sm font-medium text-primary-700">
                <%= accounts.any? ? "Connect another" : "Connect" %>
              </summary>
              <%= form_with url: linked_accounts_path, class: "mt-3 space-y-3" do |form| %>
                <%= hidden_field_tag :provider, provider, id: "provider_#{provider}" %>
                <% if settings[:multi] %>
                  <div class="space-y-1">
                    <%= label_tag "#{provider}_label", "Label", class: "label" %>
                    <%= text_field_tag :label, nil, id: "#{provider}_label", class: "input",
                          placeholder: "Personal, Work…", required: true %>
                    <p class="hint">You can link more than one <%= settings[:label].downcase %> account — the label tells them apart.</p>
                  </div>
                <% end %>
                <% settings[:fields].each do |field| %>
                  <div class="space-y-1">
                    <%= label_tag "#{provider}_#{field[:key]}", field[:label], class: "label" %>
                    <% tag_options = { id: "#{provider}_#{field[:key]}", class: "input", placeholder: field[:placeholder], required: true } %>
                    <% if field[:secret] %>
                      <%= password_field_tag "credentials[#{field[:key]}]", nil, **tag_options %>
                    <% else %>
                      <%= text_field_tag "credentials[#{field[:key]}]", nil, **tag_options %>
                    <% end %>
                    <% if field[:hint] %><p class="hint"><%= field[:hint] %></p><% end %>
                  </div>
                <% end %>
                <p class="text-xs text-soft">Linking gives the assistant full access to this service — you can narrow it right after.</p>
                <%= form.submit "Link #{settings[:label]}", class: "btn-sm" %>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if Current.user.linked_accounts.where(provider: "email").exists? %>
    <%= render Ui::CardComponent.new(title: "Mail", subtitle: "The daily digest and what you've taught the assistant about senders") do %>
      <%= form_with url: mail_settings_path, method: :patch, class: "flex flex-wrap items-end gap-3" do |form| %>
        <div class="space-y-1">
          <label class="label" for="mail_digest_hour">Digest time (household clock)</label>
          <%= select_tag :mail_digest_hour,
                options_for_select((0..23).map { |hour| [ Time.new(2000, 1, 1, hour).strftime("%-l %p"), hour ] }, Current.user.mail_digest_hour),
                id: "mail_digest_hour", class: "input w-auto" %>
        </div>
        <label class="flex items-center gap-2 pb-2 text-sm">
          <%= check_box_tag :mail_digest_notify, "1", Current.user.mail_digest_notify?, class: "size-4 rounded accent-primary-600" %>
          Send a pointer to my notification channels (titles only)
        </label>
        <%= form.submit "Save", class: "btn-sm" %>
      <% end %>
      <p class="mt-2 text-xs text-soft">On a day with no important mail, no digest appears and nothing is sent.</p>

      <% rules = Current.user.email_sender_rules.order(:email) %>
      <% if rules.any? %>
        <div class="mt-4 border-t border-edge pt-3">
          <h3 class="mb-2 text-sm font-semibold text-ink">Sender rules you've taught it</h3>
          <ul class="space-y-1.5">
            <% rules.each do |rule| %>
              <li class="flex items-center gap-2 text-sm">
                <span class="chip <%= rule.rule == "vip" ? "bg-primary-50 text-primary-800" : "bg-stone-100 text-stone-600" %>"><%= rule.rule == "vip" ? "always important" : "muted" %></span>
                <span class="min-w-0 truncate text-ink"><%= rule.email %></span>
                <%= button_to "Remove", email_sender_rule_path(rule), method: :delete, class: "btn btn-ghost btn-sm ml-auto" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if Current.user.admin? %>
    <% profile = Current.user.household.model_profile %>
    <%= render Ui::CardComponent.new(title: "AI model", subtitle: profile&.configured? ? "Configured — #{profile.display_name}" : "Not configured — document understanding is off") do %>
      <%= render "shared/model_profile_form", profile: profile %>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Notifications", subtitle: "Where the assistant may reach you — only sections set to Active ever notify, titles only") do %>
    <% channels = Current.user.notification_channels.order(:created_at) %>
    <% if channels.any? %>
      <ul class="mb-4 space-y-2">
        <% channels.each do |channel| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-edge px-4 py-2.5 text-sm">
            <span class="min-w-0 truncate <%= "opacity-50" unless channel.enabled? %>">
              <%= channel.label %><%= " (disabled)" unless channel.enabled? %>
            </span>
            <%= button_to "Remove", notification_channel_path(channel), method: :delete, class: "btn btn-danger btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <div class="space-y-3">
      <%= form_with url: notification_channels_path, class: "flex flex-wrap items-end gap-2" do %>
        <%= hidden_field_tag :kind, "webhook" %>
        <div class="min-w-64 flex-1 space-y-1">
          <label class="label" for="webhook_url">Webhook URL</label>
          <%= text_field_tag :url, nil, class: "input", id: "webhook_url", placeholder: "https://ntfy.sh/your-topic — works with ntfy, Home Assistant, Matrix hooks" %>
        </div>
        <%= submit_tag "Add webhook", class: "btn btn-secondary" %>
      <% end %>
      <%= form_with url: notification_channels_path, class: "flex flex-wrap items-end gap-2" do %>
        <%= hidden_field_tag :kind, "email" %>
        <div class="min-w-64 flex-1 space-y-1">
          <label class="label" for="email_address_channel">Email</label>
          <%= text_field_tag :address, nil, class: "input", id: "email_address_channel", placeholder: "you@example.com — needs the instance to have SMTP configured" %>
        </div>
        <%= submit_tag "Add email", class: "btn btn-secondary" %>
      <% end %>
      <div data-controller="web-push" data-web-push-vapid-key-value="<%= Rails.application.config.x.web_push.public_key %>" class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-secondary" data-action="web-push#subscribe">Enable browser push on this device</button>
        <span class="text-xs text-soft" data-web-push-target="status"></span>
      </div>
    </div>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Change password", subtitle: "Also re-seals your password vault — no reset, nothing lost") do %>
    <%= form_with url: user_password_path, method: :patch, class: "grid gap-3 sm:grid-cols-3" do |form| %>
      <%= form.password_field :password_challenge, placeholder: "Current password", autocomplete: "current-password", required: true %>
      <%= form.password_field :password, placeholder: "New password", autocomplete: "new-password", required: true, maxlength: 72 %>
      <%= form.password_field :password_confirmation, placeholder: "Repeat new password", autocomplete: "new-password", required: true, maxlength: 72 %>
      <div class="sm:col-span-3">
        <%= form.submit "Change password", class: "btn btn-secondary" %>
      </div>
    <% end %>
    <p class="mt-2 text-xs text-soft">Forgot it? Use the reset link on the sign-in page — you'll need your vault recovery code there.</p>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Your data", subtitle: "Everything you own — items as JSON, documents as files — in one zip") do %>
    <div class="flex flex-wrap items-center gap-3">
      <%= button_to "Build export", export_path, method: :post, class: "btn btn-secondary" %>
      <% if Current.user.export_archive.attached? %>
        <%= link_to "Download (#{Current.user.export_archive.blob.created_at.strftime("%b %-d, %-l:%M %p")})",
              rails_blob_path(Current.user.export_archive, disposition: "attachment"), class: "btn btn-primary" %>
      <% end %>
    </div>
    <p class="mt-2 text-xs text-soft">Only what you own is included — items shared with you belong to their owners. Whole-instance backup = copy the storage/ volume.</p>
  <% end %>

  <%# The household lives on its own page now (D-household-profile): shared
      facts, members, and invites are about the house, not about you. %>
  <%= render Ui::CardComponent.new(title: "Household", subtitle: Current.user.household.name) do %>
    <p class="text-sm text-soft">
      Where you live, how to reach the house, who lives here, and invitations —
      the facts every member's assistant draws on.
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <%= link_to "Household settings", household_path, class: "btn btn-secondary" %>
      <span class="text-xs text-soft"><%= pluralize(@household_members.size + 1, "member") %></span>
    </div>
  <% end %>
</div>
