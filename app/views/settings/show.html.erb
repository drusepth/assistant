<%= render Ui::PageHeaderComponent.new(title: "Settings") %>

<div class="max-w-2xl space-y-6">
  <%= render Ui::CardComponent.new(title: "Sections", subtitle: "Choose which sections appear in your sidebar") do %>
    <%= form_with url: settings_path, method: :patch, class: "space-y-3" do |form| %>
      <% @sections.each do |section| %>
        <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-edge px-4 py-3 has-[:checked]:border-primary-300 has-[:checked]:bg-primary-50/50">
          <%= check_box_tag "enabled_section_ids[]", section.id, Current.user.section_enabled?(section),
                id: "section_#{section.slug}", class: "size-4 rounded accent-primary-600" %>
          <span class="size-2.5 rounded-full <%= section_dot_classes(section) %>"></span>
          <span class="text-sm font-medium text-ink"><%= section.name %></span>
          <% if section.children.any? %>
            <span class="text-xs text-soft"><%= section.children.map(&:name).join(" · ") %></span>
          <% end %>
        </label>
      <% end %>
      <%= form.submit "Save sections" %>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Section sharing", subtitle: "Share everything you tag with a section — including future items") do %>
    <% if @section_grants.any? %>
      <ul class="mb-4 space-y-2">
        <% @section_grants.each do |grant| %>
          <li class="flex items-center justify-between gap-2 rounded-lg border border-edge px-4 py-2.5 text-sm">
            <span>
              <span class="font-medium text-ink"><%= grant.subject.qualified_name %></span>
              <span class="text-soft">→ <%= grant.grantee.name %></span>
            </span>
            <%= button_to "Revoke", access_grant_path(grant), method: :delete, class: "btn btn-danger btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @household_members.any? %>
      <%= form_with url: access_grants_path, class: "flex flex-wrap items-center gap-2" do |form| %>
        <%= hidden_field_tag :subject_type, "Section" %>
        <%= select_tag :subject_id,
              options_from_collection_for_select(Section.order(:parent_id, :position), :id, :qualified_name),
              class: "input flex-1" %>
        <span class="text-sm text-soft">with</span>
        <%= select_tag :grantee_id, options_from_collection_for_select(@household_members, :id, :name), class: "input flex-1" %>
        <%= form.submit "Share" %>
      <% end %>
    <% else %>
      <p class="text-sm text-soft">No other household members yet — sharing kicks in once your household has more than one user.</p>
    <% end %>
  <% end %>

  <% if Current.user.admin? %>
    <% profile = Current.user.household.model_profile %>
    <%= render Ui::CardComponent.new(title: "AI model", subtitle: profile&.configured? ? "Configured — #{profile.model} at #{URI(profile.base_url).host}" : "Not configured — document understanding is off") do %>
      <%= form_with url: model_profile_path, method: :patch, scope: :model_profile, class: "space-y-4" do |form| %>
        <div class="space-y-1">
          <%= form.label :base_url, "API base URL" %>
          <%= form.text_field :base_url, value: profile&.base_url || "https://api.openai.com/v1" %>
          <p class="hint">Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq — or a local Ollama at http://localhost:11434/v1.</p>
        </div>
        <div class="space-y-1">
          <%= form.label :model, "Model" %>
          <%= form.text_field :model, value: profile&.model || "gpt-4o-mini" %>
        </div>
        <div class="space-y-1">
          <%= form.label :api_key, "API key" %>
          <%= form.password_field :api_key, placeholder: profile&.configured? ? "•••••••• (leave blank to keep)" : "sk-…" %>
        </div>
        <p class="text-xs text-soft">
          Text from analyzed documents is sent to this provider. Point it at a local model and nothing ever leaves your machine.
        </p>
        <%= form.submit "Save AI settings" %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Ui::CardComponent.new(title: "Household", subtitle: Current.user.household.name) do %>
    <ul class="space-y-2">
      <% Current.user.household.users.order(:name).each do |member| %>
        <li class="flex items-center gap-3 rounded-lg border border-edge px-4 py-2.5 text-sm">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-xs font-semibold text-primary-800">
            <%= member.name.split.map(&:first).join[0, 2].upcase %>
          </span>
          <span class="min-w-0 flex-1 truncate">
            <span class="font-medium text-ink"><%= member.name %></span>
            <span class="text-soft"><%= member.email_address %></span>
          </span>
          <% if member.admin? %><span class="chip bg-stone-100 text-stone-700">admin</span><% end %>
          <% if member == Current.user %>
            <span class="chip bg-primary-50 text-primary-800">you</span>
          <% elsif Current.user.admin? %>
            <%= button_to member.admin? ? "Remove admin" : "Make admin",
                  household_member_path(member, admin: !member.admin?), method: :patch,
                  class: "btn btn-ghost btn-sm" %>
            <%= button_to "Remove", household_member_path(member), method: :delete, class: "btn btn-danger btn-sm",
                  data: { turbo_confirm: "Remove #{member.name} from the household? Their account and ALL of their data will be permanently deleted." } %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if Current.user.admin? %>
      <div class="mt-5 border-t border-edge pt-4">
        <h3 class="text-sm font-semibold text-ink">Invite someone</h3>
        <p class="mb-3 mt-0.5 text-xs text-soft">
          Creates a join link to copy and send however you like — no email setup needed. Links expire after 7 days.
        </p>

        <% @pending_invitations.each do |invitation| %>
          <div class="mb-2 rounded-lg border border-edge px-4 py-3" data-controller="clipboard">
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-medium text-ink">For <%= invitation.name %></span>
              <span class="flex items-center gap-1.5">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-clipboard-target="button" data-action="clipboard#copy">Copy link</button>
                <%= button_to "Revoke", invitation_path(invitation), method: :delete, class: "btn btn-danger btn-sm" %>
              </span>
            </div>
            <input type="text" readonly value="<%= join_url(invitation.join_token) %>"
                   data-clipboard-target="source" onclick="this.select()"
                   class="input mt-2 text-xs text-soft">
          </div>
        <% end %>

        <%= form_with url: invitations_path, class: "flex items-center gap-2" do |form| %>
          <%= text_field_tag "invitation[name]", nil, class: "input flex-1", placeholder: "Their name", required: true %>
          <%= form.submit "Create invite link" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
