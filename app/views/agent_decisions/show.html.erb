<%# The page a text message opens (D-decision-links). Deliberately the
    fullest version of a suggestion anywhere in the app: the notification
    carried counts and titles only (D22), so the body — the *why* — belongs
    here, where a session has been proven and the screen is the user's own. %>
<%= render Ui::PageHeaderComponent.new(
      title: "From your assistant",
      subtitle: @suggestions.any? ?
        "#{pluralize(@suggestions.size, "thing")} to decide on" :
        "Nothing left to decide"
    ) %>

<div class="max-w-3xl space-y-6">
  <% if @suggestions.any? %>
    <%= render Ui::CardComponent.new(padded: false) do %>
      <div class="divide-y divide-edge">
        <%= render @suggestions %>
      </div>
    <% end %>
    <p class="text-xs text-soft">
      Nothing here has happened yet — every one of these waits for your click.
      <%= link_to "Tune how often your assistant speaks up", settings_path, class: "underline" %>.
    </p>
  <% else %>
    <%= render Ui::CardComponent.new do %>
      <div class="space-y-3">
        <p class="text-sm text-soft">
          You've already dealt with everything that notification was about — or your
          assistant retired it because the situation resolved itself.
        </p>
        <div class="row-actions">
          <%= link_to "Go to your dashboard", root_path, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
