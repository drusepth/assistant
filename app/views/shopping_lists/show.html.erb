<% content_for :title, "#{@list.name} · #{@kitchen.name}" %>
<% content_for :nav_section, "food" %>
<%= turbo_stream_from @kitchen %>

<div class="mx-auto max-w-2xl" data-controller="shopping-list wake-lock">
  <%= render Ui::PageHeaderComponent.new(title: @list.name, subtitle: @kitchen.name) do |header| %>
    <% header.with_actions do %>
      <%= link_to "Food", food_path, class: "btn btn-ghost" %>
    <% end %>
  <% end %>

  <% if @lists.many? %>
    <nav class="mb-3 flex gap-1.5 overflow-x-auto" aria-label="Lists">
      <% @lists.each do |list| %>
        <%= link_to list.name, kitchen_shopping_list_path(@kitchen, list),
              class: "chip shrink-0 #{list == @list ? "bg-primary-600 text-white" : "bg-canvas text-ink"}",
              aria: { current: (list == @list ? "page" : nil) } %>
      <% end %>
    </nav>
  <% end %>

  <div class="card p-3 sm:p-4">
    <%= render "shopping_lists/quick_add", kitchen: @kitchen, list: @list %>
    <div class="mt-3">
      <%= render "shopping_lists/lines", kitchen: @kitchen, list: @list, open_items: @open_items, basket_items: @basket_items %>
    </div>
  </div>

  <div class="mt-4"><%= render "shared/advanced", hint: "rename, another list, delete" do %>
    <div class="space-y-3">
      <%= form_with model: @list, url: kitchen_shopping_list_path(@kitchen, @list), class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="min-w-48 flex-1"><%= form.field :name %></div>
        <%= form.submit "Rename" %>
      <% end %>
      <%= form_with model: ShoppingList.new(name: ""), url: kitchen_shopping_lists_path(@kitchen), class: "flex flex-wrap items-end gap-2" do |form| %>
        <div class="min-w-48 flex-1"><%= form.field :name, label_text: "Another list", hint: "“Costco”, “Saturday party”" %></div>
        <%= form.submit "Make it" %>
      <% end %>
      <%= button_to "Delete #{@list.name}", kitchen_shopping_list_path(@kitchen, @list), method: :delete, class: "btn btn-danger btn-sm",
            form: { data: { turbo_confirm: "Delete #{@list.name} and everything on it?" } } %>
    </div>
  <% end %></div>
</div>
