<%= form_with model: event, class: "space-y-4" do |form| %>
  <%= form.field :title, placeholder: "What's happening?" %>
  <%= form.field :starts_date, label_text: "When" do %>
    <%= render "shared/date_shortcuts_field", form: form, method: :starts_date %>
  <% end %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= form.field :starts_time, as: :time_field, label_text: "Starts at", hint: "Leave blank for all day." %>
    <%= form.field :ends_time, as: :time_field, label_text: "Ends at" %>
  </div>
  <%= form.field :location %>
  <%= form.field :description, as: :text_area %>
  <%= form.field :goal_id, label_text: "Goal" do %>
    <%= form.collection_select :goal_id, Current.user.goals.order(:title), :id, :title, include_blank: "None" %>
  <% end %>
  <%= render "shared/section_picker", form: form %>
  <div class="flex items-center gap-2 pt-2">
    <%= form.submit %>
    <%= link_to "Cancel", calendar_path, class: "btn btn-ghost" %>
  </div>
<% end %>
