<%# Minimal capture form (D16). Locals: event; optional return_to (local path
    to land on after create), autofocus, and cancel_url — omit cancel_url to
    get a button that closes the enclosing quick-add panel instead. %>
<%= form_with model: event, class: "space-y-4" do |form| %>
  <div class="space-y-1">
    <%= form.text_field :title, placeholder: "What's happening?", autofocus: local_assigns.fetch(:autofocus, true), required: true %>
    <%= form.errors_for :title %>
    <p class="hint"><%= event_auto_sort_hint %></p>
  </div>
  <%= form.field :starts_date, label_text: "When" do %>
    <%= render "shared/date_shortcuts_field", form: form, method: :starts_date, required: true %>
  <% end %>
  <%= hidden_field_tag :return_to, local_assigns[:return_to] if local_assigns[:return_to].present? %>
  <div class="flex items-center gap-2">
    <%= form.submit "Add event" %>
    <% if local_assigns[:cancel_url] %>
      <%= link_to "Cancel", local_assigns[:cancel_url], class: "btn btn-ghost" %>
    <% else %>
      <button type="button" class="btn btn-ghost" data-action="quick-add#closeAll">Cancel</button>
    <% end %>
  </div>
<% end %>
