<%= render Ui::PageHeaderComponent.new(title: "New event") %>
<div class="max-w-xl">
  <div class="card p-6">
    <%= form_with model: @event, class: "space-y-4" do |form| %>
      <div class="space-y-1">
        <%= form.text_field :title, placeholder: "What's happening?", autofocus: true, required: true %>
        <%= form.errors_for :title %>
        <p class="hint"><%= event_auto_sort_hint %></p>
      </div>
      <%= form.field :starts_date, label_text: "When" do %>
        <%= render "shared/date_shortcuts_field", form: form, method: :starts_date, required: true %>
      <% end %>
      <%= render "shared/pretagged_sections", form: form, item: @event %>
      <div class="flex items-center gap-2">
        <%= form.submit "Add event" %>
        <%= link_to "Cancel", calendar_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
