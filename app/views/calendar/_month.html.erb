<%# The month grid. A whole cell opens its day — the tap target on a phone,
    where entries shrink to dots, and "+N more" on a desktop — and each
    entry inside it is its own link above that. Past days sit back a
    little; today is circled; days outside the month are faintest. %>
<% weeks = @days.to_a.each_slice(7).to_a %>
<div class="card card-flush overflow-hidden">
  <div class="grid grid-cols-7 border-b border-edge bg-stone-50">
    <% weeks.first.each do |day| %>
      <div class="px-2 py-2 text-center text-xs font-semibold uppercase tracking-wide text-soft">
        <span class="sm:hidden"><%= day.strftime("%a").first %></span>
        <span class="hidden sm:inline"><%= day.strftime("%a") %></span>
      </div>
    <% end %>
  </div>

  <% weeks.each do |week| %>
    <div class="grid grid-cols-7 divide-x divide-edge border-b border-edge last:border-b-0">
      <% week.each do |day| %>
        <% in_month = day.month == @date.month %>
        <% past = day < Date.current %>
        <% entries = @agenda.on(day) %>
        <div class="<%= class_names("relative min-h-16 p-1 sm:min-h-24 sm:p-1.5",
                 "data-drop-active:bg-primary-50 data-drop-active:ring-2 data-drop-active:ring-inset data-drop-active:ring-primary-400",
                 "bg-stone-50/60" => !in_month, "bg-stone-100/50" => in_month && past) %>"
             <%= tag.attributes(data: calendar_drop_data(day)) %>>
          <%= link_to "", calendar_day_path(date: day.iso8601), class: "absolute inset-0 hover:bg-stone-100/60",
                "aria-label": "#{day.strftime("%A, %B %-d")}#{" — #{pluralize(entries.size, "item")}" if entries.any?}" %>
          <span class="<%= class_names("pointer-events-none relative mb-1 flex size-8 items-center justify-center rounded-full text-xs font-medium",
                  day == Date.current ? "bg-primary-600 text-white" : (in_month && !past ? "text-ink" : "text-stone-400")) %>">
            <%= day.day %>
          </span>
          <%= render "calendar/stay_band", day: day %>
          <div class="hidden space-y-0.5 sm:block">
            <% entries.first(3).each do |entry| %>
              <%= render "calendar/chip", entry: entry, day: day %>
            <% end %>
            <% if entries.size > 3 %>
              <%= link_to "+#{entries.size - 3} more", calendar_day_path(date: day.iso8601),
                    class: "relative z-10 block px-1.5 text-xs text-soft hover:text-primary-700 hover:underline" %>
            <% end %>
          </div>
          <% if entries.any? %>
            <div class="pointer-events-none relative flex flex-wrap items-center gap-0.5 px-1 sm:hidden">
              <% entries.first(4).each do |entry| %>
                <%= render "calendar/dot", entry: entry %>
              <% end %>
              <% if entries.size > 4 %>
                <span class="text-[10px] leading-none text-soft">+<%= entries.size - 4 %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
