<%# A task on its due date, in its section's color like an event but led by
    a check mark, so "due" never reads as "booked". Done ones stay, struck
    through, so a past month still says what got done when. %>
<% shared = task.user_id != Current.user.id %>
<%= link_to task, class: "flex items-center gap-1 rounded px-1.5 py-0.5 text-xs font-medium
      #{task.sections.first ? section_chip_classes(task.sections.first) : "bg-stone-100 text-stone-700"}
      #{"opacity-60" if task.completed?} hover:opacity-80",
      title: [ task.title, ("done" if task.completed?), (task.user.name if shared) ].compact.join(" — ") do %>
  <% if shared %>
    <%= render Ui::AvatarComponent.new(user: task.user, size: :xxs, tone: :stone) %>
  <% end %>
  <%= icon(:check_circle, css_class: "size-3 shrink-0") %>
  <span class="min-w-0 truncate <%= "line-through" if task.completed? %>"><%= task.title %></span>
<% end %>
