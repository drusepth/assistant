<%= render Ui::PageHeaderComponent.new(title: calendar_title(@view, @days, @date)) do |header| %>
  <% header.with_actions do %>
    <%= link_to "←", calendar_step_path(@view, @date, :previous), class: "btn btn-secondary", "aria-label": "Previous #{@view}" %>
    <%= link_to "Today", calendar_view_path(@view, Date.current), class: "btn btn-secondary" %>
    <%= link_to "→", calendar_step_path(@view, @date, :next), class: "btn btn-secondary", "aria-label": "Next #{@view}" %>
    <%= link_to "Import", new_events_import_path, class: "btn btn-secondary" %>
    <% if @view == "day" %>
      <%= quick_add :task, prefill: { due_on: @date } %>
      <%= quick_add :event, prefill: { date: @date }, primary: true %>
    <% else %>
      <%= quick_add :event, primary: true %>
    <% end %>
  <% end %>
<% end %>

<%# Two controls, two shapes: the zoom is a single choice (tabs), the layers
    are any number of independent switches (chips). Both are links — the
    choice is a URL, and it's remembered. %>
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
  <nav class="tab-bar mb-0" aria-label="Calendar view">
    <% CalendarController::VIEWS.each do |view| %>
      <%= link_to view.capitalize, calendar_view_path(view, @date),
            class: class_names("tab", "tab-active" => view == @view), "aria-current": (view == @view ? "page" : nil) %>
    <% end %>
  </nav>
  <nav class="flex flex-wrap items-center gap-1.5" aria-label="Show on the calendar">
    <% CalendarHelper::CALENDAR_LAYER_LABELS.each do |layer, (label, glyph)| %>
      <% on = @layers.include?(layer) %>
      <% toggled = on ? @layers - [ layer ] : Calendar::Agenda::LAYERS & (@layers + [ layer ]) %>
      <%= link_to calendar_view_path(@view, @date, layers: toggled.join(",")),
            class: "chip chip-toggle", "aria-pressed": on, title: on ? "Hide #{label.downcase}" : "Show #{label.downcase}" do %>
        <%= icon(glyph, css_class: "size-3.5") %> <%= label %>
      <% end %>
    <% end %>
  </nav>
</div>

<% if @layers.empty? %>
  <p class="callout mb-4">Everything is switched off — pick Events, Tasks or Reminders above to fill the calendar back in.</p>
<% end %>

<%# What slipped: a past day scrolls out of sight, which is exactly when an
    open task needs saying. Today's day view lists them itself. %>
<% overdue = @agenda.overdue_tasks %>
<% if overdue.any? && !(@view == "day" && @date == Date.current) %>
  <%= link_to calendar_day_path(date: Date.current.iso8601),
        class: "callout callout-warn mb-4 flex items-center gap-2 hover:bg-primary-100" do %>
    <%= icon(:warning, css_class: "size-4 shrink-0") %>
    <span class="flex-1"><%= pluralize(overdue.size, "task") %> past due — <%= overdue.first(2).map { |task| task.title.truncate(32) }.to_sentence(two_words_connector: ", ", last_word_connector: ", ") %><%= "…" if overdue.size > 2 %></span>
    <span class="shrink-0 font-medium">See today →</span>
  <% end %>
<% end %>

<div data-controller="calendar-drag" data-calendar-drag-url-value="<%= calendar_moves_path %>">
  <%= render "calendar/#{@view}" %>
</div>
