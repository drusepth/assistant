<% own = @document.user_id == Current.user.id %>

<%= render Ui::PageHeaderComponent.new(title: @document.title, subtitle: "Added #{@document.created_at.strftime("%B %-d, %Y")}") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Decode this", new_tool_run_path("decode_letter", inputs: { document_id: @document.id }),
          class: "btn btn-secondary" %>
    <% if @document.file.attached? %>
      <%= link_to "Download", rails_blob_path(@document.file, disposition: "attachment"), class: "btn btn-secondary" %>
    <% end %>
    <% if own %>
      <%= link_to "Edit", edit_document_path(@document), class: "btn btn-secondary" %>
      <%= button_to "Delete", @document, method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete this document?" } %>
    <% end %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 max-w-4xl gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%# A photographed document is its own evidence (INTAKE_PLAN W1): show
        the picture above the facts, so the summary can be checked against
        the paper without a download. A bounded variant, never the original. %>
    <% if @document.image? %>
      <div class="card card-flush overflow-hidden">
        <%= image_tag url_for(@document.file.variant(resize_to_limit: [ 1200, 1200 ], format: :webp, saver: { quality: 85, strip: true })),
              alt: @document.title, class: "mx-auto max-h-[36rem] w-auto" %>
      </div>
    <% end %>

    <%# What the document proposes (D-document-intake): the front door to the
        review page while anything is still waiting, and the record of what
        was saved from it once something has. %>
    <% if own && @document.landings_to_review? %>
      <% count = @document.proposed_landings.size %>
      <%= render Ui::CardComponent.new(title: "Worth saving somewhere?",
            subtitle: "The reader found #{count} #{"thing".pluralize(count)} in here that could go on the calendar, in your notes, or in the Address Book.") do |card| %>
        <% card.with_actions { link_to "Review #{count}", review_document_path(@document), class: "btn btn-primary btn-sm" } %>
        <ul class="space-y-1 text-sm text-ink">
          <% @document.proposed_landings.first(6).each do |entry| %>
            <li class="flex items-center gap-2">
              <span class="chip chip-inferred"><%= landing_kind_label(entry["kind"]) %></span>
              <span class="truncate"><%= entry.dig("attributes", "title") || entry.dig("attributes", "name") %></span>
            </li>
          <% end %>
        </ul>
        <p class="mt-3 text-xs text-soft">Nothing is saved until you say so on the review page.</p>
      <% end %>
    <% end %>
    <%# The tool the reader pointed at (D28, on a document): one prefilled
        next step, never a menu. %>
    <% if own && (next_tool = @document.extracted_facts["next_tool"]) && (tool = Tool.find(next_tool["slug"])) %>
      <%= render Ui::CardComponent.new(title: tool.title, subtitle: next_tool["reason"] || tool.description) do |card| %>
        <% card.with_actions { link_to "Open", new_tool_run_path(tool.slug, inputs: { document_id: @document.id }), class: "btn btn-secondary btn-sm" } %>
        <p class="text-sm text-soft">The reader thought this tool fits this document. It opens with the document already chosen.</p>
      <% end %>
    <% end %>
    <% if (produced = @document.produced_items).any? %>
      <%= render Ui::CardComponent.new(title: "Saved from this document", count: produced.size, padded: false) do %>
        <div class="divide-y divide-edge">
          <% produced.each do |item| %>
            <div class="flex items-center gap-3 px-4 py-2.5">
              <span class="chip chip-inferred"><%= item.model_name.human.downcase %></span>
              <%= link_to item.try(:title) || item.try(:name), item, class: "min-w-0 truncate text-sm text-ink hover:text-primary-700" %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render Ui::CardComponent.new(title: "Details") do %>
      <dl class="space-y-3 text-sm">
        <% if @document.file.attached? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">File</dt>
            <dd class="min-w-0 wrap-anywhere"><%= @document.file.filename %> (<%= number_to_human_size(@document.file.byte_size) %>)</dd>
          </div>
        <% end %>
        <div class="flex gap-2">
          <dt class="w-24 shrink-0 text-soft">Sections</dt>
          <dd class="flex min-w-0 flex-wrap gap-1.5"><%= render "shared/item_chips", item: @document %></dd>
        </div>
        <% if @document.description.present? %>
          <div>
            <dt class="mb-1 text-soft">Description</dt>
            <dd class="whitespace-pre-wrap text-ink"><%= @document.description %></dd>
          </div>
        <% end %>
        <%# The coverage card's correction path (docs/HEALTH.md §4): the
            owner's word beats the keyword heuristic — pin a plan the
            keywords miss, banish the car-insurance policy they caught. %>
        <% if own %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 pt-1.5 text-soft">Health plan</dt>
            <dd class="min-w-0">
              <%= form_with model: @document, class: "flex flex-wrap items-center gap-2" do %>
                <%= select_tag "document[health_plan]",
                      options_for_select(
                        [ [ "Auto — #{Health::Coverage.match?(@document) ? "shows" : "doesn't show"} on the Health page", "" ],
                          [ "Yes — pin it there", "true" ], [ "No — keep it off", "false" ] ],
                        @document.health_plan.nil? ? "" : @document.health_plan.to_s
                      ), class: "input w-auto py-1 text-sm" %>
                <%= submit_tag "Save", class: "btn btn-secondary btn-sm" %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render Ui::CardComponent.new(title: "Understanding", subtitle: "AI summary and suggested sections") do |card| %>
      <% if own && @document.analyzable_profile && !@document.analysis_queued? && !@document.analysis_processing? %>
        <% card.with_actions do %>
          <%= button_to @document.analysis_analyzed? || @document.analysis_failed? ? "Re-analyze" : "Analyze",
                analyze_document_path(@document), method: :post, class: "btn btn-secondary btn-sm" %>
        <% end %>
      <% end %>

      <% if @document.analysis_queued? || @document.analysis_processing? %>
        <p class="text-sm text-soft">Analyzing — refresh in a moment.</p>
      <% elsif @document.analysis_failed? %>
        <p class="text-sm text-red-600"><%= @document.analysis_error %></p>
      <% elsif @document.analysis_analyzed? %>
        <p class="whitespace-pre-wrap text-sm text-ink"><%= @document.summary %></p>
        <% suggestions = @document.suggested_section_records %>
        <% if own && suggestions.any? %>
          <div class="mt-4 border-t border-edge pt-3">
            <p class="mb-2 text-xs font-medium text-soft">Suggested sections — apply the ones that fit:</p>
            <div class="flex flex-wrap gap-1.5">
              <% suggestions.each do |section| %>
                <%= button_to apply_suggestion_document_path(@document, slug: section.slug), method: :patch,
                      class: "chip cursor-pointer #{section_chip_classes(section)} hover:opacity-80" do %>
                  + <%= section.qualified_name %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% elsif @document.analyzable_profile %>
        <p class="text-sm text-soft">Not analyzed yet.</p>
      <% else %>
        <p class="text-sm text-soft">
          Document understanding needs an AI model.
          <% if Current.user.admin? %>
            <%= link_to "Configure one in Settings", settings_path, class: "text-primary-700 hover:underline" %> —
            it takes a base URL, a model name, and a key.
          <% else %>
            Ask your household admin to configure one in Settings.
          <% end %>
        </p>
      <% end %>
    <% end %>
  </div>
  <% if own %>
    <div><%= render "shared/share_controls", subject: @document %></div>
  <% end %>
</div>
