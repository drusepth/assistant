<% own = @document.user_id == Current.user.id %>

<%= render Ui::PageHeaderComponent.new(title: @document.title, subtitle: "Added #{@document.created_at.strftime("%B %-d, %Y")}") do |header| %>
  <% header.with_actions do %>
    <% if @document.file.attached? %>
      <%= link_to "Download", rails_blob_path(@document.file, disposition: "attachment"), class: "btn btn-secondary" %>
    <% end %>
    <% if own %>
      <%= link_to "Edit", edit_document_path(@document), class: "btn btn-secondary" %>
      <%= button_to "Delete", @document, method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete this document?" } %>
    <% end %>
  <% end %>
<% end %>

<div class="grid max-w-4xl gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%= render Ui::CardComponent.new(title: "Details") do %>
      <dl class="space-y-3 text-sm">
        <% if @document.file.attached? %>
          <div class="flex gap-2">
            <dt class="w-24 shrink-0 text-soft">File</dt>
            <dd><%= @document.file.filename %> (<%= number_to_human_size(@document.file.byte_size) %>)</dd>
          </div>
        <% end %>
        <div class="flex gap-2">
          <dt class="w-24 shrink-0 text-soft">Sections</dt>
          <dd class="flex flex-wrap gap-1.5"><%= render "shared/item_chips", item: @document %></dd>
        </div>
        <% if @document.description.present? %>
          <div>
            <dt class="mb-1 text-soft">Description</dt>
            <dd class="whitespace-pre-wrap text-ink"><%= @document.description %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render Ui::CardComponent.new(title: "Understanding", subtitle: "AI summary and extracted text") do %>
      <% if @document.summary.present? %>
        <p class="whitespace-pre-wrap text-sm text-ink"><%= @document.summary %></p>
      <% else %>
        <p class="text-sm text-soft">
          Not analyzed yet — document understanding (extraction, summary, suggested tags) is the
          AI feature arriving later in this milestone.
        </p>
      <% end %>
    <% end %>
  </div>
  <% if own %>
    <div><%= render "shared/share_controls", subject: @document %></div>
  <% end %>
</div>
