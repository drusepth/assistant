<div class="card p-4">
  <%= link_to goal.title, goal, class: "text-sm font-medium text-ink hover:text-primary-700" %>

  <% total = goal.tasks.size %>
  <% done = goal.tasks.count(&:completed?) %>
  <% if total.positive? %>
    <div class="mt-2">
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-stone-100">
        <div class="h-full rounded-full bg-primary-500" style="width: <%= (done * 100.0 / total).round %>%"></div>
      </div>
      <p class="mt-1 text-xs text-soft"><%= done %>/<%= total %> tasks</p>
    </div>
  <% end %>

  <div class="mt-2 flex flex-wrap items-center gap-1.5">
    <% if goal.target_on %>
      <span class="text-xs text-soft">by <%= goal.target_on.strftime("%b %-d, %Y") %></span>
    <% end %>
    <%= render "shared/item_chips", item: goal %>
  </div>

  <% if goal.user_id == Current.user.id %>
    <% statuses = Goal.statuses.keys %>
    <% position = statuses.index(goal.status) %>
    <div class="mt-3 flex items-center justify-between border-t border-edge pt-2">
      <% if position.positive? %>
        <%= button_to "← #{statuses[position - 1].humanize}", move_goal_path(goal, status: statuses[position - 1]),
              method: :patch, class: "btn btn-ghost btn-sm" %>
      <% else %><span></span><% end %>
      <% if position < statuses.size - 1 %>
        <%= button_to "#{statuses[position + 1].humanize} →", move_goal_path(goal, status: statuses[position + 1]),
              method: :patch, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
