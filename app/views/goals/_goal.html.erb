<div class="card p-4">
  <div class="flex items-start justify-between gap-2">
    <%= link_to goal.title, goal, class: "text-sm font-medium text-ink hover:text-primary-700" %>
    <% if goal.done? %>
      <span class="chip bg-primary-100 text-primary-800">Done</span>
    <% end %>
  </div>

  <% if goal.breaking_down? %>
    <p class="mt-2 flex items-center gap-1.5 text-xs text-soft">
      <span class="size-1.5 animate-pulse rounded-full bg-primary-500"></span>
      Breaking this into steps…
    </p>
  <% else %>
    <% total = goal.tasks.size %>
    <% done = goal.tasks.count(&:completed?) %>
    <% if total.positive? %>
      <div class="mt-2">
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-stone-100">
          <div class="h-full rounded-full bg-primary-500" style="width: <%= (done * 100.0 / total).round %>%"></div>
        </div>
        <p class="mt-1 text-xs text-soft"><%= done %>/<%= total %> steps</p>
      </div>
    <% end %>
  <% end %>

  <div class="mt-2 flex flex-wrap items-center gap-1.5">
    <% if goal.target_on %>
      <span class="text-xs text-soft">by <%= goal.target_on.strftime("%b %-d, %Y") %></span>
    <% end %>
    <%= render "shared/item_chips", item: goal %>
  </div>
</div>
