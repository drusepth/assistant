<%# Goals are the big swings, so their card sells the climb: a deep brand
    gradient with a flag watermark and prominent progress, visually distinct
    from the day-sized task cards. The percent climb is only shown when it's
    true — finite goals; ongoing ones speak in momentum (D-goal-shape) — and
    a paused card visibly rests (D-goal-pause). %>
<% total = goal.tasks.size %>
<% done_count = goal.tasks.count(&:completed?) %>
<% pct = total.positive? ? (done_count * 100.0 / total).round : 0 %>

<div class="group relative flex flex-col overflow-hidden rounded-xl bg-gradient-to-br from-primary-900 via-primary-700 to-primary-500 p-4 text-white shadow-md ring-1 ring-white/10 transition-shadow hover:shadow-lg <%= "opacity-75 saturate-50" if goal.paused? %>">
  <%= icon(goal.done? ? :check_circle : :flag, css_class: "pointer-events-none absolute -right-5 -top-5 size-28 rotate-6 text-white/10 transition-transform duration-300 group-hover:rotate-0 group-hover:scale-105") %>
  <div class="pointer-events-none absolute -bottom-16 -left-12 size-44 rounded-full bg-primary-300/20 blur-2xl"></div>

  <div class="relative flex items-start justify-between gap-3">
    <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-widest text-primary-200">
      <%= icon(:flag, css_class: "size-3.5") %> Goal
    </p>
    <% if goal.done? %>
      <span class="chip bg-white/15 text-white ring-1 ring-white/30">
        <%= icon(:check_circle, css_class: "size-3.5") %> Achieved
      </span>
    <% elsif goal.paused? %>
      <span class="chip bg-white/15 text-white ring-1 ring-white/30">
        <%= icon(:pause, css_class: "size-3.5") %> Paused
      </span>
    <% elsif total.positive? && !goal.ongoing_shape? %>
      <span class="text-lg font-bold leading-none tabular-nums">
        <%= pct %><span class="text-xs font-semibold text-primary-200">%</span>
      </span>
    <% end %>
  </div>

  <%= link_to goal.title, goal, class: "relative mt-1.5 text-base font-semibold leading-snug text-white decoration-primary-200/70 decoration-2 underline-offset-4 hover:underline" %>

  <div class="relative mt-auto pt-3">
    <% if goal.breaking_down? %>
      <p class="flex items-center gap-1.5 text-xs text-primary-100">
        <span class="size-1.5 animate-pulse rounded-full bg-white"></span>
        Breaking this into steps…
      </p>
    <% elsif goal.ongoing_shape? && !goal.done? %>
      <p class="text-xs text-primary-100"><%= goal_momentum(goal) %></p>
    <% elsif total.positive? %>
      <div class="h-2 w-full overflow-hidden rounded-full bg-white/15">
        <div class="h-full rounded-full bg-gradient-to-r from-primary-300 to-white" style="width: <%= pct %>%"></div>
      </div>
      <p class="mt-1.5 text-xs text-primary-100"><%= done_count %> of <%= total %> steps done</p>
    <% end %>

    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      <% if goal.stale? %>
        <span class="chip bg-white/10 text-primary-50 ring-1 ring-white/20"><%= goal_stale_label(goal) %></span>
      <% end %>
      <% if goal.target_on %>
        <span class="chip bg-white/10 text-primary-50 ring-1 ring-white/20">by <%= goal.target_on.strftime("%b %-d, %Y") %></span>
      <% end %>
      <%= render "shared/item_chips", item: goal, on_dark: true %>
    </div>
  </div>
</div>
