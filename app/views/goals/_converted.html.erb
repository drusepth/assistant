<%# Replaces the goal page's planning container when a capture was day-sized
    (D-goal-capture-routing). Rendered from a broadcast — no request, no
    Current — so the task row here is self-contained rather than tasks/_task. %>
<div class="max-w-xl">
  <%= render Ui::CardComponent.new(title: "Filed as a task") do %>
    <p class="text-sm text-ink">This was day-sized, so it went straight to your board — no goal ceremony needed.</p>
    <div class="mt-3 flex items-start gap-3 rounded-lg border border-edge px-4 py-3">
      <span class="mt-0.5 block size-5 shrink-0 rounded-full border-2 border-stone-400"></span>
      <div class="min-w-0">
        <%= link_to task.title, task, class: "text-[15px] font-medium leading-snug text-ink hover:text-primary-700 sm:text-sm" %>
        <% if task.due_on %>
          <p class="mt-0.5 text-xs text-soft"><%= task_due_label(task) %></p>
        <% end %>
      </div>
    </div>
    <%= link_to "Go to the board", tasks_path, class: "btn btn-primary mt-4" %>
  <% end %>
</div>
