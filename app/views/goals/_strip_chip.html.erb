<%# The strip's compact form of a goal (D-tasks-two-surfaces): title plus one
    line of signal — the plan forming, a flag that needs the user, momentum
    for ongoing goals, or the percent climb for finite ones (D-goal-shape). %>
<% total = goal.tasks.size %>
<% done_count = goal.tasks.count(&:completed?) %>
<% pct = total.positive? ? (done_count * 100.0 / total).round : 0 %>

<%= link_to goal_path(goal),
      class: "flex w-56 shrink-0 snap-start flex-col justify-between gap-2 rounded-xl bg-gradient-to-br from-primary-900 to-primary-600 p-3 text-white ring-1 ring-white/10 transition-shadow hover:shadow-md" do %>
  <p class="truncate text-sm font-semibold leading-snug"><%= goal.title %></p>

  <div class="flex min-h-4 items-center gap-2 text-[11px] text-primary-100">
    <% if goal.breaking_down? %>
      <span class="size-1.5 shrink-0 animate-pulse rounded-full bg-white"></span> Breaking into steps…
    <% elsif goal.adrift? %>
      <%= icon(:warning, css_class: "size-3 shrink-0") %> No next step
    <% elsif goal.stale? %>
      <%= icon(:pause, css_class: "size-3 shrink-0") %> <%= goal_stale_label(goal) %>
    <% elsif goal.ongoing_shape? %>
      <%= goal_momentum(goal) %>
    <% elsif total.positive? %>
      <span class="h-1.5 w-20 overflow-hidden rounded-full bg-white/20">
        <span class="block h-full rounded-full bg-white" style="width: <%= pct %>%"></span>
      </span>
      <span class="tabular-nums"><%= pct %>%</span>
    <% end %>
  </div>
<% end %>
