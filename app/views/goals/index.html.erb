<%= render Ui::PageHeaderComponent.new(title: "Goals", subtitle: "Multi-step things with progress") do |header| %>
  <% header.with_actions do %>
    <%= link_to new_goal_path, class: "btn btn-primary" do %>
      <%= icon(:plus, css_class: "size-4") %> Goal
    <% end %>
  <% end %>
<% end %>

<% if @columns.values.all?(&:empty?) %>
  <%= render Ui::EmptyStateComponent.new(
        title: "No goals yet",
        description: "Goals are multi-step things — a job search, a dispute, a project — that spawn tasks and events across sections."
      ) do |empty| %>
    <% empty.with_action { link_to "New goal", new_goal_path, class: "btn btn-primary" } %>
  <% end %>
<% else %>
  <div class="grid gap-4 lg:grid-cols-3">
    <% @columns.each do |status, goals| %>
      <div class="rounded-xl bg-stone-100/70 p-3">
        <div class="mb-3 flex items-center justify-between px-1">
          <h2 class="text-sm font-semibold text-ink"><%= status.humanize %></h2>
          <span class="text-xs text-soft"><%= goals.size %></span>
        </div>
        <div class="space-y-3">
          <%= render goals %>
          <% if goals.empty? %>
            <p class="px-1 py-4 text-center text-xs text-soft">Nothing here.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
