<%# One thing in the kitchen. Expiry shows as a coloured edge and a date in
    words — never a percentage — and the actions are the three things
    that actually happen to food: used up, moved, bought again. %>
<% kitchen = item.kitchen %>
<% edge = item.expired? ? "border-l-red-400" : (item.expiring? ? "border-l-primary-400" : "border-l-transparent") %>
<li id="<%= dom_id(item) %>" class="border-l-4 <%= edge %> py-2 pl-3">
  <details class="group">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
      <span class="min-w-0">
        <span class="block text-base text-ink"><%= item.item %><% if item.quantity_note.present? %><span class="text-sm text-soft"> · <%= item.quantity_note %></span><% end %></span>
        <% dates = pantry_item_dates(item) %>
        <% if dates.present? %><span class="block text-xs <%= item.expired? ? "text-primary-800" : "text-soft" %>"><%= dates %></span><% end %>
      </span>
      <span class="flex shrink-0 items-center gap-1">
        <%= button_to "Used up", kitchen_pantry_item_path(kitchen, item), method: :delete, class: "btn btn-ghost btn-sm" %>
        <%= icon(:chevron_down, css_class: "size-4 text-soft transition group-open:rotate-180") %>
      </span>
    </summary>
    <div class="mt-3 space-y-3 pb-1">
      <div class="flex flex-wrap gap-2">
        <% Food::LOCATIONS.except(item.location).each do |location, label| %>
          <%= button_to "Move to #{label.downcase}", move_kitchen_pantry_item_path(kitchen, item, location: location), method: :patch, class: "btn btn-secondary btn-sm" %>
        <% end %>
        <%= button_to "Add to list", add_to_list_kitchen_pantry_item_path(kitchen, item), class: "btn btn-secondary btn-sm" %>
      </div>
      <%= form_with model: item, url: kitchen_pantry_item_path(kitchen, item), class: "grid grid-cols-1 gap-3 sm:grid-cols-3" do |form| %>
        <%= form.field :quantity_note, label_text: "How much", hint: "“half a bag”" %>
        <%= form.field :expires_on, as: :date_field, label_text: "Use by" %>
        <%= form.field :opened_on, as: :date_field, label_text: "Opened" %>
        <div class="sm:col-span-3"><%= form.submit "Save", class: "btn btn-secondary btn-sm" %></div>
      <% end %>
      <% if item.food && food_allergen_note(item.food) %>
        <p class="text-xs text-soft"><%= food_allergen_note(item.food) %></p>
      <% end %>
    </div>
  </details>
</li>
